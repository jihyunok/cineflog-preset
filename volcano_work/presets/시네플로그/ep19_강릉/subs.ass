Dialogue: 0,0:00:00.00,0:21:55.60,TOP,,0,0,0,,CINEFLOG
Dialogue: 0,0:00:00.11,0:00:01.83,N,,0,0,0,,의리로 버티던 옛 건달과
Dialogue: 0,0:00:01.83,0:00:04.45,N,,0,0,0,,돈이면 사람도 죽이는 새 악당이
Dialogue: 0,0:00:04.45,0:00:05.00,N,,0,0,0,,맞붙습니다
Dialogue: 0,0:00:05.05,0:00:07.78,D,,0,0,0,,지금 내 모습 똑똑히 기억해
Dialogue: 0,0:00:07.91,0:00:09.21,N,,0,0,0,,그리고 그 전쟁의 끝에서
Dialogue: 0,0:00:09.21,0:00:11.49,N,,0,0,0,,한 남자는 이런 질문을
Dialogue: 0,0:00:11.49,0:00:12.00,N,,0,0,0,,받게 되죠
Dialogue: 0,0:00:12.05,0:00:14.18,D,,0,0,0,,네 진짜로 이래 살 수 있겠나?
Dialogue: 0,0:00:14.31,0:00:15.79,N,,0,0,0,,이야기는 동해안의 작은
Dialogue: 0,0:00:15.79,0:00:17.51,N,,0,0,0,,항구에서 시작합니다
Dialogue: 0,0:00:17.51,0:00:18.73,N,,0,0,0,,어부들이 그물을 손질하던
Dialogue: 0,0:00:18.73,0:00:19.80,N,,0,0,0,,평범한 아침이었죠
Dialogue: 0,0:00:19.85,0:00:22.34,D,,0,0,0,,형이 왜 이렇게 늦게 오셨어?
Dialogue: 0,0:00:22.47,0:00:24.45,N,,0,0,0,,그런데 항구에 들어온 배 한 척이
Dialogue: 0,0:00:24.45,0:00:26.04,N,,0,0,0,,이상합니다
Dialogue: 0,0:00:26.04,0:00:27.18,N,,0,0,0,,아무리 불러도 사람이
Dialogue: 0,0:00:27.18,0:00:27.83,N,,0,0,0,,나오지 않죠
Dialogue: 0,0:00:27.88,0:00:29.31,D,,0,0,0,,여기 아무도 없어?
Dialogue: 0,0:00:29.38,0:00:31.44,D,,0,0,0,,멀쩡한 장비가 하나도 없대
Dialogue: 0,0:00:31.51,0:00:32.98,D,,0,0,0,,네가 그랬어요?
Dialogue: 0,0:00:33.11,0:00:34.63,N,,0,0,0,,배 안엔 피투성이 선원들뿐
Dialogue: 0,0:00:34.63,0:00:36.79,N,,0,0,0,,살아남은 건 긴 머리의
Dialogue: 0,0:00:36.79,0:00:37.66,N,,0,0,0,,남자 하나였죠
Dialogue: 0,0:00:40.17,0:00:41.67,N,,0,0,0,,같은 바다 앞에 검은
Dialogue: 0,0:00:41.67,0:00:42.90,N,,0,0,0,,양복을 입은 한 남자가 서
Dialogue: 0,0:00:42.90,0:00:44.11,N,,0,0,0,,있습니다
Dialogue: 0,0:00:44.11,0:00:46.14,N,,0,0,0,,이 영화의 주인공 길석입니다
Dialogue: 0,0:00:46.37,0:00:48.31,N,,0,0,0,,길석은 이 도시를 주름잡는
Dialogue: 0,0:00:48.31,0:00:49.53,N,,0,0,0,,조직의 이인자입니다
Dialogue: 0,0:00:49.58,0:00:51.91,D,,0,0,0,,애들 돈 따서 뭐 하려고 그래요
Dialogue: 0,0:00:51.98,0:00:54.67,D,,0,0,0,,덕구라고 있는데 결혼해요
Dialogue: 0,0:00:54.80,0:00:55.88,N,,0,0,0,,결혼을 앞둔 덕구는
Dialogue: 0,0:00:55.88,0:00:57.58,N,,0,0,0,,형님들 손에 번쩍 들려
Dialogue: 0,0:00:57.58,0:00:59.26,N,,0,0,0,,바다에 던져집니다
Dialogue: 0,0:00:59.26,0:01:00.89,N,,0,0,0,,이 동네식 축하인 셈이죠
Dialogue: 0,0:01:00.94,0:01:04.77,D,,0,0,0,,결혼하면 평생 잘 살아갈게
Dialogue: 0,0:01:04.84,0:01:06.27,D,,0,0,0,,야! 덕구!
Dialogue: 0,0:01:06.34,0:01:08.27,D,,0,0,0,,사람이 그래 쉽게 안 죽죠
Dialogue: 0,0:01:08.34,0:01:10.54,D,,0,0,0,,새신랑이 어디로 갈라고
Dialogue: 0,0:01:10.61,0:01:12.50,D,,0,0,0,,니 어디 가는데 진짜?
Dialogue: 0,0:01:12.63,0:01:14.13,N,,0,0,0,,그런데 경찰인 친구
Dialogue: 0,0:01:14.13,0:01:16.35,N,,0,0,0,,방현이 길석을 찾아옵니다
Dialogue: 0,0:01:16.35,0:01:17.73,N,,0,0,0,,식구 중 하나가 몰래
Dialogue: 0,0:01:17.73,0:01:19.65,N,,0,0,0,,약을 팔다 신고가 들어왔다는
Dialogue: 0,0:01:19.65,0:01:19.82,N,,0,0,0,,거죠
Dialogue: 0,0:01:19.87,0:01:22.57,D,,0,0,0,,신고받고 치기 직전에 내가 막았어
Dialogue: 0,0:01:22.64,0:01:24.43,D,,0,0,0,,이러면 되겠나 안 되겠나?
Dialogue: 0,0:01:24.50,0:01:26.17,D,,0,0,0,,저희가 조용히 처리할게요
Dialogue: 0,0:01:26.30,0:01:28.02,N,,0,0,0,,길석의 사람들은 그날 밤 약을
Dialogue: 0,0:01:28.02,0:01:29.32,N,,0,0,0,,하던 업소를 덮칩니다
Dialogue: 0,0:01:29.37,0:01:31.10,D,,0,0,0,,아름다운 올림픽의 도시에서
Dialogue: 0,0:01:31.23,0:01:32.19,N,,0,0,0,,약을 판 쪽 두목은
Dialogue: 0,0:01:32.19,0:01:33.93,N,,0,0,0,,애들이 알아서 한 일이라며
Dialogue: 0,0:01:33.93,0:01:35.35,N,,0,0,0,,발뺌합니다
Dialogue: 0,0:01:35.35,0:01:36.55,N,,0,0,0,,길석 쪽 충섭은 그 말이
Dialogue: 0,0:01:36.55,0:01:37.32,N,,0,0,0,,기가 막히죠
Dialogue: 0,0:01:37.37,0:01:39.80,D,,0,0,0,,갑자기 치고 들어오면 못 해요
Dialogue: 0,0:01:39.87,0:01:41.50,D,,0,0,0,,거 안 되는 거 모르나?
Dialogue: 0,0:01:41.57,0:01:44.06,D,,0,0,0,,내가 일일이 지켜보고 있어요?
Dialogue: 0,0:01:44.13,0:01:46.63,D,,0,0,0,,경찰이 친다는데 가만히 보나?
Dialogue: 0,0:01:46.70,0:01:48.13,D,,0,0,0,,형님 안 그래요?
Dialogue: 0,0:01:48.26,0:01:50.18,N,,0,0,0,,그때 조직의 큰 어른
Dialogue: 0,0:01:50.18,0:01:51.80,N,,0,0,0,,오회장이 들어섭니다
Dialogue: 0,0:01:51.80,0:01:52.88,N,,0,0,0,,모두가 일어나 고개를
Dialogue: 0,0:01:52.88,0:01:53.28,N,,0,0,0,,숙이죠
Dialogue: 0,0:01:53.33,0:01:54.76,D,,0,0,0,,반갑습니다
Dialogue: 0,0:01:54.83,0:01:56.26,D,,0,0,0,,어서 오십시오
Dialogue: 0,0:01:56.39,0:01:57.95,N,,0,0,0,,오회장은 양쪽 모두를
Dialogue: 0,0:01:57.95,0:01:59.82,N,,0,0,0,,꾸짖으며 상황을 정리합니다
Dialogue: 0,0:01:60.00,0:02:03.83,D,,0,0,0,,약 파는 니도 잘못했고
Dialogue: 0,0:02:03.90,0:02:07.63,D,,0,0,0,,식구끼리 까고 그러면 안 돼
Dialogue: 0,0:02:07.70,0:02:10.16,D,,0,0,0,,둘이 잘 못 지내면은
Dialogue: 0,0:02:10.29,0:02:11.43,N,,0,0,0,,같은 시각, 또 다른
Dialogue: 0,0:02:11.43,0:02:13.11,N,,0,0,0,,남자가 등장합니다
Dialogue: 0,0:02:13.11,0:02:14.75,N,,0,0,0,,빚쟁이에게 빚이 얼마냐고
Dialogue: 0,0:02:14.75,0:02:16.68,N,,0,0,0,,묻는 이 남자, 민석이죠
Dialogue: 0,0:02:16.73,0:02:18.16,D,,0,0,0,,넌 빚이 얼마야?
Dialogue: 0,0:02:18.23,0:02:22.06,D,,0,0,0,,하룻밤 술값으로 700을 쓰는데
Dialogue: 0,0:02:22.13,0:02:24.62,D,,0,0,0,,전 살려고 가는 겁니다
Dialogue: 0,0:02:24.69,0:02:26.79,D,,0,0,0,,나도 네가 살았으면 좋겠다
Dialogue: 0,0:02:26.92,0:02:28.64,N,,0,0,0,,민석은 옛 보스를 찾아가
Dialogue: 0,0:02:28.64,0:02:30.26,N,,0,0,0,,리조트 지분을 내놓으라고
Dialogue: 0,0:02:30.26,0:02:30.61,N,,0,0,0,,합니다
Dialogue: 0,0:02:30.66,0:02:33.49,D,,0,0,0,,같이 밥 먹을 생각하지 않니?
Dialogue: 0,0:02:33.56,0:02:34.99,D,,0,0,0,,밥은 했네?
Dialogue: 0,0:02:35.06,0:02:37.26,D,,0,0,0,,그래, 어째 왔니?
Dialogue: 0,0:02:37.33,0:02:40.36,D,,0,0,0,,현금 대신 지분으로 받아 드린 거
Dialogue: 0,0:02:40.43,0:02:44.26,D,,0,0,0,,그건 이미 신사장한테 맡겼다
Dialogue: 0,0:02:44.33,0:02:47.26,D,,0,0,0,,네 몫은 독립할 때 다 줬제
Dialogue: 0,0:02:47.33,0:02:50.46,D,,0,0,0,,회장님 돈 찾아오는 일이고요
Dialogue: 0,0:02:50.59,0:02:52.09,N,,0,0,0,,그러자 민석은 대화로는
Dialogue: 0,0:02:52.09,0:02:53.71,N,,0,0,0,,아무것도 해결되지 않는다고
Dialogue: 0,0:02:53.71,0:02:54.01,N,,0,0,0,,말하더니
Dialogue: 0,0:02:54.06,0:02:55.75,D,,0,0,0,,아무것도 없던 새끼가
Dialogue: 0,0:02:55.83,0:02:57.32,D,,0,0,0,,대화를 싫어해요
Dialogue: 0,0:02:57.40,0:02:59.03,N,,0,0,0,,그 자리에서 보스와
Dialogue: 0,0:02:59.03,0:03:00.22,N,,0,0,0,,부하들을 모조리 해치워
Dialogue: 0,0:03:00.22,0:03:00.81,N,,0,0,0,,버립니다
Dialogue: 0,0:03:03.32,0:03:05.34,N,,0,0,0,,한편 길석은 시골 한옥에서
Dialogue: 0,0:03:05.34,0:03:06.40,N,,0,0,0,,고추를 말리는 노인을
Dialogue: 0,0:03:06.40,0:03:07.62,N,,0,0,0,,찾아갑니다
Dialogue: 0,0:03:07.62,0:03:08.56,N,,0,0,0,,바로 조직의 회장
Dialogue: 0,0:03:08.56,0:03:10.31,N,,0,0,0,,오회장이죠
Dialogue: 0,0:03:10.36,0:03:11.79,D,,0,0,0,,왜 혼자 계세요?
Dialogue: 0,0:03:11.86,0:03:15.29,D,,0,0,0,,나 같은 노인 누가 신경 쓰나?
Dialogue: 0,0:03:15.37,0:03:16.41,N,,0,0,0,,직접 기른 채소를 먹는
Dialogue: 0,0:03:16.41,0:03:18.15,N,,0,0,0,,이유를 묻자 오회장은
Dialogue: 0,0:03:18.15,0:03:20.17,N,,0,0,0,,사서 먹으면 남는 걸 버리게
Dialogue: 0,0:03:20.17,0:03:20.90,N,,0,0,0,,된다고 답하죠
Dialogue: 0,0:03:20.95,0:03:22.68,D,,0,0,0,,형님 이거 재밌어요?
Dialogue: 0,0:03:22.75,0:03:25.35,D,,0,0,0,,마트 가서 사 먹는 게 좋지?
Dialogue: 0,0:03:25.42,0:03:27.62,D,,0,0,0,,길러서 먹으면 뭐가 좋은지 아나?
Dialogue: 0,0:03:27.69,0:03:31.28,D,,0,0,0,,딱 먹을 만치만 사고 버리잖아
Dialogue: 0,0:03:31.35,0:03:32.88,D,,0,0,0,,진짜 그러네요
Dialogue: 0,0:03:32.95,0:03:35.72,D,,0,0,0,,먹을 수 있는 만큼만 길러야 돼
Dialogue: 0,0:03:35.85,0:03:37.39,N,,0,0,0,,오회장이 리조트를 보여
Dialogue: 0,0:03:37.39,0:03:38.25,N,,0,0,0,,줍니다
Dialogue: 0,0:03:38.25,0:03:39.57,N,,0,0,0,,금으로 만든 조명 하나가
Dialogue: 0,0:03:39.57,0:03:41.14,N,,0,0,0,,10억짜리라죠
Dialogue: 0,0:03:41.19,0:03:44.16,D,,0,0,0,,저 조명이 10억짜리야
Dialogue: 0,0:03:44.23,0:03:48.06,D,,0,0,0,,시간을 쓰든 돈을 쓰든 해야지
Dialogue: 0,0:03:48.14,0:03:49.90,N,,0,0,0,,그리고 길석에게 이 리조트를
Dialogue: 0,0:03:49.90,0:03:51.22,N,,0,0,0,,맡아 보라고 제안합니다
Dialogue: 0,0:03:51.27,0:03:53.40,D,,0,0,0,,리조트는 구역상 충섭이가
Dialogue: 0,0:03:53.47,0:03:55.86,D,,0,0,0,,괜히 분란 만들고 싶지 않아요
Dialogue: 0,0:03:55.99,0:03:57.43,N,,0,0,0,,하지만 오회장은 지분을
Dialogue: 0,0:03:57.43,0:03:58.75,N,,0,0,0,,가진 사장 중에 수상한
Dialogue: 0,0:03:58.75,0:04:00.55,N,,0,0,0,,놈이 하나 있다며 걱정하죠
Dialogue: 0,0:04:00.60,0:04:04.43,D,,0,0,0,,지분 사장 중에 수상한 놈이 있어
Dialogue: 0,0:04:04.50,0:04:07.63,D,,0,0,0,,이겨도 골치고 져도 골치야
Dialogue: 0,0:04:07.76,0:04:08.88,N,,0,0,0,,그 수상한 놈이 바로
Dialogue: 0,0:04:08.88,0:04:10.38,N,,0,0,0,,민석입니다
Dialogue: 0,0:04:10.38,0:04:11.82,N,,0,0,0,,민석은 빚에 묶인 여자
Dialogue: 0,0:04:11.82,0:04:13.20,N,,0,0,0,,은선과 함께 이곳에
Dialogue: 0,0:04:13.20,0:04:14.05,N,,0,0,0,,머물고 있었죠
Dialogue: 0,0:04:14.10,0:04:15.93,D,,0,0,0,,아직 한 시간도 안 됐어
Dialogue: 0,0:04:16.00,0:04:17.43,D,,0,0,0,,여기서 지내는 거야?
Dialogue: 0,0:04:17.50,0:04:19.69,D,,0,0,0,,자기랑 안 어울린다
Dialogue: 0,0:04:19.82,0:04:21.67,N,,0,0,0,,그런 민석 앞에 서울에서 온
Dialogue: 0,0:04:21.67,0:04:22.16,N,,0,0,0,,신사장이
Dialogue: 0,0:04:22.16,0:04:23.36,N,,0,0,0,,나타납니다
Dialogue: 0,0:04:23.36,0:04:24.84,N,,0,0,0,,민석이 해치운 옛 보스의
Dialogue: 0,0:04:24.84,0:04:25.51,N,,0,0,0,,사람이죠
Dialogue: 0,0:04:25.56,0:04:27.39,D,,0,0,0,,여기 어쩐 일이세요?
Dialogue: 0,0:04:27.46,0:04:30.09,D,,0,0,0,,소식은 들었어요, 회장님
Dialogue: 0,0:04:30.16,0:04:33.96,D,,0,0,0,,이미 독립했는데 무슨 조문까지
Dialogue: 0,0:04:34.09,0:04:35.45,N,,0,0,0,,신사장은 지분을 통째로
Dialogue: 0,0:04:35.45,0:04:36.87,N,,0,0,0,,먹은 놈이 범인 아니겠냐며
Dialogue: 0,0:04:36.87,0:04:38.00,N,,0,0,0,,민석을 노려봅니다
Dialogue: 0,0:04:38.36,0:04:39.79,D,,0,0,0,,참 이상하지?
Dialogue: 0,0:04:39.86,0:04:42.19,D,,0,0,0,,100% 지분 먹은 놈이 범인인데
Dialogue: 0,0:04:42.26,0:04:43.87,D,,0,0,0,,꼭 그렇게 하세요
Dialogue: 0,0:04:44.00,0:04:45.24,N,,0,0,0,,길석이 리조트를 둘러보던
Dialogue: 0,0:04:45.24,0:04:46.78,N,,0,0,0,,날, 민석이 먼저 다가와
Dialogue: 0,0:04:46.78,0:04:47.76,N,,0,0,0,,인사를 건넵니다
Dialogue: 0,0:04:47.81,0:04:51.64,D,,0,0,0,,클럽 맞은편에 카지노가 있어
Dialogue: 0,0:04:51.71,0:04:53.14,D,,0,0,0,,여기 함부로 들어오면 안 돼!
Dialogue: 0,0:04:53.21,0:04:54.64,D,,0,0,0,,이민석이라고 합니다
Dialogue: 0,0:04:54.77,0:04:56.23,N,,0,0,0,,민석은 지난번 약 소동이
Dialogue: 0,0:04:56.23,0:04:57.35,N,,0,0,0,,자기 애들 짓이었다며
Dialogue: 0,0:04:57.35,0:04:58.46,N,,0,0,0,,순순히 사과하죠
Dialogue: 0,0:04:58.51,0:04:59.94,D,,0,0,0,,밥은 먹었어?
Dialogue: 0,0:05:00.01,0:05:02.14,D,,0,0,0,,용돈 좀 벌려고 했던 모양인데
Dialogue: 0,0:05:02.21,0:05:04.20,D,,0,0,0,,아직 본 적은 없습니다
Dialogue: 0,0:05:04.27,0:05:06.28,D,,0,0,0,,약판 하다가 뭐 하러 여기 왔어?
Dialogue: 0,0:05:06.35,0:05:09.65,D,,0,0,0,,어떤 인간인지는 알아야지
Dialogue: 0,0:05:09.78,0:05:10.90,N,,0,0,0,,민석은 자기 본업이
Dialogue: 0,0:05:10.90,0:05:12.72,N,,0,0,0,,채권 추심이라고 말합니다
Dialogue: 0,0:05:12.72,0:05:13.82,N,,0,0,0,,돈 못 갚는 사람은
Dialogue: 0,0:05:13.82,0:05:14.94,N,,0,0,0,,팔아 버린다는 소문도
Dialogue: 0,0:05:14.94,0:05:15.37,N,,0,0,0,,있었죠
Dialogue: 0,0:05:15.42,0:05:16.85,D,,0,0,0,,가게에서 담배를?
Dialogue: 0,0:05:16.92,0:05:18.35,D,,0,0,0,,내 본업은 채권추심이야
Dialogue: 0,0:05:18.42,0:05:21.61,D,,0,0,0,,돈 못 주는 애들은 판다던데
Dialogue: 0,0:05:21.68,0:05:23.18,D,,0,0,0,,뭐 하러 그 요만한 걸 했어
Dialogue: 0,0:05:23.31,0:05:24.65,N,,0,0,0,,그러면서 털어놓는 민석의
Dialogue: 0,0:05:24.65,0:05:26.33,N,,0,0,0,,세상 이치는 섬뜩합니다
Dialogue: 0,0:05:26.38,0:05:28.88,D,,0,0,0,,세상엔 이미 주인이 다 있더라고
Dialogue: 0,0:05:28.95,0:05:31.14,D,,0,0,0,,남들이 안 하는 위험한 걸 하거나
Dialogue: 0,0:05:31.21,0:05:33.31,D,,0,0,0,,걱정 마십시오, 아무나 안 치니까
Dialogue: 0,0:05:33.38,0:05:34.81,D,,0,0,0,,생소하시겠네
Dialogue: 0,0:05:34.88,0:05:36.31,D,,0,0,0,,벌써부터 힘 빼지 마세요
Dialogue: 0,0:05:36.44,0:05:38.38,N,,0,0,0,,길석은 선을 긋습니다
Dialogue: 0,0:05:38.38,0:05:39.58,N,,0,0,0,,지분을 넣는 건 좋지만
Dialogue: 0,0:05:39.58,0:05:42.13,N,,0,0,0,,경영에는 손대지 말라고요
Dialogue: 0,0:05:42.18,0:05:44.61,D,,0,0,0,,사무실은 너무 성급한 거 아니나?
Dialogue: 0,0:05:44.68,0:05:46.48,D,,0,0,0,,그러니 성급하다고
Dialogue: 0,0:05:46.55,0:05:48.28,D,,0,0,0,,업무에 들어오는 건 안 돼
Dialogue: 0,0:05:48.35,0:05:50.02,D,,0,0,0,,약 파는 애들이랑
Dialogue: 0,0:05:50.10,0:05:51.42,N,,0,0,0,,그러자 민석은 자기가
Dialogue: 0,0:05:51.42,0:05:53.40,N,,0,0,0,,최대주주라며 맞섭니다
Dialogue: 0,0:05:53.40,0:05:54.74,N,,0,0,0,,싫으면 지분을 사서
Dialogue: 0,0:05:54.74,0:05:55.63,N,,0,0,0,,밀어내라는 거죠
Dialogue: 0,0:05:55.68,0:05:57.51,D,,0,0,0,,우리가 최대주주잖아
Dialogue: 0,0:05:57.58,0:05:59.01,D,,0,0,0,,우릴 밀어내든가
Dialogue: 0,0:05:59.08,0:06:00.85,D,,0,0,0,,그게 맞지 않나?
Dialogue: 0,0:06:00.92,0:06:02.61,D,,0,0,0,,최대주주가 그렇다고 하면
Dialogue: 0,0:06:02.68,0:06:04.28,D,,0,0,0,,난 인정한 걸로 알겠어
Dialogue: 0,0:06:04.41,0:06:05.61,N,,0,0,0,,보고를 받은 오회장은
Dialogue: 0,0:06:05.61,0:06:07.37,N,,0,0,0,,괜히 싸우지 말고 나중에
Dialogue: 0,0:06:07.37,0:06:08.39,N,,0,0,0,,밥이나 한번 먹으라고
Dialogue: 0,0:06:08.39,0:06:08.63,N,,0,0,0,,하죠
Dialogue: 0,0:06:08.68,0:06:10.48,D,,0,0,0,,좀 어떻더나?
Dialogue: 0,0:06:10.55,0:06:11.98,D,,0,0,0,,수고하셨습니다
Dialogue: 0,0:06:12.05,0:06:13.68,D,,0,0,0,,야, 어떻게 왔어?
Dialogue: 0,0:06:13.81,0:06:14.89,N,,0,0,0,,그리고 덕구의 결혼식
Dialogue: 0,0:06:14.89,0:06:15.05,N,,0,0,0,,날
Dialogue: 0,0:06:15.05,0:06:16.63,N,,0,0,0,,식구들이 모인 자리에서도
Dialogue: 0,0:06:16.63,0:06:19.30,N,,0,0,0,,리조트 이야기가 오갑니다
Dialogue: 0,0:06:19.45,0:06:21.84,D,,0,0,0,,경찰서 조 팀장 아나?
Dialogue: 0,0:06:21.91,0:06:23.94,D,,0,0,0,,야, 너 지금 뭐 하나?
Dialogue: 0,0:06:24.01,0:06:26.38,D,,0,0,0,,저희 식구 잔칫날인데
Dialogue: 0,0:06:26.45,0:06:28.31,D,,0,0,0,,그 리조트 형님 준대요?
Dialogue: 0,0:06:28.39,0:06:29.49,N,,0,0,0,,곤란하다며 사양했다는
Dialogue: 0,0:06:29.49,0:06:31.33,N,,0,0,0,,길석의 말에 동생은 왜 자꾸
Dialogue: 0,0:06:31.33,0:06:32.67,N,,0,0,0,,공사판을 기웃거리냐며
Dialogue: 0,0:06:32.67,0:06:33.59,N,,0,0,0,,불만을 터뜨리죠
Dialogue: 0,0:06:33.64,0:06:35.17,D,,0,0,0,,곤란하다고 했지
Dialogue: 0,0:06:35.24,0:06:37.71,D,,0,0,0,,왜 자꾸 공사판에 얼쩡거려요
Dialogue: 0,0:06:37.78,0:06:41.01,D,,0,0,0,,남의 결혼식장에서 뭐 하는 거나
Dialogue: 0,0:06:41.08,0:06:42.91,D,,0,0,0,,드레스 입고 화장한 줄 알아요?
Dialogue: 0,0:06:42.98,0:06:45.84,D,,0,0,0,,오늘은 진짜 이러지 말아요!
Dialogue: 0,0:06:45.91,0:06:48.54,D,,0,0,0,,가지가지 하네 진짜
Dialogue: 0,0:06:48.67,0:06:50.29,N,,0,0,0,,며칠 뒤, 길석은 민석을
Dialogue: 0,0:06:50.29,0:06:51.96,N,,0,0,0,,호숫가로 부릅니다
Dialogue: 0,0:06:52.01,0:06:53.54,D,,0,0,0,,보자고 하신 거 아니었습니까?
Dialogue: 0,0:06:53.61,0:06:55.04,D,,0,0,0,,다 급이 있는 거지
Dialogue: 0,0:06:55.12,0:06:56.98,N,,0,0,0,,길석은 이곳이 강원도에서
Dialogue: 0,0:06:56.98,0:06:58.94,N,,0,0,0,,제일 아름답다고 했던 옛 시를
Dialogue: 0,0:06:58.94,0:06:59.73,N,,0,0,0,,아냐고 묻죠
Dialogue: 0,0:06:59.78,0:07:02.14,D,,0,0,0,,관동별곡이라고 들어봤나?
Dialogue: 0,0:07:02.21,0:07:03.94,D,,0,0,0,,달이나 보고, 술이나 먹고
Dialogue: 0,0:07:04.01,0:07:06.41,D,,0,0,0,,애들도 여서 그래 살았으면
Dialogue: 0,0:07:06.54,0:07:08.00,N,,0,0,0,,그리고 위에서 형님들끼리
Dialogue: 0,0:07:08.00,0:07:09.90,N,,0,0,0,,불편하면 아래도 불편하니
Dialogue: 0,0:07:09.90,0:07:11.06,N,,0,0,0,,우리끼리 사고 치지
Dialogue: 0,0:07:11.06,0:07:12.02,N,,0,0,0,,말자고 제안합니다
Dialogue: 0,0:07:12.07,0:07:14.47,D,,0,0,0,,위가 불편하면 우리도 불편하니까
Dialogue: 0,0:07:14.54,0:07:18.37,D,,0,0,0,,말처럼 쉽게 되나요?
Dialogue: 0,0:07:18.44,0:07:20.10,D,,0,0,0,,내가 다 이해한다니까?
Dialogue: 0,0:07:20.23,0:07:22.09,N,,0,0,0,,산전수전 다 겪은 걸 이해한다는
Dialogue: 0,0:07:22.09,0:07:23.59,N,,0,0,0,,길석의 말에, 민석은
Dialogue: 0,0:07:23.59,0:07:24.61,N,,0,0,0,,노가다 시절 이야기를
Dialogue: 0,0:07:24.61,0:07:25.05,N,,0,0,0,,꺼내죠
Dialogue: 0,0:07:25.10,0:07:27.63,D,,0,0,0,,어릴 때 노가다를 한 적 있습니다
Dialogue: 0,0:07:27.70,0:07:31.37,D,,0,0,0,,돈 버는 게 쉬운 게 아니지
Dialogue: 0,0:07:31.50,0:07:32.70,N,,0,0,0,,삼십 년 일한 선배에게
Dialogue: 0,0:07:32.70,0:07:34.82,N,,0,0,0,,대단하다고 했더니, 넌 아무것도
Dialogue: 0,0:07:34.82,0:07:36.66,N,,0,0,0,,모른다며 모멸감을 느끼더라는
Dialogue: 0,0:07:36.66,0:07:37.39,N,,0,0,0,,겁니다
Dialogue: 0,0:07:37.44,0:07:40.11,D,,0,0,0,,어떻게 이 힘든 걸 30년을 했냐
Dialogue: 0,0:07:40.18,0:07:41.61,D,,0,0,0,,넌 아무것도 모른다
Dialogue: 0,0:07:41.68,0:07:44.34,D,,0,0,0,,그 형님 모멸감을 느끼신 거죠
Dialogue: 0,0:07:44.41,0:07:46.11,D,,0,0,0,,새파랗게 어린 놈이
Dialogue: 0,0:07:46.18,0:07:49.51,D,,0,0,0,,함부로 이해한다고 하지 마세요
Dialogue: 0,0:07:49.58,0:07:52.27,D,,0,0,0,,그 말이 기분 나쁜 말이네?
Dialogue: 0,0:07:52.40,0:07:53.40,N,,0,0,0,,한편 조직의 또 다른
Dialogue: 0,0:07:53.40,0:07:55.08,N,,0,0,0,,형님 충섭은 리조트가
Dialogue: 0,0:07:55.08,0:07:57.22,N,,0,0,0,,길석에게 간 게 못마땅합니다
Dialogue: 0,0:07:57.27,0:08:00.00,D,,0,0,0,,형님 참 팔자도 좋소
Dialogue: 0,0:08:00.07,0:08:02.78,D,,0,0,0,,길석이 형님은 리조트 먹는데?
Dialogue: 0,0:08:02.85,0:08:05.56,D,,0,0,0,,그래도 서열이 있고 구역이 있는데
Dialogue: 0,0:08:05.63,0:08:08.00,D,,0,0,0,,이래 주나 저래 주나 형님 마음
Dialogue: 0,0:08:08.07,0:08:11.90,D,,0,0,0,,어떤 일은 가만히 있어도
Dialogue: 0,0:08:12.03,0:08:13.47,N,,0,0,0,,오회장은 태풍이 올 때는
Dialogue: 0,0:08:13.47,0:08:14.83,N,,0,0,0,,바다에 나가는 게 아니라며
Dialogue: 0,0:08:14.83,0:08:16.12,N,,0,0,0,,충섭을 다독이죠
Dialogue: 0,0:08:16.17,0:08:17.80,D,,0,0,0,,태풍 올 때는
Dialogue: 0,0:08:17.87,0:08:20.50,D,,0,0,0,,언제 기상청 믿고 조업 나갔소?
Dialogue: 0,0:08:20.57,0:08:23.07,D,,0,0,0,,지금 나 걱정하는 거야?
Dialogue: 0,0:08:23.20,0:08:24.52,N,,0,0,0,,민석은 빚에 묶인 은선에게
Dialogue: 0,0:08:24.52,0:08:25.60,N,,0,0,0,,묻습니다
Dialogue: 0,0:08:25.60,0:08:26.88,N,,0,0,0,,원금은 못 갚고 이자만
Dialogue: 0,0:08:26.88,0:08:28.36,N,,0,0,0,,몸으로 때워서 어떡할
Dialogue: 0,0:08:28.36,0:08:28.93,N,,0,0,0,,거냐고요
Dialogue: 0,0:08:29.24,0:08:33.07,D,,0,0,0,,이자만 갚아서 어떡할 거냐고
Dialogue: 0,0:08:33.14,0:08:34.80,D,,0,0,0,,너도 살아야 되지 않겠어?
Dialogue: 0,0:08:34.93,0:08:36.47,N,,0,0,0,,은선에게 민석은 무언가를
Dialogue: 0,0:08:36.47,0:08:37.94,N,,0,0,0,,감당할 수 있냐고 묻습니다
Dialogue: 0,0:08:38.21,0:08:41.90,D,,0,0,0,,넌 내가 다가가면 더 멀어진다
Dialogue: 0,0:08:41.97,0:08:44.80,D,,0,0,0,,그래서 넌 어떻게 할 건데?
Dialogue: 0,0:08:44.87,0:08:46.80,D,,0,0,0,,나 감당해 줄 수 있어?
Dialogue: 0,0:08:46.88,0:08:48.17,N,,0,0,0,,그리고 민석은 은선을
Dialogue: 0,0:08:48.17,0:08:49.59,N,,0,0,0,,데리고 오회장의 한옥을
Dialogue: 0,0:08:49.59,0:08:51.02,N,,0,0,0,,찾아갑니다
Dialogue: 0,0:08:51.07,0:08:52.50,D,,0,0,0,,여기까지 어쩐 일이야?
Dialogue: 0,0:08:52.57,0:08:54.70,D,,0,0,0,,일은 하던 사람이 해야지
Dialogue: 0,0:08:54.78,0:08:55.55,N,,0,0,0,,안 해 본 일이 없다는
Dialogue: 0,0:08:55.55,0:08:57.39,N,,0,0,0,,민석에게 오회장은 그 손에
Dialogue: 0,0:08:57.39,0:08:58.49,N,,0,0,0,,피가 많이 묻었겠다고
Dialogue: 0,0:08:58.49,0:08:58.85,N,,0,0,0,,하죠
Dialogue: 0,0:08:58.90,0:09:00.83,D,,0,0,0,,안 해 본 일이 없던데
Dialogue: 0,0:09:00.90,0:09:02.80,D,,0,0,0,,죽은 사람들이 불쌍하죠
Dialogue: 0,0:09:02.87,0:09:06.70,D,,0,0,0,,펜 잡으면 잉크, 칼 잡으면 피
Dialogue: 0,0:09:06.83,0:09:07.69,N,,0,0,0,,민석은 닭 이야기를
Dialogue: 0,0:09:07.69,0:09:08.73,N,,0,0,0,,꺼냅니다
Dialogue: 0,0:09:08.73,0:09:09.85,N,,0,0,0,,요즘엔 마트에만 가면
Dialogue: 0,0:09:09.85,0:09:10.59,N,,0,0,0,,닭이 있다고요
Dialogue: 0,0:09:10.64,0:09:12.87,D,,0,0,0,,요즘은 펜을 잡아야 피가 묻고
Dialogue: 0,0:09:12.94,0:09:16.17,D,,0,0,0,,닭 한 마리 먹더라도
Dialogue: 0,0:09:16.24,0:09:18.43,D,,0,0,0,,마트에만 가면 닭이 있어요
Dialogue: 0,0:09:18.50,0:09:20.96,D,,0,0,0,,절대 잊으면 안 되는 게 있죠
Dialogue: 0,0:09:21.03,0:09:24.86,D,,0,0,0,,닭 모가지를 비틀고
Dialogue: 0,0:09:24.93,0:09:28.76,D,,0,0,0,,잊고 살려고 열심히 사는 거지
Dialogue: 0,0:09:28.89,0:09:30.25,N,,0,0,0,,그리고 대뜸 묻습니다
Dialogue: 0,0:09:30.25,0:09:31.63,N,,0,0,0,,회장님은 사람을 죽여
Dialogue: 0,0:09:31.63,0:09:32.25,N,,0,0,0,,봤냐고요
Dialogue: 0,0:09:32.30,0:09:33.86,D,,0,0,0,,사람이 너무 좋아 보였어요
Dialogue: 0,0:09:33.99,0:09:35.47,N,,0,0,0,,오회장은 세상 일은
Dialogue: 0,0:09:35.47,0:09:36.97,N,,0,0,0,,결국 정도의 차이라고
Dialogue: 0,0:09:36.97,0:09:37.48,N,,0,0,0,,답하죠
Dialogue: 0,0:09:37.53,0:09:39.40,D,,0,0,0,,저도 참 그게 궁금하네요
Dialogue: 0,0:09:39.47,0:09:43.30,D,,0,0,0,,백 명 죽인 놈과 하나 죽인 놈
Dialogue: 0,0:09:43.37,0:09:46.50,D,,0,0,0,,모든 일은 결국 정도의 차이야
Dialogue: 0,0:09:46.63,0:09:48.34,N,,0,0,0,,용건을 묻는 오회장에게
Dialogue: 0,0:09:48.34,0:09:50.00,N,,0,0,0,,민석은 따로 드릴 말씀은
Dialogue: 0,0:09:50.00,0:09:50.65,N,,0,0,0,,없다고 하더니
Dialogue: 0,0:09:50.70,0:09:52.41,D,,0,0,0,,그래서 용건이 뭐여?
Dialogue: 0,0:09:52.48,0:09:54.11,D,,0,0,0,,얘기 끝났다고 들었는데
Dialogue: 0,0:09:54.18,0:09:55.81,D,,0,0,0,,따로 드릴 말씀은 없습니다
Dialogue: 0,0:09:55.88,0:09:58.21,D,,0,0,0,,이제 그만 가세요
Dialogue: 0,0:09:58.29,0:09:59.52,N,,0,0,0,,결국 노인을 무참히
Dialogue: 0,0:09:59.52,0:10:00.70,N,,0,0,0,,공격하고 맙니다
Dialogue: 0,0:10:03.21,0:10:04.77,N,,0,0,0,,오회장은 병원으로 옮겨졌지만
Dialogue: 0,0:10:04.77,0:10:06.16,N,,0,0,0,,끝내 숨을 거둡니다
Dialogue: 0,0:10:06.21,0:10:09.64,D,,0,0,0,,피를 너무 많이 흘리셨습니다
Dialogue: 0,0:10:09.77,0:10:11.09,N,,0,0,0,,그런데 경찰서에 자수한
Dialogue: 0,0:10:11.09,0:10:13.44,N,,0,0,0,,범인은 뜻밖에도 은선이었습니다
Dialogue: 0,0:10:13.84,0:10:16.27,D,,0,0,0,,그러니까 여기 와 있죠
Dialogue: 0,0:10:16.34,0:10:18.57,D,,0,0,0,,늙은이는 못 죽일까 봐요?
Dialogue: 0,0:10:18.64,0:10:21.75,D,,0,0,0,,도대체 뭐했어?
Dialogue: 0,0:10:21.82,0:10:23.25,D,,0,0,0,,나도 살려고
Dialogue: 0,0:10:23.38,0:10:25.04,N,,0,0,0,,장례가 치러지고, 방현은
Dialogue: 0,0:10:25.04,0:10:27.46,N,,0,0,0,,은선의 뒤를 캐기 시작합니다
Dialogue: 0,0:10:27.46,0:10:28.60,N,,0,0,0,,은선이 일했던 곳은
Dialogue: 0,0:10:28.60,0:10:30.49,N,,0,0,0,,바로 민석의 회사였죠
Dialogue: 0,0:10:30.72,0:10:32.85,D,,0,0,0,,채권 추심 일을 했어요
Dialogue: 0,0:10:32.92,0:10:35.22,D,,0,0,0,,일단 가만히 있으라니까
Dialogue: 0,0:10:35.29,0:10:36.98,D,,0,0,0,,죽었잖아!
Dialogue: 0,0:10:37.11,0:10:38.53,N,,0,0,0,,그때 경찰 조팀장이
Dialogue: 0,0:10:38.53,0:10:40.07,N,,0,0,0,,길석에게 사람 하나를
Dialogue: 0,0:10:40.07,0:10:41.37,N,,0,0,0,,소개합니다
Dialogue: 0,0:10:41.37,0:10:43.60,N,,0,0,0,,서울 청송기획의 신사장이었죠
Dialogue: 0,0:10:43.65,0:10:45.08,D,,0,0,0,,김 사장이 왔나?
Dialogue: 0,0:10:45.15,0:10:46.59,D,,0,0,0,,청송기획 신사장님
Dialogue: 0,0:10:46.66,0:10:48.09,D,,0,0,0,,청송기획이요?
Dialogue: 0,0:10:48.16,0:10:50.39,D,,0,0,0,,남회장인가 뭔가 거기?
Dialogue: 0,0:10:50.46,0:10:52.92,D,,0,0,0,,우리 김사장, 성격 급하시네
Dialogue: 0,0:10:53.05,0:10:54.73,N,,0,0,0,,조팀장의 계획은 민석을
Dialogue: 0,0:10:54.73,0:10:56.39,N,,0,0,0,,잡아넣고, 그 빈자리에
Dialogue: 0,0:10:56.39,0:10:57.75,N,,0,0,0,,신사장의 돈을 들이자는
Dialogue: 0,0:10:57.75,0:10:58.34,N,,0,0,0,,것이었습니다
Dialogue: 0,0:10:58.39,0:11:01.32,D,,0,0,0,,이민석이 잡으려고 준비 중인 걸로
Dialogue: 0,0:11:01.39,0:11:03.75,D,,0,0,0,,경찰이 왜 중간에서 중매를 서요?
Dialogue: 0,0:11:03.82,0:11:07.65,D,,0,0,0,,여기저기 손이나 벌리고 다니고
Dialogue: 0,0:11:07.78,0:11:09.16,N,,0,0,0,,길석은 단칼에 거절합니다
Dialogue: 0,0:11:09.16,0:11:10.72,N,,0,0,0,,회장님 묻은 자리에
Dialogue: 0,0:11:10.72,0:11:12.40,N,,0,0,0,,아직 풀도 안 났다고요
Dialogue: 0,0:11:12.45,0:11:15.95,D,,0,0,0,,우리 회장님 묻은 자리예요
Dialogue: 0,0:11:16.02,0:11:18.52,D,,0,0,0,,말씀 아주 잘 알아들었습니다
Dialogue: 0,0:11:18.59,0:11:20.02,D,,0,0,0,,마저 드시고 가요
Dialogue: 0,0:11:20.15,0:11:21.65,N,,0,0,0,,길석이 빠지자 조팀장
Dialogue: 0,0:11:21.65,0:11:22.71,N,,0,0,0,,쪽은 직접 움직입니다
Dialogue: 0,0:11:22.71,0:11:24.67,N,,0,0,0,,민석의 부하 하나를
Dialogue: 0,0:11:24.67,0:11:26.40,N,,0,0,0,,붙잡아 거꾸로 매달았죠
Dialogue: 0,0:11:26.59,0:11:28.52,D,,0,0,0,,일단 그냥 때리기만 했는데요
Dialogue: 0,0:11:28.59,0:11:31.48,D,,0,0,0,,왜 거꾸로 매달아? 멀미하잖아
Dialogue: 0,0:11:31.55,0:11:33.45,D,,0,0,0,,우리가 이런 걸 안 해 봐 가지고
Dialogue: 0,0:11:33.58,0:11:35.04,N,,0,0,0,,그리고 그의 어머니가
Dialogue: 0,0:11:35.04,0:11:36.03,N,,0,0,0,,위암이라는 걸 꺼내
Dialogue: 0,0:11:36.03,0:11:36.40,N,,0,0,0,,듭니다
Dialogue: 0,0:11:36.45,0:11:40.28,D,,0,0,0,,불러다 조질 거면 이유라도
Dialogue: 0,0:11:40.35,0:11:41.78,D,,0,0,0,,그 매운 걸 많이 드셨나?
Dialogue: 0,0:11:41.85,0:11:44.25,D,,0,0,0,,병원비가 많이 들 텐데
Dialogue: 0,0:11:44.32,0:11:46.05,D,,0,0,0,,니 어머니 수술비 줄게
Dialogue: 0,0:11:46.12,0:11:47.81,D,,0,0,0,,딱 시간이랑 장소만 대
Dialogue: 0,0:11:47.88,0:11:50.18,D,,0,0,0,,시간, 장소 받고 있어요
Dialogue: 0,0:11:50.26,0:11:52.48,N,,0,0,0,,드디어 거래 날 밤
Dialogue: 0,0:11:52.48,0:11:53.94,N,,0,0,0,,조팀장의 형사들이 잠복에
Dialogue: 0,0:11:53.94,0:11:54.26,N,,0,0,0,,들어갑니다
Dialogue: 0,0:11:54.31,0:11:56.24,D,,0,0,0,,출발했답니다
Dialogue: 0,0:11:56.31,0:11:59.14,D,,0,0,0,,조 팀장 실패하면 바로 움직여요
Dialogue: 0,0:11:59.21,0:12:00.71,D,,0,0,0,,술 좀 그만 먹어요
Dialogue: 0,0:12:00.78,0:12:04.54,D,,0,0,0,,중앙시장으로 들어갑니다
Dialogue: 0,0:12:04.61,0:12:07.84,D,,0,0,0,,중앙시장 내부로 들어갑니다
Dialogue: 0,0:12:07.91,0:12:10.38,D,,0,0,0,,혼자 움직입니다
Dialogue: 0,0:12:10.51,0:12:11.63,N,,0,0,0,,그리고 마침내 거래
Dialogue: 0,0:12:11.63,0:12:12.60,N,,0,0,0,,현장을 덮칩니다
Dialogue: 0,0:12:12.65,0:12:14.54,D,,0,0,0,,잡았습니다
Dialogue: 0,0:12:14.61,0:12:16.04,D,,0,0,0,,그물에 걸렸습니다
Dialogue: 0,0:12:16.11,0:12:17.54,D,,0,0,0,,움직이지 마
Dialogue: 0,0:12:17.67,0:12:19.53,N,,0,0,0,,물건과 돈은 손에 넣었지만
Dialogue: 0,0:12:19.53,0:12:20.96,N,,0,0,0,,정작 민석은 놓치고
Dialogue: 0,0:12:20.96,0:12:21.38,N,,0,0,0,,말죠
Dialogue: 0,0:12:21.74,0:12:23.67,D,,0,0,0,,물건 확보했습니다
Dialogue: 0,0:12:23.74,0:12:25.51,D,,0,0,0,,내가 이럴 줄 알았다니
Dialogue: 0,0:12:25.58,0:12:27.81,D,,0,0,0,,자, 준비해라
Dialogue: 0,0:12:27.94,0:12:30.08,N,,0,0,0,,민석은 이 모든 게 길석의
Dialogue: 0,0:12:30.08,0:12:31.88,N,,0,0,0,,짓이라고 믿습니다
Dialogue: 0,0:12:31.88,0:12:33.56,N,,0,0,0,,그날 밤, 충섭의 가게에
Dialogue: 0,0:12:33.56,0:12:35.39,N,,0,0,0,,칼을 든 사내들이 들이닥치죠
Dialogue: 0,0:12:35.78,0:12:37.28,D,,0,0,0,,팔자 좋은 형님 뭐 해요?
Dialogue: 0,0:12:37.35,0:12:39.25,D,,0,0,0,,진짜 이런다고?
Dialogue: 0,0:12:39.38,0:12:41.48,N,,0,0,0,,그 선두에는 첫 장면의 긴 머리
Dialogue: 0,0:12:41.48,0:12:42.53,N,,0,0,0,,남자가 있었습니다
Dialogue: 0,0:12:44.98,0:12:46.41,D,,0,0,0,,센 척하지 마
Dialogue: 0,0:12:46.54,0:12:48.20,N,,0,0,0,,칼에 맞은 동생은 마지막으로
Dialogue: 0,0:12:48.20,0:12:49.63,N,,0,0,0,,길석에게 전화를 겁니다
Dialogue: 0,0:12:49.68,0:12:51.88,D,,0,0,0,,나 진짜 이럴 줄은 몰랐네
Dialogue: 0,0:12:51.95,0:12:53.38,D,,0,0,0,,너 지금 어디냐고
Dialogue: 0,0:12:53.45,0:12:55.64,D,,0,0,0,,형님한테 잘할 생각은 아니었는데
Dialogue: 0,0:12:55.71,0:12:57.24,D,,0,0,0,,잘한 게 너무 없다
Dialogue: 0,0:12:57.31,0:12:58.74,D,,0,0,0,,미안해요
Dialogue: 0,0:12:58.82,0:13:00.13,N,,0,0,0,,동생은 끝내 충섭의
Dialogue: 0,0:13:00.13,0:13:01.83,N,,0,0,0,,품에서 숨을 거둡니다
Dialogue: 0,0:13:04.34,0:13:06.44,N,,0,0,0,,같은 시각 길석도 포장마차에서
Dialogue: 0,0:13:06.44,0:13:07.88,N,,0,0,0,,습격을 당합니다
Dialogue: 0,0:13:07.88,0:13:09.00,N,,0,0,0,,옆구리에 칼을 맞고
Dialogue: 0,0:13:09.00,0:13:09.30,N,,0,0,0,,말죠
Dialogue: 0,0:13:11.75,0:13:13.18,D,,0,0,0,,오늘은 여기까지인가 봅니다
Dialogue: 0,0:13:13.31,0:13:15.05,N,,0,0,0,,그날 밤 길석의 식구들은
Dialogue: 0,0:13:15.05,0:13:16.60,N,,0,0,0,,피바다 속에 쓰러졌습니다
Dialogue: 0,0:13:16.71,0:13:18.45,N,,0,0,0,,방현은 민석을 찾아가
Dialogue: 0,0:13:18.45,0:13:20.57,N,,0,0,0,,비꼬듯 축하를 건넵니다
Dialogue: 0,0:13:20.57,0:13:21.95,N,,0,0,0,,알아서 죽여 주는 부하들
Dialogue: 0,0:13:21.95,0:13:23.30,N,,0,0,0,,덕에 혐의가 없다고요
Dialogue: 0,0:13:23.35,0:13:26.58,D,,0,0,0,,축하받을 일은 아닌 것 같은데요
Dialogue: 0,0:13:26.65,0:13:28.64,D,,0,0,0,,알아서 죽여 주는 부하들도 있고
Dialogue: 0,0:13:28.77,0:13:30.92,N,,0,0,0,,그리고 이 모든 게 민석이
Dialogue: 0,0:13:30.92,0:13:32.20,N,,0,0,0,,충섭을 꼬드겨 벌어진
Dialogue: 0,0:13:32.20,0:13:33.39,N,,0,0,0,,일이라고 쏘아붙이죠
Dialogue: 0,0:13:33.44,0:13:35.21,D,,0,0,0,,난 사주를 한 적이 없어
Dialogue: 0,0:13:35.28,0:13:38.64,D,,0,0,0,,길석이가 리조트 다 가져도 되냐고
Dialogue: 0,0:13:38.71,0:13:40.77,D,,0,0,0,,김 사장님 어디 있는지 알아요?
Dialogue: 0,0:13:40.84,0:13:44.67,D,,0,0,0,,소식 들으면 꼭 연락해
Dialogue: 0,0:13:44.80,0:13:46.24,N,,0,0,0,,방현은 교도소의 은선을
Dialogue: 0,0:13:46.24,0:13:47.40,N,,0,0,0,,찾아갑니다
Dialogue: 0,0:13:47.40,0:13:48.64,N,,0,0,0,,네가 한 짓이 아니라고만
Dialogue: 0,0:13:48.64,0:13:50.06,N,,0,0,0,,하면 나머지는 알아서
Dialogue: 0,0:13:50.06,0:13:50.89,N,,0,0,0,,하겠다고요
Dialogue: 0,0:13:51.24,0:13:53.71,D,,0,0,0,,니 솔직히 후회하지?
Dialogue: 0,0:13:53.78,0:13:57.61,D,,0,0,0,,한가해서 면상 보러 온 줄 알아?
Dialogue: 0,0:13:57.68,0:14:01.51,D,,0,0,0,,네가 안 했다고 한마디만 하면
Dialogue: 0,0:14:01.58,0:14:03.01,D,,0,0,0,,제 빚은요?
Dialogue: 0,0:14:03.08,0:14:05.68,D,,0,0,0,,파산하고 개인회생하고
Dialogue: 0,0:14:05.81,0:14:06.95,N,,0,0,0,,파산하면 된다는 말에
Dialogue: 0,0:14:06.95,0:14:09.33,N,,0,0,0,,은선은 쓴웃음을 짓습니다
Dialogue: 0,0:14:09.33,0:14:11.08,N,,0,0,0,,끝까지 찾아내 장기까지 팔
Dialogue: 0,0:14:11.08,0:14:11.80,N,,0,0,0,,거라고요
Dialogue: 0,0:14:11.85,0:14:14.88,D,,0,0,0,,결국 장기까지 다 꺼내서 팔겠지
Dialogue: 0,0:14:14.95,0:14:17.28,D,,0,0,0,,왜 아직 살아 있는 줄 알아요?
Dialogue: 0,0:14:17.35,0:14:19.14,D,,0,0,0,,그러니까 그냥 가요
Dialogue: 0,0:14:19.21,0:14:21.01,D,,0,0,0,,혐의가 차고 넘친다니
Dialogue: 0,0:14:21.08,0:14:23.14,D,,0,0,0,,그거 욕심이라고 생각하세요?
Dialogue: 0,0:14:23.21,0:14:24.64,D,,0,0,0,,제가 응원할게요
Dialogue: 0,0:14:24.77,0:14:26.21,N,,0,0,0,,민석은 바다를 바라보며
Dialogue: 0,0:14:26.21,0:14:27.95,N,,0,0,0,,서해보다 동해가 좋다고
Dialogue: 0,0:14:27.95,0:14:28.53,N,,0,0,0,,말합니다
Dialogue: 0,0:14:28.58,0:14:30.01,D,,0,0,0,,서해보다 동해가 좋다
Dialogue: 0,0:14:30.08,0:14:33.91,D,,0,0,0,,여기 살았으면 좀 달랐을까?
Dialogue: 0,0:14:34.04,0:14:34.98,N,,0,0,0,,그 자리에서 길석은
Dialogue: 0,0:14:34.98,0:14:37.06,N,,0,0,0,,민석에게 협상을 제안합니다
Dialogue: 0,0:14:37.11,0:14:38.54,D,,0,0,0,,심지어 거도 반가워
Dialogue: 0,0:14:38.61,0:14:40.80,D,,0,0,0,,협상?
Dialogue: 0,0:14:40.80,0:14:42.31,D,,0,0,0,,그냥 사업이지
Dialogue: 0,0:14:42.38,0:14:45.07,D,,0,0,0,,이제 거를 배제하기는 어렵고
Dialogue: 0,0:14:45.14,0:14:46.57,D,,0,0,0,,내가 카지노
Dialogue: 0,0:14:46.64,0:14:48.34,D,,0,0,0,,정보 투명하게 공개하고
Dialogue: 0,0:14:48.47,0:14:50.47,N,,0,0,0,,길석은 칼을 들었으면 한 방에
Dialogue: 0,0:14:50.47,0:14:52.02,N,,0,0,0,,보냈어야 했다고 받아칩니다
Dialogue: 0,0:14:52.07,0:14:53.70,D,,0,0,0,,아무 일도 없던 것처럼?
Dialogue: 0,0:14:53.77,0:14:57.60,D,,0,0,0,,힘이 많이 빠지셨습니다
Dialogue: 0,0:14:57.67,0:15:00.57,D,,0,0,0,,칼을 들었으면 한 방에 보냈어야지
Dialogue: 0,0:15:00.64,0:15:03.47,D,,0,0,0,,칼 맞으면 무서워서 못 보던데
Dialogue: 0,0:15:03.54,0:15:05.17,D,,0,0,0,,무섭지? 옆구리에 구멍 났는데
Dialogue: 0,0:15:05.24,0:15:07.20,D,,0,0,0,,너라고 내가 안 무섭겠나?
Dialogue: 0,0:15:07.33,0:15:08.99,N,,0,0,0,,민석은 길석이 경찰과
Dialogue: 0,0:15:08.99,0:15:10.12,N,,0,0,0,,손잡고 자기를 치려
Dialogue: 0,0:15:10.12,0:15:11.42,N,,0,0,0,,했다며 믿지 못하죠
Dialogue: 0,0:15:11.47,0:15:14.24,D,,0,0,0,,사단이 나니까 믿음이 안 가네
Dialogue: 0,0:15:14.31,0:15:16.57,D,,0,0,0,,손 떼라니까 알았다고 했잖아
Dialogue: 0,0:15:16.64,0:15:19.85,D,,0,0,0,,경찰이랑 손잡고 나 치려고 했잖아
Dialogue: 0,0:15:19.92,0:15:21.35,D,,0,0,0,,오늘 대화는 어떻나
Dialogue: 0,0:15:21.42,0:15:23.62,D,,0,0,0,,말만큼 의미 없는 게 없어요
Dialogue: 0,0:15:23.69,0:15:25.38,D,,0,0,0,,그게 인간이야
Dialogue: 0,0:15:25.45,0:15:27.88,D,,0,0,0,,그냥 두고 보는 거야
Dialogue: 0,0:15:28.01,0:15:28.87,N,,0,0,0,,방현이 길석을 찾아옵니다
Dialogue: 0,0:15:28.87,0:15:31.07,N,,0,0,0,,민석을 만났다는 소식을
Dialogue: 0,0:15:31.07,0:15:31.50,N,,0,0,0,,들은 거죠
Dialogue: 0,0:15:31.55,0:15:32.98,D,,0,0,0,,이민석이 만났다며
Dialogue: 0,0:15:33.05,0:15:34.95,D,,0,0,0,,니 뭐 어떻게 하려고?
Dialogue: 0,0:15:35.02,0:15:37.18,D,,0,0,0,,니도 똑같이 칼 들고 설치려고?
Dialogue: 0,0:15:37.25,0:15:39.68,D,,0,0,0,,벽에 똥칠할 친구 하나 있어야지
Dialogue: 0,0:15:39.75,0:15:41.98,D,,0,0,0,,나 이제 니 어떻게 만나겠나?
Dialogue: 0,0:15:42.11,0:15:43.27,N,,0,0,0,,낭만도 없이 어떻게
Dialogue: 0,0:15:43.27,0:15:44.95,N,,0,0,0,,사냐는 방현에게, 길석은
Dialogue: 0,0:15:44.95,0:15:46.67,N,,0,0,0,,낭만은 씨가 말랐다고
Dialogue: 0,0:15:46.67,0:15:47.07,N,,0,0,0,,답하죠
Dialogue: 0,0:15:47.12,0:15:50.51,D,,0,0,0,,낭만도 없이 이 세상 어때 사나?
Dialogue: 0,0:15:50.58,0:15:52.55,D,,0,0,0,,낭만이 씨가 마른 지가 언젠데
Dialogue: 0,0:15:52.62,0:15:54.05,D,,0,0,0,,니는 니 할 일 하고
Dialogue: 0,0:15:54.12,0:15:56.08,D,,0,0,0,,나한테 맡기면 내가 잘 처리할게
Dialogue: 0,0:15:56.15,0:15:57.78,D,,0,0,0,,니 말은 못 믿겠다
Dialogue: 0,0:15:57.91,0:15:59.11,N,,0,0,0,,길석이 찾아간 사람은
Dialogue: 0,0:15:59.11,0:16:00.66,N,,0,0,0,,뜻밖에도 신사장이었습니다
Dialogue: 0,0:16:00.71,0:16:02.18,D,,0,0,0,,상황이 많이 안 좋다고
Dialogue: 0,0:16:02.25,0:16:04.42,D,,0,0,0,,무슨 일로 부르셨습니까?
Dialogue: 0,0:16:04.55,0:16:05.95,N,,0,0,0,,그리고 단도직입적으로
Dialogue: 0,0:16:05.95,0:16:06.94,N,,0,0,0,,말하죠
Dialogue: 0,0:16:06.94,0:16:08.59,N,,0,0,0,,민석을 죽이려는데 도와
Dialogue: 0,0:16:08.59,0:16:09.77,N,,0,0,0,,달라고요
Dialogue: 0,0:16:09.82,0:16:11.15,D,,0,0,0,,이민석이 죽이려고요
Dialogue: 0,0:16:11.22,0:16:13.88,D,,0,0,0,,사장님도 볼일이 좀 있지 않아요?
Dialogue: 0,0:16:13.95,0:16:15.38,D,,0,0,0,,안 합니다
Dialogue: 0,0:16:15.45,0:16:16.88,D,,0,0,0,,누가 믿겠습니까
Dialogue: 0,0:16:16.95,0:16:18.66,D,,0,0,0,,내가 호구라서 가만있었을까요
Dialogue: 0,0:16:18.74,0:16:19.70,N,,0,0,0,,그러자 길석이 판을
Dialogue: 0,0:16:19.70,0:16:20.76,N,,0,0,0,,키웁니다
Dialogue: 0,0:16:20.76,0:16:22.02,N,,0,0,0,,민석의 지분까지 넘길
Dialogue: 0,0:16:22.02,0:16:23.75,N,,0,0,0,,테니 최대주주가 되라고요
Dialogue: 0,0:16:23.80,0:16:27.33,D,,0,0,0,,힘은 내가 다 쓸 텐데
Dialogue: 0,0:16:27.40,0:16:28.83,D,,0,0,0,,최대주주 하세요
Dialogue: 0,0:16:28.90,0:16:30.86,D,,0,0,0,,내가 이민석이 지분 가져오고
Dialogue: 0,0:16:30.93,0:16:33.06,D,,0,0,0,,사장님이 최대주주 되는 거죠
Dialogue: 0,0:16:33.13,0:16:34.56,D,,0,0,0,,어때요?
Dialogue: 0,0:16:34.63,0:16:36.06,D,,0,0,0,,할 수 있겠습니까?
Dialogue: 0,0:16:36.19,0:16:37.73,N,,0,0,0,,길석이 지분을 신사장에게
Dialogue: 0,0:16:37.73,0:16:39.79,N,,0,0,0,,넘겼다는 소식은 곧 민석의
Dialogue: 0,0:16:39.79,0:16:40.62,N,,0,0,0,,귀에 들어갑니다
Dialogue: 0,0:16:40.67,0:16:43.50,D,,0,0,0,,청송기획에 지분을 넘겼답니다
Dialogue: 0,0:16:43.57,0:16:45.28,D,,0,0,0,,저희가 먼저 칠까요?
Dialogue: 0,0:16:45.41,0:16:47.21,N,,0,0,0,,그날 밤 길석은 어시장에서
Dialogue: 0,0:16:47.21,0:16:49.09,N,,0,0,0,,충섭과 마주 앉습니다
Dialogue: 0,0:16:49.09,0:16:50.31,N,,0,0,0,,그리고 묻죠
Dialogue: 0,0:16:50.31,0:16:51.28,N,,0,0,0,,왜 그랬냐고요
Dialogue: 0,0:16:52.05,0:16:54.34,D,,0,0,0,,왜서 그랬어요?
Dialogue: 0,0:16:54.41,0:16:57.04,D,,0,0,0,,그게 뭐 욕심인가 뭐인가
Dialogue: 0,0:16:57.17,0:16:58.87,N,,0,0,0,,충섭은 대답 대신 자기가
Dialogue: 0,0:16:58.87,0:17:00.23,N,,0,0,0,,어떻게 건달이 됐는지
Dialogue: 0,0:17:00.23,0:17:01.19,N,,0,0,0,,털어놓습니다
Dialogue: 0,0:17:01.24,0:17:05.07,D,,0,0,0,,너는 어떻게 건달이 됐는지 아나?
Dialogue: 0,0:17:05.14,0:17:07.84,D,,0,0,0,,어부들이 밤새 잡아 온 오징어를
Dialogue: 0,0:17:07.91,0:17:11.54,D,,0,0,0,,서울 놈들이 장난질을 치더라고
Dialogue: 0,0:17:11.61,0:17:15.14,D,,0,0,0,,큰형님이랑 둘이 잡아 조졌지
Dialogue: 0,0:17:15.21,0:17:16.64,D,,0,0,0,,한 사발 사 주데
Dialogue: 0,0:17:16.71,0:17:19.01,D,,0,0,0,,한동안 그래 잘 살았어
Dialogue: 0,0:17:19.14,0:17:20.12,N,,0,0,0,,하지만 큰 회사들이
Dialogue: 0,0:17:20.12,0:17:22.19,N,,0,0,0,,들어오자 주먹으로는 더 버틸 수
Dialogue: 0,0:17:22.19,0:17:22.83,N,,0,0,0,,없었다고요
Dialogue: 0,0:17:22.88,0:17:26.71,D,,0,0,0,,회사도 차리고 명함도 박고 그랬지
Dialogue: 0,0:17:26.78,0:17:28.27,D,,0,0,0,,열심히 살았다 야
Dialogue: 0,0:17:28.40,0:17:30.14,N,,0,0,0,,충섭의 꿈은 저런 리조트를
Dialogue: 0,0:17:30.14,0:17:31.80,N,,0,0,0,,하나 짓는 거였죠
Dialogue: 0,0:17:31.80,0:17:32.62,N,,0,0,0,,그건 욕심이 아니라
Dialogue: 0,0:17:32.62,0:17:35.19,N,,0,0,0,,우리 것이라고 생각했다고요
Dialogue: 0,0:17:35.24,0:17:39.07,D,,0,0,0,,저런 거 하나 짓는 게 꿈이었어
Dialogue: 0,0:17:39.14,0:17:41.24,D,,0,0,0,,내가 저거 가지는 게 욕심이나?
Dialogue: 0,0:17:41.31,0:17:43.04,D,,0,0,0,,우리 거라고 생각했지
Dialogue: 0,0:17:43.11,0:17:46.20,D,,0,0,0,,니 거 아니면 다 내 거지
Dialogue: 0,0:17:46.27,0:17:48.34,D,,0,0,0,,그냥 사과할 생각은 없어
Dialogue: 0,0:17:48.41,0:17:50.07,D,,0,0,0,,실수했을 때는 하는 거 아이나?
Dialogue: 0,0:17:50.14,0:17:51.57,D,,0,0,0,,저도 사과는 안 하겠습니다
Dialogue: 0,0:17:51.65,0:17:52.81,N,,0,0,0,,두 사람의 오랜 의리는
Dialogue: 0,0:17:52.81,0:17:54.09,N,,0,0,0,,그렇게 끝이 납니다
Dialogue: 0,0:17:54.20,0:17:55.50,N,,0,0,0,,그사이 민석의 사람들은
Dialogue: 0,0:17:55.50,0:17:56.78,N,,0,0,0,,신사장 쪽 사무실을
Dialogue: 0,0:17:56.78,0:17:58.69,N,,0,0,0,,불바다로 만들어 버립니다
Dialogue: 0,0:18:01.15,0:18:02.37,N,,0,0,0,,피투성이가 된 사무실
Dialogue: 0,0:18:02.37,0:18:04.25,N,,0,0,0,,사람에게 민석은 담담하게
Dialogue: 0,0:18:04.25,0:18:05.23,N,,0,0,0,,말하죠
Dialogue: 0,0:18:05.23,0:18:06.49,N,,0,0,0,,사람은 그냥 시대를
Dialogue: 0,0:18:06.49,0:18:07.79,N,,0,0,0,,따라가는 것뿐이라고요
Dialogue: 0,0:18:07.84,0:18:10.30,D,,0,0,0,,왜서 여길 지옥으로 만들어
Dialogue: 0,0:18:10.37,0:18:12.70,D,,0,0,0,,사람은 그냥 따라가는 거고
Dialogue: 0,0:18:12.77,0:18:14.74,D,,0,0,0,,우리도 따라왔잖아
Dialogue: 0,0:18:14.74,0:18:16.24,D,,0,0,0,,너무 늦지 않게
Dialogue: 0,0:18:16.37,0:18:17.57,N,,0,0,0,,그때 방현이 들이닥쳐
Dialogue: 0,0:18:17.57,0:18:19.39,N,,0,0,0,,민석을 체포합니다
Dialogue: 0,0:18:19.39,0:18:20.92,N,,0,0,0,,살인 교사와 마약 혐의였죠
Dialogue: 0,0:18:20.97,0:18:23.90,D,,0,0,0,,살인교사 마약류 위반으로
Dialogue: 0,0:18:23.97,0:18:26.10,D,,0,0,0,,무슨 근거로 영장을 받았대?
Dialogue: 0,0:18:26.17,0:18:27.60,D,,0,0,0,,체포해
Dialogue: 0,0:18:27.67,0:18:29.87,D,,0,0,0,,계속 이래 살아왔나
Dialogue: 0,0:18:29.95,0:18:31.46,N,,0,0,0,,그런데 신사장의 진짜
Dialogue: 0,0:18:31.46,0:18:33.27,N,,0,0,0,,속셈은 따로 있었습니다
Dialogue: 0,0:18:33.47,0:18:34.90,D,,0,0,0,,아직 진행 중입니다
Dialogue: 0,0:18:34.97,0:18:36.53,D,,0,0,0,,김길석이도 죽는 거다
Dialogue: 0,0:18:36.60,0:18:38.60,D,,0,0,0,,너무 걱정 마십시오, 대표님
Dialogue: 0,0:18:38.73,0:18:40.77,N,,0,0,0,,민석이 죽는 순간 길석도
Dialogue: 0,0:18:40.77,0:18:42.09,N,,0,0,0,,함께 치울 생각이었던
Dialogue: 0,0:18:42.09,0:18:42.35,N,,0,0,0,,거죠
Dialogue: 0,0:18:42.40,0:18:44.90,D,,0,0,0,,다 계획대로 되고 있지 않습니까?
Dialogue: 0,0:18:44.97,0:18:47.30,D,,0,0,0,,보상이 적다고 생각한다고
Dialogue: 0,0:18:47.37,0:18:51.20,D,,0,0,0,,김 사장님이 자존심 버려 가면서
Dialogue: 0,0:18:51.27,0:18:53.46,D,,0,0,0,,이민석이는 널 믿었을 것 같아?
Dialogue: 0,0:18:53.53,0:18:56.36,D,,0,0,0,,슬슬 정리하고 합류하시죠
Dialogue: 0,0:18:56.49,0:18:57.71,N,,0,0,0,,붙잡힌 민석은 방현에게
Dialogue: 0,0:18:57.71,0:18:59.87,N,,0,0,0,,전쟁은 결국 다시 벌어질
Dialogue: 0,0:18:59.87,0:19:00.72,N,,0,0,0,,거라고 말합니다
Dialogue: 0,0:19:00.77,0:19:03.60,D,,0,0,0,,날 잡아 두면 김길석이가
Dialogue: 0,0:19:03.67,0:19:06.10,D,,0,0,0,,어차피 또 전쟁은 벌어질 거야
Dialogue: 0,0:19:06.23,0:19:07.41,N,,0,0,0,,방현은 영장도 없이
Dialogue: 0,0:19:07.41,0:19:09.27,N,,0,0,0,,민석을 붙잡고 있었죠
Dialogue: 0,0:19:09.27,0:19:10.15,N,,0,0,0,,그리고 그를 노리는
Dialogue: 0,0:19:10.15,0:19:11.38,N,,0,0,0,,사내들이 몰려듭니다
Dialogue: 0,0:19:11.43,0:19:12.86,D,,0,0,0,,니 일은 뭐 하는데?
Dialogue: 0,0:19:12.93,0:19:14.63,D,,0,0,0,,영장이 나온 적이 없다던데
Dialogue: 0,0:19:14.70,0:19:17.93,D,,0,0,0,,여서 더 가면 나도 방법 없어
Dialogue: 0,0:19:18.00,0:19:21.03,D,,0,0,0,,죽이고 싶으면 우리 다 죽이고 해
Dialogue: 0,0:19:21.16,0:19:22.56,N,,0,0,0,,그때 길석이 나타나
Dialogue: 0,0:19:22.56,0:19:24.36,N,,0,0,0,,민석을 끌어냅니다
Dialogue: 0,0:19:24.36,0:19:25.56,N,,0,0,0,,그리고 뜻밖의 말을
Dialogue: 0,0:19:25.56,0:19:25.85,N,,0,0,0,,하죠
Dialogue: 0,0:19:25.90,0:19:29.73,D,,0,0,0,,넌 서울로 가, 다시는 오지 마
Dialogue: 0,0:19:29.80,0:19:33.63,D,,0,0,0,,지금은 니 살려 주는 거라고
Dialogue: 0,0:19:33.70,0:19:37.20,D,,0,0,0,,영장을 받은 적이 없단 소리네
Dialogue: 0,0:19:37.33,0:19:38.49,N,,0,0,0,,하지만 길 위에서 기다리고
Dialogue: 0,0:19:38.49,0:19:40.13,N,,0,0,0,,있던 건 신사장이 보낸
Dialogue: 0,0:19:40.13,0:19:41.08,N,,0,0,0,,사내들이었습니다
Dialogue: 0,0:19:41.13,0:19:42.56,D,,0,0,0,,니 가면 죽어
Dialogue: 0,0:19:42.63,0:19:44.46,D,,0,0,0,,어차피 죽어야 끝나니까
Dialogue: 0,0:19:44.53,0:19:46.36,D,,0,0,0,,내 친구는 좀 살리자고
Dialogue: 0,0:19:46.43,0:19:48.26,D,,0,0,0,,니 친구도 마찬가지야
Dialogue: 0,0:19:48.39,0:19:49.65,N,,0,0,0,,어둠 속 가로수길
Dialogue: 0,0:19:49.65,0:19:51.35,N,,0,0,0,,길석은 몰려든 사내들과
Dialogue: 0,0:19:51.35,0:19:52.28,N,,0,0,0,,홀로 맞섭니다
Dialogue: 0,0:19:54.74,0:19:55.51,N,,0,0,0,,칼과 칼이 부딪히는
Dialogue: 0,0:19:55.51,0:19:57.63,N,,0,0,0,,처절한 싸움 끝에, 길 위엔
Dialogue: 0,0:19:57.63,0:19:59.32,N,,0,0,0,,쓰러진 사내들만 남았죠
Dialogue: 0,0:20:01.92,0:20:03.00,N,,0,0,0,,그리고 피를 흘리며
Dialogue: 0,0:20:03.00,0:20:04.20,N,,0,0,0,,쓰러진 민석
Dialogue: 0,0:20:04.20,0:20:04.96,N,,0,0,0,,길석이 묻습니다
Dialogue: 0,0:20:04.96,0:20:05.88,N,,0,0,0,,억울하냐고요
Dialogue: 0,0:20:05.93,0:20:07.36,D,,0,0,0,,억울하나?
Dialogue: 0,0:20:07.43,0:20:09.53,D,,0,0,0,,이렇게 죽을 거 몰랐을까
Dialogue: 0,0:20:09.61,0:20:11.06,N,,0,0,0,,민석은 마지막까지 웃으며
Dialogue: 0,0:20:11.06,0:20:12.04,N,,0,0,0,,말합니다
Dialogue: 0,0:20:12.04,0:20:13.54,N,,0,0,0,,자기와 길석이 다른
Dialogue: 0,0:20:13.54,0:20:14.85,N,,0,0,0,,종류의 사람 같냐고요
Dialogue: 0,0:20:15.90,0:20:17.33,D,,0,0,0,,정말 웃겨
Dialogue: 0,0:20:17.40,0:20:20.39,D,,0,0,0,,너랑 다른 종류의 사람 같지?
Dialogue: 0,0:20:20.46,0:20:21.99,D,,0,0,0,,죽게 될 거니까
Dialogue: 0,0:20:22.12,0:20:23.10,N,,0,0,0,,모든 게 끝난 뒤
Dialogue: 0,0:20:23.10,0:20:25.48,N,,0,0,0,,방현이 길석 앞에 섭니다
Dialogue: 0,0:20:25.48,0:20:26.74,N,,0,0,0,,이제 와서 자기를 잡으려
Dialogue: 0,0:20:26.74,0:20:27.34,N,,0,0,0,,하냐는 길석
Dialogue: 0,0:20:27.39,0:20:29.32,D,,0,0,0,,날 잡아 놓을 거나?
Dialogue: 0,0:20:29.39,0:20:32.39,D,,0,0,0,,우리 형님들, 동생들
Dialogue: 0,0:20:32.46,0:20:34.66,D,,0,0,0,,다 죽어 나갈 때는 가만히 있다가
Dialogue: 0,0:20:34.79,0:20:35.97,N,,0,0,0,,네가 원한 게 진짜
Dialogue: 0,0:20:35.97,0:20:37.37,N,,0,0,0,,이거였냐는 방현의 물음에
Dialogue: 0,0:20:37.37,0:20:39.28,N,,0,0,0,,길석은 이렇게 답합니다
Dialogue: 0,0:20:39.33,0:20:40.79,D,,0,0,0,,다른 선택지가 있었나?
Dialogue: 0,0:20:40.86,0:20:42.69,D,,0,0,0,,낭만은 씨가 말랐다니
Dialogue: 0,0:20:42.82,0:20:44.02,N,,0,0,0,,얼마 뒤, 피 묻은
Dialogue: 0,0:20:44.02,0:20:45.38,N,,0,0,0,,셔츠의 길석은 홀로
Dialogue: 0,0:20:45.38,0:20:46.86,N,,0,0,0,,담배를 뭅니다
Dialogue: 0,0:20:46.86,0:20:47.84,N,,0,0,0,,그가 꿈꾸던 낭만은
Dialogue: 0,0:20:47.84,0:20:49.11,N,,0,0,0,,그렇게 저물었죠
Dialogue: 0,0:20:49.22,0:20:50.72,N,,0,0,0,,이제 이 작품을 조금 더
Dialogue: 0,0:20:50.72,0:20:51.52,N,,0,0,0,,들여다볼까요
Dialogue: 0,0:20:51.52,0:20:53.12,N,,0,0,0,,이 영화는 2021년
Dialogue: 0,0:20:53.12,0:20:54.44,N,,0,0,0,,극장에서 개봉한 한국
Dialogue: 0,0:20:54.44,0:20:56.04,N,,0,0,0,,범죄 누아르로, 유오성
Dialogue: 0,0:20:56.04,0:20:57.26,N,,0,0,0,,배우와 장혁 배우가
Dialogue: 0,0:20:57.26,0:20:58.04,N,,0,0,0,,맞붙었습니다
Dialogue: 0,0:20:58.15,0:20:59.81,N,,0,0,0,,겉으로는 리조트를 둘러싼
Dialogue: 0,0:20:59.81,0:21:01.11,N,,0,0,0,,조직 간의 전쟁이지만
Dialogue: 0,0:21:01.11,0:21:02.91,N,,0,0,0,,그 밑에는 사라져 가는
Dialogue: 0,0:21:02.91,0:21:04.11,N,,0,0,0,,낭만에 대한 이야기가
Dialogue: 0,0:21:04.11,0:21:04.74,N,,0,0,0,,깔려 있죠
Dialogue: 0,0:21:04.85,0:21:06.31,N,,0,0,0,,돈과 속도로 밀고 들어오는
Dialogue: 0,0:21:06.31,0:21:07.27,N,,0,0,0,,새로운 세대 앞에서
Dialogue: 0,0:21:07.27,0:21:09.75,N,,0,0,0,,의리를 붙잡고 버티던 옛 건달의
Dialogue: 0,0:21:09.75,0:21:11.37,N,,0,0,0,,시대가 어떻게 저무는지를
Dialogue: 0,0:21:11.37,0:21:11.94,N,,0,0,0,,보여 줍니다
Dialogue: 0,0:21:12.05,0:21:13.55,N,,0,0,0,,동해 바다와 호숫가
Dialogue: 0,0:21:13.55,0:21:15.17,N,,0,0,0,,새벽 어시장 같은 바닷가
Dialogue: 0,0:21:15.17,0:21:16.67,N,,0,0,0,,도시의 풍경을 차갑고
Dialogue: 0,0:21:16.67,0:21:17.81,N,,0,0,0,,푸른 색감으로 담아낸
Dialogue: 0,0:21:17.81,0:21:19.14,N,,0,0,0,,화면도 인상적입니다
Dialogue: 0,0:21:19.25,0:21:20.29,N,,0,0,0,,후반부 가로수길에서
Dialogue: 0,0:21:20.29,0:21:22.05,N,,0,0,0,,벌어지는 칼싸움은 어둡고
Dialogue: 0,0:21:22.05,0:21:23.77,N,,0,0,0,,처절한 분위기로 긴장감을
Dialogue: 0,0:21:23.77,0:21:24.94,N,,0,0,0,,끝까지 끌어올리죠
Dialogue: 0,0:21:25.05,0:21:26.71,N,,0,0,0,,묵직하게 중심을 잡는
Dialogue: 0,0:21:26.71,0:21:28.47,N,,0,0,0,,유오성 배우와, 웃는
Dialogue: 0,0:21:28.47,0:21:30.37,N,,0,0,0,,얼굴로 섬뜩함을 뿜어내는
Dialogue: 0,0:21:30.37,0:21:31.73,N,,0,0,0,,장혁 배우의 대결이
Dialogue: 0,0:21:31.73,0:21:32.84,N,,0,0,0,,가장 큰 볼거리입니다
Dialogue: 0,0:21:32.95,0:21:35.11,N,,0,0,0,,박성근, 오대환, 이채영
Dialogue: 0,0:21:35.11,0:21:37.11,N,,0,0,0,,배우 등 조연들의 존재감도
Dialogue: 0,0:21:37.11,0:21:38.34,N,,0,0,0,,이야기에 무게를 더해
Dialogue: 0,0:21:38.34,0:21:38.74,N,,0,0,0,,줍니다
Dialogue: 0,0:21:38.85,0:21:40.21,N,,0,0,0,,정통 조폭 누아르의
Dialogue: 0,0:21:40.21,0:21:41.64,N,,0,0,0,,묵직한 맛을 좋아하시는
Dialogue: 0,0:21:41.64,0:21:43.69,N,,0,0,0,,분들께 자신 있게 추천드릴 수
Dialogue: 0,0:21:43.69,0:21:43.95,N,,0,0,0,,있는
Dialogue: 0,0:21:43.95,0:21:44.63,N,,0,0,0,,작품입니다
Dialogue: 0,0:21:44.74,0:21:45.80,N,,0,0,0,,오늘 소개한 장면들은
Dialogue: 0,0:21:45.80,0:21:47.80,N,,0,0,0,,일부일 뿐이니, OTT나
Dialogue: 0,0:21:47.80,0:21:49.40,N,,0,0,0,,VOD에서 꼭 한번
Dialogue: 0,0:21:49.40,0:21:50.73,N,,0,0,0,,정주행해 보시길 추천드려요
Dialogue: 0,0:21:50.84,0:21:52.64,N,,0,0,0,,오늘 영상은 여기까지입니다
Dialogue: 0,0:21:52.64,0:21:54.32,N,,0,0,0,,재미있게 보셨다면 구독과
Dialogue: 0,0:21:54.32,0:21:55.60,N,,0,0,0,,좋아요 부탁드려요
