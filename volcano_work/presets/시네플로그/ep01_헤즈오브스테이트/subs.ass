Dialogue: 0,0:00:00.00,0:28:39.69,TOP,,0,0,0,,CINEFLOG
Dialogue: 0,0:00:00.06,0:00:02.14,N,,0,0,0,,미국 대통령과 영국 총리가
Dialogue: 0,0:00:02.14,0:00:03.62,N,,0,0,0,,하필이면 세상에서 서로를
Dialogue: 0,0:00:03.62,0:00:05.26,N,,0,0,0,,제일 싫어하는 사이라면 무슨
Dialogue: 0,0:00:05.26,0:00:06.20,N,,0,0,0,,일이 벌어질까요?
Dialogue: 0,0:00:06.26,0:00:07.62,N,,0,0,0,,그런데 그 두 사람이 함께
Dialogue: 0,0:00:07.62,0:00:09.06,N,,0,0,0,,탄 에어포스원이 하늘에서
Dialogue: 0,0:00:09.06,0:00:10.74,N,,0,0,0,,공격을 받고, 온 세상은
Dialogue: 0,0:00:10.74,0:00:12.34,N,,0,0,0,,두 정상이 죽었다고 믿게
Dialogue: 0,0:00:12.34,0:00:12.96,N,,0,0,0,,됩니다
Dialogue: 0,0:00:13.02,0:00:14.90,N,,0,0,0,,살아남은 건 서로 으르렁대는
Dialogue: 0,0:00:14.90,0:00:15.83,N,,0,0,0,,두 남자뿐
Dialogue: 0,0:00:16.01,0:00:18.17,N,,0,0,0,,적진 한복판에서, 둘은 과연
Dialogue: 0,0:00:18.17,0:00:19.51,N,,0,0,0,,무사히 집으로 돌아갈 수
Dialogue: 0,0:00:19.51,0:00:20.29,N,,0,0,0,,있을까요?
Dialogue: 0,0:00:20.35,0:00:21.87,N,,0,0,0,,오늘 소개할 영화는 아마존
Dialogue: 0,0:00:21.87,0:00:24.22,N,,0,0,0,,프라임 비디오의 액션 코미디입니다
Dialogue: 0,0:00:24.27,0:00:26.31,D,,0,0,0,,뒤쪽에 낙하산이 있어요!
Dialogue: 0,0:00:26.51,0:00:28.31,N,,0,0,0,,존 시나와 이드리스 엘바가
Dialogue: 0,0:00:28.31,0:00:30.15,N,,0,0,0,,앙숙 대통령과 총리로 만난
Dialogue: 0,0:00:30.15,0:00:32.15,N,,0,0,0,,좌충우돌 생존기, 지금부터
Dialogue: 0,0:00:32.15,0:00:33.03,N,,0,0,0,,시작해 볼게요
Dialogue: 0,0:00:33.09,0:00:34.57,N,,0,0,0,,이야기는 스페인의 토마토
Dialogue: 0,0:00:34.57,0:00:35.97,N,,0,0,0,,축제에서 시작됩니다
Dialogue: 0,0:00:36.02,0:00:39.28,D,,0,0,0,,아이고, 아프겠다.
Dialogue: 0,0:00:39.44,0:00:41.12,N,,0,0,0,,해마다 무려 140톤이 넘는
Dialogue: 0,0:00:41.12,0:00:42.69,N,,0,0,0,,토마토를 서로에게 던지는
Dialogue: 0,0:00:42.69,0:00:44.56,N,,0,0,0,,세계 최대의 음식 싸움이죠
Dialogue: 0,0:00:44.62,0:00:46.73,N,,0,0,0,,그런데 이 난장판 한가운데서
Dialogue: 0,0:00:46.73,0:00:48.68,N,,0,0,0,,영국 정보기관 엠아이식스와
Dialogue: 0,0:00:48.68,0:00:50.41,N,,0,0,0,,미국 씨아이에이가 손을 잡고
Dialogue: 0,0:00:50.41,0:00:51.94,N,,0,0,0,,비밀 작전을 펼치고 있습니다
Dialogue: 0,0:00:51.99,0:00:53.82,D,,0,0,0,,지금 작전 중인 건 알죠?
Dialogue: 0,0:00:54.06,0:00:55.70,N,,0,0,0,,방송 기자로 위장한 여자가
Dialogue: 0,0:00:55.70,0:00:57.54,N,,0,0,0,,농담을 던지자, 동료는 지금
Dialogue: 0,0:00:57.54,0:00:59.43,N,,0,0,0,,작전 중이라며 핀잔을 주죠
Dialogue: 0,0:00:59.48,0:01:00.85,D,,0,0,0,,본부, 상황 알려 줘.
Dialogue: 0,0:01:00.93,0:01:02.93,N,,0,0,0,,이 여자가 바로 작전을 이끄는
Dialogue: 0,0:01:02.93,0:01:04.37,N,,0,0,0,,엠아이식스의 베테랑 요원
Dialogue: 0,0:01:04.37,0:01:05.60,N,,0,0,0,,노엘 비셋입니다
Dialogue: 0,0:01:05.65,0:01:08.55,D,,0,0,0,,목표물 인상착의와 일치해.
Dialogue: 0,0:01:08.75,0:01:10.70,N,,0,0,0,,목표는 러시아 출신 무기상
Dialogue: 0,0:01:10.70,0:01:11.67,N,,0,0,0,,빅토르 그라도프
Dialogue: 0,0:01:11.81,0:01:13.36,N,,0,0,0,,무려 2년 만에 처음으로
Dialogue: 0,0:01:13.36,0:01:14.92,N,,0,0,0,,모습을 드러낸 거물이죠
Dialogue: 0,0:01:14.98,0:01:16.26,N,,0,0,0,,그런데 이상합니다
Dialogue: 0,0:01:16.26,0:01:17.86,N,,0,0,0,,회색 모자에 분홍 셔츠
Dialogue: 0,0:01:17.86,0:01:19.58,N,,0,0,0,,그라도프와 똑같이 차려입은
Dialogue: 0,0:01:19.58,0:01:21.34,N,,0,0,0,,남자가 한 명, 두 명
Dialogue: 0,0:01:21.34,0:01:21.92,N,,0,0,0,,세 명
Dialogue: 0,0:01:21.97,0:01:23.70,D,,0,0,0,,미끼를 풀었어.
Dialogue: 0,0:01:23.78,0:01:25.70,N,,0,0,0,,얼굴 인식도 먹히지 않습니다
Dialogue: 0,0:01:25.70,0:01:27.22,N,,0,0,0,,마치 카메라 위치를 전부
Dialogue: 0,0:01:27.22,0:01:28.32,N,,0,0,0,,알고 있다는 듯이요
Dialogue: 0,0:01:28.37,0:01:30.06,D,,0,0,0,,걸음걸이 분석 돌려.
Dialogue: 0,0:01:30.26,0:01:32.06,N,,0,0,0,,결국 요원들은 최후의 수단을
Dialogue: 0,0:01:32.06,0:01:32.85,N,,0,0,0,,꺼내 듭니다
Dialogue: 0,0:01:33.02,0:01:34.87,N,,0,0,0,,세상 모든 통신을 감시하는
Dialogue: 0,0:01:34.87,0:01:36.98,N,,0,0,0,,극비 시스템, 에셜론이죠
Dialogue: 0,0:01:37.04,0:01:38.72,N,,0,0,0,,에셜론의 걸음걸이 분석으로
Dialogue: 0,0:01:38.72,0:01:40.65,N,,0,0,0,,진짜 그라도프를 찾아낸 요원들
Dialogue: 0,0:01:40.70,0:01:41.76,D,,0,0,0,,얼마나 거물인데?
Dialogue: 0,0:01:41.94,0:01:43.52,N,,0,0,0,,하지만 기뻐할 틈도 없이
Dialogue: 0,0:01:43.52,0:01:45.04,N,,0,0,0,,그건 그라도프가 미리 짜
Dialogue: 0,0:01:45.04,0:01:46.45,N,,0,0,0,,둔 판이었다는 게 드러납니다
Dialogue: 0,0:01:46.51,0:01:48.51,N,,0,0,0,,매복해 있던 적들의 공격에
Dialogue: 0,0:01:48.51,0:01:50.19,N,,0,0,0,,요원들은 하나둘 쓰러지고
Dialogue: 0,0:01:50.19,0:01:52.79,N,,0,0,0,,노엘은 붉게 물든 광장 한가운데서
Dialogue: 0,0:01:52.79,0:01:54.60,N,,0,0,0,,적과 정면으로 맞붙습니다
Dialogue: 0,0:01:54.65,0:01:56.11,D,,0,0,0,,움직이지 마.
Dialogue: 0,0:01:56.31,0:01:57.95,N,,0,0,0,,토마토 범벅이 된 계단 위에서
Dialogue: 0,0:01:57.95,0:02:00.03,N,,0,0,0,,벌어지는 이 격투, 첫 장면부터
Dialogue: 0,0:02:00.03,0:02:00.89,N,,0,0,0,,꽤 화끈하죠
Dialogue: 0,0:02:00.95,0:02:03.07,N,,0,0,0,,하지만 결국 작전은 처참하게
Dialogue: 0,0:02:03.07,0:02:03.89,N,,0,0,0,,실패합니다
Dialogue: 0,0:02:04.07,0:02:05.95,N,,0,0,0,,요원 일곱 명이 목숨을 잃고
Dialogue: 0,0:02:05.95,0:02:07.55,N,,0,0,0,,노엘은 실종되고 말죠
Dialogue: 0,0:02:07.67,0:02:09.17,N,,0,0,0,,그리고 이 실패가, 앞으로
Dialogue: 0,0:02:09.17,0:02:11.15,N,,0,0,0,,벌어질 거대한 사건의 신호탄이
Dialogue: 0,0:02:11.15,0:02:11.69,N,,0,0,0,,됩니다
Dialogue: 0,0:02:11.75,0:02:13.53,N,,0,0,0,,한편 미국에는 아주 특이한
Dialogue: 0,0:02:13.53,0:02:14.62,N,,0,0,0,,대통령이 있습니다
Dialogue: 0,0:02:14.67,0:02:16.06,D,,0,0,0,,누가 그랬니, 아들?
Dialogue: 0,0:02:16.30,0:02:18.09,N,,0,0,0,,액션 영화 워터 코브라 시리즈로
Dialogue: 0,0:02:18.09,0:02:19.50,N,,0,0,0,,세계 흥행 기록을 갈아 치운
Dialogue: 0,0:02:19.50,0:02:21.10,N,,0,0,0,,배우 출신, 윌 데린저
Dialogue: 0,0:02:21.10,0:02:22.98,N,,0,0,0,,청바지 입은 독사라는 별명까지
Dialogue: 0,0:02:22.98,0:02:23.32,N,,0,0,0,,있죠
Dialogue: 0,0:02:23.38,0:02:25.18,N,,0,0,0,,야구 영화로 골든글로브 후보에도
Dialogue: 0,0:02:25.18,0:02:27.14,N,,0,0,0,,올랐던 그는, 극장에서 해냈으니
Dialogue: 0,0:02:27.14,0:02:29.25,N,,0,0,0,,백악관에서도 해내겠다며 대통령
Dialogue: 0,0:02:29.25,0:02:30.64,N,,0,0,0,,선거까지 이겨 버립니다
Dialogue: 0,0:02:30.69,0:02:34.49,D,,0,0,0,,이제 백악관에서도 해내겠습니다.
Dialogue: 0,0:02:34.65,0:02:36.45,N,,0,0,0,,취임 다섯 달 만에 역대급
Dialogue: 0,0:02:36.45,0:02:37.95,N,,0,0,0,,지지율을 누리는, 그야말로
Dialogue: 0,0:02:37.95,0:02:38.97,N,,0,0,0,,스타 대통령이죠
Dialogue: 0,0:02:39.02,0:02:41.45,D,,0,0,0,,29일 목요일 브리핑입니다.
Dialogue: 0,0:02:41.53,0:02:43.17,N,,0,0,0,,윌 역을 맡은 배우는 존
Dialogue: 0,0:02:43.17,0:02:43.64,N,,0,0,0,,시나
Dialogue: 0,0:02:43.64,0:02:45.21,N,,0,0,0,,실제로도 레슬링 스타에서
Dialogue: 0,0:02:45.21,0:02:46.68,N,,0,0,0,,할리우드 배우가 된 사람이라
Dialogue: 0,0:02:46.68,0:02:48.30,N,,0,0,0,,인기 스타 출신 대통령이라는
Dialogue: 0,0:02:48.30,0:02:49.66,N,,0,0,0,,설정이 이보다 잘 어울릴
Dialogue: 0,0:02:49.66,0:02:50.54,N,,0,0,0,,수가 없습니다
Dialogue: 0,0:02:50.60,0:02:52.36,N,,0,0,0,,그리고 영국에는 정반대의
Dialogue: 0,0:02:52.36,0:02:53.41,N,,0,0,0,,총리가 있습니다
Dialogue: 0,0:02:53.46,0:02:56.06,D,,0,0,0,,요원들이 목숨을 잃었습니다.
Dialogue: 0,0:02:56.22,0:02:57.98,N,,0,0,0,,군인 출신으로 6년째 나라를
Dialogue: 0,0:02:57.98,0:02:59.48,N,,0,0,0,,이끌고 있는 샘 클라크
Dialogue: 0,0:02:59.66,0:03:01.66,N,,0,0,0,,성실하고 원칙적이지만 지지율은
Dialogue: 0,0:03:01.66,0:03:03.14,N,,0,0,0,,바닥이고, 웃는 법도 잘
Dialogue: 0,0:03:03.14,0:03:04.10,N,,0,0,0,,모르는 사람이죠
Dialogue: 0,0:03:04.10,0:03:05.67,N,,0,0,0,,이드리스 엘바가 연기합니다
Dialogue: 0,0:03:05.73,0:03:07.53,N,,0,0,0,,아침 보고에서 샘은 스페인
Dialogue: 0,0:03:07.53,0:03:09.24,N,,0,0,0,,작전의 비극을 듣게 됩니다
Dialogue: 0,0:03:09.29,0:03:11.25,D,,0,0,0,,정말 유감입니다.
Dialogue: 0,0:03:11.45,0:03:13.25,N,,0,0,0,,실종된 팀장 노엘은 샘의
Dialogue: 0,0:03:13.25,0:03:15.57,N,,0,0,0,,오랜 동료이자 옛 연인이었어요
Dialogue: 0,0:03:15.62,0:03:16.45,D,,0,0,0,,지금 연방 수사 중이야.
Dialogue: 0,0:03:16.64,0:03:18.13,N,,0,0,0,,그녀가 죽었을지도 모른다는
Dialogue: 0,0:03:18.13,0:03:19.69,N,,0,0,0,,말에, 샘의 표정이 굳어
Dialogue: 0,0:03:19.69,0:03:20.45,N,,0,0,0,,버립니다
Dialogue: 0,0:03:20.51,0:03:22.30,N,,0,0,0,,윌은 가족과 함께 런던을
Dialogue: 0,0:03:22.30,0:03:23.32,N,,0,0,0,,방문 중입니다
Dialogue: 0,0:03:23.37,0:03:26.53,D,,0,0,0,,토네이도 말고, 나토.
Dialogue: 0,0:03:26.69,0:03:28.65,N,,0,0,0,,딸에게 나토가 뭔지 설명하느라
Dialogue: 0,0:03:28.65,0:03:30.56,N,,0,0,0,,진땀을 빼고, 퍼스트레이디는
Dialogue: 0,0:03:30.56,0:03:32.17,N,,0,0,0,,이번 기회에 영국 총리와
Dialogue: 0,0:03:32.17,0:03:33.81,N,,0,0,0,,좀 친해져 보라고 당부하죠
Dialogue: 0,0:03:33.86,0:03:35.39,D,,0,0,0,,케임브리지 강연은 몇 시야?
Dialogue: 0,0:03:35.47,0:03:37.87,N,,0,0,0,,그런데 윌은 샘이 영 못마땅합니다
Dialogue: 0,0:03:37.87,0:03:39.83,N,,0,0,0,,이유를 들어 보면 황당하게도
Dialogue: 0,0:03:39.83,0:03:41.41,N,,0,0,0,,피시 앤 칩스 때문이에요
Dialogue: 0,0:03:41.46,0:03:44.30,D,,0,0,0,,그냥 점심이 아니었어. 피시 앤 칩스였다고.
Dialogue: 0,0:03:44.38,0:03:45.98,N,,0,0,0,,선거 운동이 한창일 때
Dialogue: 0,0:03:45.98,0:03:47.50,N,,0,0,0,,샘이 윌의 상대 후보와 함께
Dialogue: 0,0:03:47.50,0:03:49.10,N,,0,0,0,,피시 앤 칩스를 먹는 사진이
Dialogue: 0,0:03:49.10,0:03:49.82,N,,0,0,0,,찍혔거든요
Dialogue: 0,0:03:49.87,0:03:50.91,D,,0,0,0,,날 존중하지 않아.
Dialogue: 0,0:03:51.15,0:03:52.99,N,,0,0,0,,윌은 그게 사실상 상대 후보를
Dialogue: 0,0:03:52.99,0:03:54.31,N,,0,0,0,,지지한 거라며, 두고두고
Dialogue: 0,0:03:54.31,0:03:55.07,N,,0,0,0,,서운해합니다
Dialogue: 0,0:03:55.12,0:03:57.76,D,,0,0,0,,8천3백만 표를 받은 사람이라고.
Dialogue: 0,0:03:57.92,0:03:59.88,N,,0,0,0,,8천3백만 표를 받은 사람이
Dialogue: 0,0:03:59.88,0:04:01.33,N,,0,0,0,,존중을 못 받는다나요
Dialogue: 0,0:04:01.38,0:04:03.01,D,,0,0,0,,연설문은 봤어요?
Dialogue: 0,0:04:03.09,0:04:05.65,N,,0,0,0,,샘 쪽 참모들도 걱정이 태산입니다
Dialogue: 0,0:04:05.65,0:04:07.25,N,,0,0,0,,스페인 작전 실패로 여론이
Dialogue: 0,0:04:07.25,0:04:09.25,N,,0,0,0,,험악한데, 대통령이 대본을
Dialogue: 0,0:04:09.25,0:04:10.85,N,,0,0,0,,벗어나 폭탄 발언이라도 할까
Dialogue: 0,0:04:10.85,0:04:11.43,N,,0,0,0,,봐서요
Dialogue: 0,0:04:11.48,0:04:12.65,D,,0,0,0,,목표가 누구였죠?
Dialogue: 0,0:04:12.83,0:04:14.78,N,,0,0,0,,기자회견이랑 영화 홍보 행사를
Dialogue: 0,0:04:14.78,0:04:16.49,N,,0,0,0,,아직도 구분 못 한다는 말까지
Dialogue: 0,0:04:16.49,0:04:17.13,N,,0,0,0,,나오죠
Dialogue: 0,0:04:17.18,0:04:19.58,D,,0,0,0,,행방불명입니다.
Dialogue: 0,0:04:19.65,0:04:21.64,D,,0,0,0,,드디어 만나네요.
Dialogue: 0,0:04:21.72,0:04:23.84,N,,0,0,0,,드디어 런던에서 두 정상의
Dialogue: 0,0:04:23.84,0:04:25.62,N,,0,0,0,,첫 공동 기자회견이 열립니다
Dialogue: 0,0:04:25.67,0:04:27.77,D,,0,0,0,,내가 에미넴이라고?
Dialogue: 0,0:04:27.96,0:04:29.65,N,,0,0,0,,만나자마자 윌은 이게 우리
Dialogue: 0,0:04:29.65,0:04:31.29,N,,0,0,0,,첫 듀엣 무대라며, 자기가
Dialogue: 0,0:04:31.29,0:04:32.97,N,,0,0,0,,닥터 드레, 샘이 에미넴이라고
Dialogue: 0,0:04:32.97,0:04:34.41,N,,0,0,0,,분위기를 띄우지만, 샘은
Dialogue: 0,0:04:34.41,0:04:35.45,N,,0,0,0,,영 시큰둥하죠
Dialogue: 0,0:04:35.50,0:04:36.94,D,,0,0,0,,그랬겠죠.
Dialogue: 0,0:04:37.02,0:04:38.62,N,,0,0,0,,같이 호흡 연습이라도 하자는
Dialogue: 0,0:04:38.62,0:04:40.38,N,,0,0,0,,윌에게 샘은 이미 숨 잘
Dialogue: 0,0:04:40.38,0:04:41.76,N,,0,0,0,,쉬고 있다며 받아칩니다
Dialogue: 0,0:04:41.81,0:04:43.34,D,,0,0,0,,숨은 이미 잘 쉬고 있어요.
Dialogue: 0,0:04:43.50,0:04:45.10,N,,0,0,0,,그리고 부탁은 딱 하나
Dialogue: 0,0:04:45.10,0:04:46.94,N,,0,0,0,,스페인 얘기는 피하고, 까다로운
Dialogue: 0,0:04:46.94,0:04:48.42,N,,0,0,0,,기자 잭 고든에게는 질문
Dialogue: 0,0:04:48.42,0:04:50.16,N,,0,0,0,,기회를 주지 말라는 거였죠
Dialogue: 0,0:04:50.21,0:04:52.44,D,,0,0,0,,미루자고요? 언제로요?
Dialogue: 0,0:04:52.52,0:04:53.98,N,,0,0,0,,회견의 주제는 두 나라가
Dialogue: 0,0:04:53.98,0:04:56.04,N,,0,0,0,,함께 개발했다는 차세대 원자로
Dialogue: 0,0:04:56.04,0:04:57.06,N,,0,0,0,,페블 베드 기술
Dialogue: 0,0:04:57.11,0:05:00.47,D,,0,0,0,,에너지 안보가 곧 국가 안보입니다.
Dialogue: 0,0:05:00.63,0:05:02.11,N,,0,0,0,,이제 석유 때문에 러시아나
Dialogue: 0,0:05:02.11,0:05:03.38,N,,0,0,0,,사우디 눈치를 볼 필요가
Dialogue: 0,0:05:03.38,0:05:05.46,N,,0,0,0,,없다며, 둘은 제법 그럴듯하게
Dialogue: 0,0:05:05.46,0:05:06.53,N,,0,0,0,,발표를 이어 갑니다
Dialogue: 0,0:05:06.58,0:05:07.44,D,,0,0,0,,제 단골이죠.
Dialogue: 0,0:05:07.52,0:05:09.48,N,,0,0,0,,그런데 질문이 시작되자 분위기가
Dialogue: 0,0:05:09.48,0:05:10.57,N,,0,0,0,,달라집니다
Dialogue: 0,0:05:10.62,0:05:12.85,D,,0,0,0,,자, 제대로 된 질문 하실 분?
Dialogue: 0,0:05:13.17,0:05:15.05,N,,0,0,0,,윌에게는 워터 코브라 유니버스에
Dialogue: 0,0:05:15.05,0:05:16.37,N,,0,0,0,,카메오로 나오냐는 질문이
Dialogue: 0,0:05:16.37,0:05:18.13,N,,0,0,0,,오고, 샘에게는 전 여자
Dialogue: 0,0:05:18.13,0:05:19.81,N,,0,0,0,,친구의 열애설 같은 질문만
Dialogue: 0,0:05:19.81,0:05:20.46,N,,0,0,0,,쏟아지죠
Dialogue: 0,0:05:20.51,0:05:21.81,D,,0,0,0,,자, 질문 받겠습니다.
Dialogue: 0,0:05:21.89,0:05:23.68,N,,0,0,0,,윌은 한술 더 떠서, 총리를
Dialogue: 0,0:05:23.68,0:05:25.12,N,,0,0,0,,위한 연애 리얼리티 쇼라도
Dialogue: 0,0:05:25.12,0:05:26.70,N,,0,0,0,,만들자며 샘을 놀립니다
Dialogue: 0,0:05:26.75,0:05:27.74,D,,0,0,0,,다들 제 편이죠?
Dialogue: 0,0:05:27.90,0:05:29.26,N,,0,0,0,,그리고 보란 듯이, 샘이
Dialogue: 0,0:05:29.26,0:05:31.02,N,,0,0,0,,제발 피하라던 잭 고든을
Dialogue: 0,0:05:31.02,0:05:31.76,N,,0,0,0,,지목하죠
Dialogue: 0,0:05:31.81,0:05:34.51,D,,0,0,0,,카메오로 출연하실 생각은 있나요?
Dialogue: 0,0:05:34.59,0:05:36.59,N,,0,0,0,,잭은 곧장 스페인 작전 실패를
Dialogue: 0,0:05:36.59,0:05:37.39,N,,0,0,0,,캐묻습니다
Dialogue: 0,0:05:37.44,0:05:39.74,D,,0,0,0,,적들은 두려워해야 할 겁니다.
Dialogue: 0,0:05:40.14,0:05:41.82,N,,0,0,0,,샘은 비밀 작전은 비밀이라며
Dialogue: 0,0:05:41.82,0:05:43.83,N,,0,0,0,,선을 긋는데, 윌은 달랐습니다
Dialogue: 0,0:05:43.88,0:05:45.31,D,,0,0,0,,그 얘긴 여기까지 하죠.
Dialogue: 0,0:05:45.47,0:05:47.43,N,,0,0,0,,그라도프에게 반드시 대가를
Dialogue: 0,0:05:47.43,0:05:48.75,N,,0,0,0,,치르게 하겠다고 큰소리를
Dialogue: 0,0:05:48.75,0:05:49.13,N,,0,0,0,,치죠
Dialogue: 0,0:05:49.18,0:05:51.44,D,,0,0,0,,여러분은 마지막 자리에만 초대할게요.
Dialogue: 0,0:05:51.52,0:05:53.23,N,,0,0,0,,샘이 조용히 반성부터 하자고
Dialogue: 0,0:05:53.23,0:05:55.28,N,,0,0,0,,하면, 윌은 결과를 약속한다고
Dialogue: 0,0:05:55.28,0:05:56.26,N,,0,0,0,,맞받아칩니다
Dialogue: 0,0:05:56.31,0:05:58.54,D,,0,0,0,,더 잘할 겁니다.
Dialogue: 0,0:05:58.74,0:06:00.62,N,,0,0,0,,한 무대에 선 두 정상이
Dialogue: 0,0:06:00.62,0:06:02.22,N,,0,0,0,,정반대의 말만 하고 있는
Dialogue: 0,0:06:02.22,0:06:02.76,N,,0,0,0,,거죠
Dialogue: 0,0:06:02.81,0:06:04.34,D,,0,0,0,,네, 그렇긴 한데...
Dialogue: 0,0:06:04.42,0:06:06.30,N,,0,0,0,,그리고 잭은 결정타를 날립니다
Dialogue: 0,0:06:06.30,0:06:07.86,N,,0,0,0,,특수부대와 훈련을 받았다는
Dialogue: 0,0:06:07.86,0:06:09.26,N,,0,0,0,,윌에게, 그건 영화 찍을
Dialogue: 0,0:06:09.26,0:06:10.36,N,,0,0,0,,때 얘기 아니냐고요
Dialogue: 0,0:06:10.41,0:06:12.87,D,,0,0,0,,분명히 말하면, 실전은 못 겪어 보셨죠?
Dialogue: 0,0:06:12.95,0:06:14.55,N,,0,0,0,,배우 출신 대통령에게도
Dialogue: 0,0:06:14.55,0:06:16.21,N,,0,0,0,,정치인이 된 총리에게도
Dialogue: 0,0:06:16.21,0:06:17.94,N,,0,0,0,,진짜 영웅은 아니지 않냐는
Dialogue: 0,0:06:17.94,0:06:18.39,N,,0,0,0,,질문
Dialogue: 0,0:06:18.39,0:06:20.23,N,,0,0,0,,기자회견은 그야말로 대참사로
Dialogue: 0,0:06:20.23,0:06:20.79,N,,0,0,0,,끝나죠
Dialogue: 0,0:06:20.84,0:06:23.48,D,,0,0,0,,'싸우는 두 정상' 해시태그가 난리예요.
Dialogue: 0,0:06:23.56,0:06:25.20,N,,0,0,0,,회견장 뒤에서 두 사람은
Dialogue: 0,0:06:25.20,0:06:26.37,N,,0,0,0,,또 부딪힙니다
Dialogue: 0,0:06:26.42,0:06:28.61,D,,0,0,0,,당신 임기는 아직 기저귀 찬 수준이에요.
Dialogue: 0,0:06:28.93,0:06:30.89,N,,0,0,0,,샘은 윌이 모두에게 사랑받으려는
Dialogue: 0,0:06:30.89,0:06:32.45,N,,0,0,0,,강박이 있다고 쏘아붙이고
Dialogue: 0,0:06:32.45,0:06:33.97,N,,0,0,0,,윌은 샘의 바닥 지지율을
Dialogue: 0,0:06:33.97,0:06:34.43,N,,0,0,0,,꼬집죠
Dialogue: 0,0:06:34.48,0:06:35.58,D,,0,0,0,,내가 경고했잖아요.
Dialogue: 0,0:06:35.66,0:06:38.10,N,,0,0,0,,윌은 결국 참았던 말을 꺼냅니다
Dialogue: 0,0:06:38.10,0:06:39.74,N,,0,0,0,,혹시 이게 다 피시 앤 칩스
Dialogue: 0,0:06:39.74,0:06:40.60,N,,0,0,0,,때문이냐고요
Dialogue: 0,0:06:40.65,0:06:43.52,D,,0,0,0,,피시 앤 칩스 때문에 화난 거 아니거든요!
Dialogue: 0,0:06:43.76,0:06:45.16,N,,0,0,0,,샘은 그 망할 피시 앤 칩스
Dialogue: 0,0:06:45.16,0:06:46.96,N,,0,0,0,,얘기는 그만하라며 버럭 소리를
Dialogue: 0,0:06:46.96,0:06:47.47,N,,0,0,0,,지르죠
Dialogue: 0,0:06:47.52,0:06:49.36,D,,0,0,0,,난 내 싸움은 내가 해요.
Dialogue: 0,0:06:49.44,0:06:51.44,N,,0,0,0,,보좌진이 꺼낸 해결책은 하나
Dialogue: 0,0:06:51.44,0:06:53.04,N,,0,0,0,,두 사람이 에어포스원을 함께
Dialogue: 0,0:06:53.04,0:06:54.72,N,,0,0,0,,타고 가서, 트랩에서 사이좋게
Dialogue: 0,0:06:54.72,0:06:56.16,N,,0,0,0,,손 흔드는 사진을 전 세계
Dialogue: 0,0:06:56.16,0:06:58.18,N,,0,0,0,,신문 1면에 싣자는 거였어요
Dialogue: 0,0:06:58.23,0:07:01.66,D,,0,0,0,,두 분이 에어포스원을 같이 타는 거예요.
Dialogue: 0,0:07:01.74,0:07:03.42,N,,0,0,0,,이 아이디어를 낸 건 샘의
Dialogue: 0,0:07:03.42,0:07:05.34,N,,0,0,0,,오랜 친구이자 비서실장
Dialogue: 0,0:07:05.34,0:07:06.28,N,,0,0,0,,퀸시였습니다
Dialogue: 0,0:07:06.33,0:07:08.59,D,,0,0,0,,샘, 이기는 쪽을 택해요.
Dialogue: 0,0:07:08.91,0:07:10.23,N,,0,0,0,,윌은 무대를 누구와도 나눠
Dialogue: 0,0:07:10.23,0:07:11.67,N,,0,0,0,,쓰지 않는다며 버티지만
Dialogue: 0,0:07:11.67,0:07:13.31,N,,0,0,0,,지지율이 3퍼센트는 오른다는
Dialogue: 0,0:07:13.31,0:07:15.21,N,,0,0,0,,말에 결국 한발 물러서죠
Dialogue: 0,0:07:15.26,0:07:16.32,D,,0,0,0,,제 에어포스원에 함께 타 주시겠습니까?
Dialogue: 0,0:07:16.40,0:07:18.56,N,,0,0,0,,같은 시각, 어딘가에서 그라도프는
Dialogue: 0,0:07:18.56,0:07:19.88,N,,0,0,0,,스페인에서 저격에 실패한
Dialogue: 0,0:07:19.88,0:07:21.28,N,,0,0,0,,부하를 불러 앉힙니다
Dialogue: 0,0:07:21.28,0:07:23.34,N,,0,0,0,,그리고 어머니 이야기를 들려주죠
Dialogue: 0,0:07:23.39,0:07:25.12,D,,0,0,0,,장비 탓인 줄 알았지.
Dialogue: 0,0:07:25.20,0:07:27.04,N,,0,0,0,,찻잎으로 점을 보던 어머니가
Dialogue: 0,0:07:27.04,0:07:28.68,N,,0,0,0,,언젠가 자신이 큰 불의를
Dialogue: 0,0:07:28.68,0:07:30.36,N,,0,0,0,,당할 것이고 그걸 갚는 게
Dialogue: 0,0:07:30.36,0:07:31.71,N,,0,0,0,,평생의 사명이 될 거라고
Dialogue: 0,0:07:31.71,0:07:32.58,N,,0,0,0,,했다는 겁니다
Dialogue: 0,0:07:32.63,0:07:33.76,D,,0,0,0,,점쟁이였지.
Dialogue: 0,0:07:33.92,0:07:36.02,N,,0,0,0,,그리고 그 무엇도, 그 누구도
Dialogue: 0,0:07:36.02,0:07:37.68,N,,0,0,0,,자신을 막지 못할 거라고요
Dialogue: 0,0:07:37.68,0:07:39.53,N,,0,0,0,,이 남자, 뭔가 단단히 벼르고
Dialogue: 0,0:07:39.53,0:07:40.18,N,,0,0,0,,있습니다
Dialogue: 0,0:07:40.23,0:07:43.07,D,,0,0,0,,내가 큰 불의를 당할 거라고.
Dialogue: 0,0:07:43.15,0:07:44.87,N,,0,0,0,,영국 총리가 에어포스원에
Dialogue: 0,0:07:44.87,0:07:46.27,N,,0,0,0,,오르는 건 십수 년 만의
Dialogue: 0,0:07:46.27,0:07:46.59,N,,0,0,0,,일
Dialogue: 0,0:07:46.64,0:07:49.04,D,,0,0,0,,옆에 불꽃 그림은 왜 안 그리셨대요?
Dialogue: 0,0:07:49.24,0:07:51.20,N,,0,0,0,,막 출고된 새 에어포스원에서
Dialogue: 0,0:07:51.20,0:07:52.96,N,,0,0,0,,윌은 음속을 넘고 전투기처럼
Dialogue: 0,0:07:52.96,0:07:54.96,N,,0,0,0,,날렵하다며 자랑하기 바쁘고
Dialogue: 0,0:07:54.96,0:07:56.33,N,,0,0,0,,샘은 비꼬기 바쁩니다
Dialogue: 0,0:07:56.39,0:07:57.83,N,,0,0,0,,윌은 샘이 호밀 위스키를
Dialogue: 0,0:07:57.83,0:07:59.43,N,,0,0,0,,좋아한다는 걸 알고, 고향
Dialogue: 0,0:07:59.43,0:08:01.51,N,,0,0,0,,켄터키에서 온 술까지 대접합니다
Dialogue: 0,0:08:01.56,0:08:05.39,D,,0,0,0,,이게 바로 미국의 위대함이죠.
Dialogue: 0,0:08:05.47,0:08:07.55,N,,0,0,0,,딸과의 영상 통화에서도 윌은
Dialogue: 0,0:08:07.55,0:08:08.87,N,,0,0,0,,샘을 소개하며 친한 척을
Dialogue: 0,0:08:08.87,0:08:09.48,N,,0,0,0,,해 봅니다
Dialogue: 0,0:08:09.53,0:08:11.23,D,,0,0,0,,그냥 샘이라고 불러요.
Dialogue: 0,0:08:11.39,0:08:13.07,N,,0,0,0,,해리 스타일스랑 절친이라며
Dialogue: 0,0:08:13.07,0:08:14.35,N,,0,0,0,,다음에 좋은 자리를 구해
Dialogue: 0,0:08:14.35,0:08:15.71,N,,0,0,0,,줄지도 모른다고요
Dialogue: 0,0:08:15.76,0:08:19.66,D,,0,0,0,,저기 왔네.
Dialogue: 0,0:08:19.74,0:08:21.38,N,,0,0,0,,그 모습을 본 샘은, 윌에게
Dialogue: 0,0:08:21.38,0:08:23.10,N,,0,0,0,,의외로 평범한 구석이 있다고
Dialogue: 0,0:08:23.10,0:08:23.74,N,,0,0,0,,칭찬합니다
Dialogue: 0,0:08:23.79,0:08:25.13,D,,0,0,0,,평범한 사람 같아서요.
Dialogue: 0,0:08:25.21,0:08:27.05,N,,0,0,0,,그러자 윌은 기다렸다는 듯이
Dialogue: 0,0:08:27.05,0:08:28.02,N,,0,0,0,,훈수를 둡니다
Dialogue: 0,0:08:28.07,0:08:30.00,D,,0,0,0,,무슨 상상을 하는데요?
Dialogue: 0,0:08:30.32,0:08:32.08,N,,0,0,0,,샘도 결혼이라도 해서 이미지를
Dialogue: 0,0:08:32.08,0:08:33.12,N,,0,0,0,,부드럽게 하라고요
Dialogue: 0,0:08:33.17,0:08:34.83,D,,0,0,0,,당신 영화는 본 적도 없어요.
Dialogue: 0,0:08:35.03,0:08:36.51,N,,0,0,0,,독신이면 사람들이 이상한
Dialogue: 0,0:08:36.51,0:08:37.62,N,,0,0,0,,상상을 한다나요
Dialogue: 0,0:08:37.67,0:08:38.93,D,,0,0,0,,독신 딱지 좀 떼요.
Dialogue: 0,0:08:39.25,0:08:40.85,N,,0,0,0,,샘은 이게 조언이냐, 당신
Dialogue: 0,0:08:40.85,0:08:42.26,N,,0,0,0,,로맨틱 코미디 대본이냐며
Dialogue: 0,0:08:42.26,0:08:44.25,N,,0,0,0,,받아치고, 급기야 폭탄 발언을
Dialogue: 0,0:08:44.25,0:08:44.63,N,,0,0,0,,합니다
Dialogue: 0,0:08:44.68,0:08:48.18,D,,0,0,0,,당연하죠. 저 정통 연기 배웠어요.
Dialogue: 0,0:08:48.26,0:08:49.82,N,,0,0,0,,윌은 자기도 사실 제대로
Dialogue: 0,0:08:49.82,0:08:51.93,N,,0,0,0,,연기를 배운 배우라며 발끈합니다
Dialogue: 0,0:08:51.98,0:08:53.01,D,,0,0,0,,장난감 총이겠죠.
Dialogue: 0,0:08:53.21,0:08:55.17,N,,0,0,0,,봉준호, 웨스 앤더슨 감독과도
Dialogue: 0,0:08:55.17,0:08:56.11,N,,0,0,0,,일하고 싶다고요
Dialogue: 0,0:08:56.16,0:09:00.05,D,,0,0,0,,대체 왜 그래요?
Dialogue: 0,0:09:00.21,0:09:01.92,N,,0,0,0,,그런데 세상이 자꾸 총 든
Dialogue: 0,0:09:01.92,0:09:03.25,N,,0,0,0,,모습이 멋있다고 한다나요
Dialogue: 0,0:09:03.30,0:09:05.57,D,,0,0,0,,이제 보니 당신 문제네.
Dialogue: 0,0:09:05.65,0:09:07.22,N,,0,0,0,,윌은 사람들에게 희망을 주는
Dialogue: 0,0:09:07.22,0:09:09.19,N,,0,0,0,,것도 대통령의 일이라고 말합니다
Dialogue: 0,0:09:09.24,0:09:10.98,D,,0,0,0,,희망이 밥을 먹여 주진 않아요.
Dialogue: 0,0:09:11.16,0:09:13.06,N,,0,0,0,,하지만 샘은 희망이란 미뤄진
Dialogue: 0,0:09:13.06,0:09:14.58,N,,0,0,0,,실망일 뿐이고, 밥을 먹여
Dialogue: 0,0:09:14.58,0:09:16.10,N,,0,0,0,,주지도 지붕을 얹어 주지도
Dialogue: 0,0:09:16.10,0:09:17.39,N,,0,0,0,,않는다고 선을 긋죠
Dialogue: 0,0:09:17.44,0:09:18.44,D,,0,0,0,,그러셔요, 예언자 양반.
Dialogue: 0,0:09:18.60,0:09:20.84,N,,0,0,0,,두 사람은 정치를 보는 눈부터가
Dialogue: 0,0:09:20.84,0:09:22.01,N,,0,0,0,,완전히 다른 겁니다
Dialogue: 0,0:09:22.07,0:09:24.47,N,,0,0,0,,결국 쌓였던 감정이 폭발합니다
Dialogue: 0,0:09:24.47,0:09:26.02,N,,0,0,0,,윌은 피시 앤 칩스 이야기를
Dialogue: 0,0:09:26.02,0:09:27.75,N,,0,0,0,,다시 꺼내고, 샘은 가난한
Dialogue: 0,0:09:27.75,0:09:28.95,N,,0,0,0,,동네에서 태어나 일을 세
Dialogue: 0,0:09:28.95,0:09:30.35,N,,0,0,0,,개씩 하며 대학을 다니고
Dialogue: 0,0:09:30.35,0:09:31.80,N,,0,0,0,,군대와 지역 활동을 거쳐
Dialogue: 0,0:09:31.80,0:09:33.47,N,,0,0,0,,여기까지 왔다고 받아치죠
Dialogue: 0,0:09:33.52,0:09:34.42,D,,0,0,0,,점심 한 번 산 거예요.
Dialogue: 0,0:09:34.50,0:09:36.66,N,,0,0,0,,그리고 윌을 향해 퍼붓습니다
Dialogue: 0,0:09:36.66,0:09:38.58,N,,0,0,0,,속옷 모델에서 레드카펫으로
Dialogue: 0,0:09:38.58,0:09:39.86,N,,0,0,0,,그리고 하루도 공직을 해
Dialogue: 0,0:09:39.86,0:09:41.62,N,,0,0,0,,본 적 없이 핵 버튼 앞까지
Dialogue: 0,0:09:41.62,0:09:42.12,N,,0,0,0,,왔다고
Dialogue: 0,0:09:42.17,0:09:43.31,D,,0,0,0,,들은 그대로요.
Dialogue: 0,0:09:43.52,0:09:45.19,N,,0,0,0,,당신은 대사는 외웠지만
Dialogue: 0,0:09:45.19,0:09:47.28,N,,0,0,0,,대통령 역할이 믿기지 않는다고요
Dialogue: 0,0:09:47.33,0:09:49.30,D,,0,0,0,,결국 속마음이 나오네.
Dialogue: 0,0:09:49.38,0:09:51.30,N,,0,0,0,,그런데 바로 그 순간, 정체를
Dialogue: 0,0:09:51.30,0:09:53.22,N,,0,0,0,,알 수 없는 비행체가 에어포스원에
Dialogue: 0,0:09:53.22,0:09:53.92,N,,0,0,0,,다가옵니다
Dialogue: 0,0:09:53.97,0:09:55.23,D,,0,0,0,,무슨 일이야?
Dialogue: 0,0:09:55.43,0:09:57.10,N,,0,0,0,,경고 무전에도 대답이 없고
Dialogue: 0,0:09:57.10,0:09:58.67,N,,0,0,0,,모든 통신이 한꺼번에 끊겨
Dialogue: 0,0:09:58.67,0:09:59.38,N,,0,0,0,,버리죠
Dialogue: 0,0:09:59.43,0:10:00.97,D,,0,0,0,,무전이 전부 끊겼어요.
Dialogue: 0,0:10:01.05,0:10:02.81,N,,0,0,0,,창밖으로는 드론 떼가 까맣게
Dialogue: 0,0:10:02.81,0:10:03.92,N,,0,0,0,,몰려오기 시작합니다
Dialogue: 0,0:10:03.97,0:10:05.00,D,,0,0,0,,발포!
Dialogue: 0,0:10:05.08,0:10:06.76,N,,0,0,0,,기내는 순식간에 아수라장이
Dialogue: 0,0:10:06.76,0:10:07.32,N,,0,0,0,,됩니다
Dialogue: 0,0:10:07.32,0:10:09.00,N,,0,0,0,,에어포스원은 온갖 방어 무기로
Dialogue: 0,0:10:09.00,0:10:11.00,N,,0,0,0,,맞서지만 드론은 끝이 없고
Dialogue: 0,0:10:11.00,0:10:13.04,N,,0,0,0,,경호원들은 두 정상을 비행기
Dialogue: 0,0:10:13.04,0:10:14.36,N,,0,0,0,,뒤쪽으로 끌고 갑니다
Dialogue: 0,0:10:14.41,0:10:16.20,D,,0,0,0,,대통령님!
Dialogue: 0,0:10:16.28,0:10:18.16,N,,0,0,0,,엔진 하나가 날아가고 비행기는
Dialogue: 0,0:10:18.16,0:10:19.24,N,,0,0,0,,급강하합니다
Dialogue: 0,0:10:19.29,0:10:21.68,D,,0,0,0,,비상 강하 시작합니다.
Dialogue: 0,0:10:21.84,0:10:23.36,N,,0,0,0,,조종사들은 끝까지 기체를
Dialogue: 0,0:10:23.36,0:10:24.96,N,,0,0,0,,붙잡고, 경호원들은 몸을
Dialogue: 0,0:10:24.96,0:10:26.50,N,,0,0,0,,던져 두 사람을 지키죠
Dialogue: 0,0:10:26.55,0:10:30.45,D,,0,0,0,,움직여!
Dialogue: 0,0:10:30.77,0:10:31.97,N,,0,0,0,,좁은 기내에서 벌어지는 이
Dialogue: 0,0:10:31.97,0:10:34.09,N,,0,0,0,,공중전, 연출이 정말 박진감
Dialogue: 0,0:10:34.09,0:10:34.77,N,,0,0,0,,넘칩니다
Dialogue: 0,0:10:34.83,0:10:36.51,N,,0,0,0,,비행기가 벨라루스 상공으로
Dialogue: 0,0:10:36.51,0:10:37.47,N,,0,0,0,,떨어지는 상황
Dialogue: 0,0:10:37.47,0:10:39.23,N,,0,0,0,,경호원은 마지막 남은 낙하산
Dialogue: 0,0:10:39.23,0:10:40.67,N,,0,0,0,,두 개를 두 사람에게 채워
Dialogue: 0,0:10:40.67,0:10:41.17,N,,0,0,0,,줍니다
Dialogue: 0,0:10:41.22,0:10:44.08,D,,0,0,0,,벨라루스 영공으로 떨어지고 있어요!
Dialogue: 0,0:10:44.30,0:10:45.87,N,,0,0,0,,함께 타자는 윌의 말에도
Dialogue: 0,0:10:45.87,0:10:47.68,N,,0,0,0,,너무 위험하다며 고개를 젓죠
Dialogue: 0,0:10:47.73,0:10:49.23,D,,0,0,0,,두 분 임무는 살아남는 겁니다.
Dialogue: 0,0:10:49.41,0:10:50.67,N,,0,0,0,,그리고 바르샤바 그단스키
Dialogue: 0,0:10:50.67,0:10:52.43,N,,0,0,0,,다리 밑의 안전가옥으로 가라고
Dialogue: 0,0:10:52.43,0:10:53.18,N,,0,0,0,,알려 줍니다
Dialogue: 0,0:10:53.23,0:10:55.10,D,,0,0,0,,낙하산이 알아서 펴질 거예요.
Dialogue: 0,0:10:55.18,0:10:56.86,N,,0,0,0,,두 정상이 뛰어내린 직후
Dialogue: 0,0:10:56.86,0:10:58.52,N,,0,0,0,,에어포스원은 추락합니다
Dialogue: 0,0:10:58.57,0:11:00.90,D,,0,0,0,,윌리엄 데린저 대통령과
Dialogue: 0,0:11:01.10,0:11:03.19,N,,0,0,0,,전 세계 뉴스에는 미국 대통령과
Dialogue: 0,0:11:03.19,0:11:05.06,N,,0,0,0,,영국 총리가 사망했다는 소식이
Dialogue: 0,0:11:05.06,0:11:06.89,N,,0,0,0,,흘러나오고, 부통령 엘리자베스
Dialogue: 0,0:11:06.89,0:11:08.50,N,,0,0,0,,커크가 대통령 권한대행으로
Dialogue: 0,0:11:08.50,0:11:09.21,N,,0,0,0,,취임하죠
Dialogue: 0,0:11:09.26,0:11:10.50,D,,0,0,0,,따라 말해 보세요.
Dialogue: 0,0:11:10.70,0:11:12.58,N,,0,0,0,,나토 정상회의는 순식간에
Dialogue: 0,0:11:12.58,0:11:14.06,N,,0,0,0,,추모의 자리로 바뀝니다
Dialogue: 0,0:11:14.11,0:11:15.10,D,,0,0,0,,괜찮아요?
Dialogue: 0,0:11:15.18,0:11:17.10,N,,0,0,0,,하지만 두 사람은 벨라루스
Dialogue: 0,0:11:17.10,0:11:18.72,N,,0,0,0,,숲속에서 살아 있었습니다
Dialogue: 0,0:11:18.77,0:11:20.80,D,,0,0,0,,대체 어떻게 내 비행기에 탄 거야?
Dialogue: 0,0:11:21.04,0:11:22.56,N,,0,0,0,,윌은 대체 누가 내 비행기에
Dialogue: 0,0:11:22.56,0:11:24.32,N,,0,0,0,,들어왔냐며 분노하고, 샘은
Dialogue: 0,0:11:24.32,0:11:25.72,N,,0,0,0,,내부자의 도움이 있었던 게
Dialogue: 0,0:11:25.72,0:11:26.92,N,,0,0,0,,분명하다고 말하죠
Dialogue: 0,0:11:26.97,0:11:29.73,D,,0,0,0,,폴란드 국경은 저쪽이에요.
Dialogue: 0,0:11:29.81,0:11:31.57,N,,0,0,0,,윌은 당장 구조대가 올 거라고
Dialogue: 0,0:11:31.57,0:11:33.55,N,,0,0,0,,믿지만, 샘의 생각은 다릅니다
Dialogue: 0,0:11:33.60,0:11:35.67,D,,0,0,0,,구조대는 안 와요.
Dialogue: 0,0:11:35.91,0:11:37.67,N,,0,0,0,,벨라루스가 추락 현장을 장악할
Dialogue: 0,0:11:37.67,0:11:39.39,N,,0,0,0,,테니, 적진을 넘어 시신을
Dialogue: 0,0:11:39.39,0:11:40.87,N,,0,0,0,,찾으러 올 사람은 없다고요
Dialogue: 0,0:11:40.92,0:11:43.42,D,,0,0,0,,가족한테 괜찮다고 알려야죠.
Dialogue: 0,0:11:43.60,0:11:45.46,N,,0,0,0,,모두가 생존자는 없다고 여길
Dialogue: 0,0:11:45.46,0:11:46.20,N,,0,0,0,,거라는 거죠
Dialogue: 0,0:11:46.25,0:11:48.18,D,,0,0,0,,우린 안 괜찮아요.
Dialogue: 0,0:11:48.26,0:11:49.73,N,,0,0,0,,윌이 아내에게 살아 있다고
Dialogue: 0,0:11:49.73,0:11:51.46,N,,0,0,0,,전화하려 하자, 샘이 휴대폰을
Dialogue: 0,0:11:51.46,0:11:52.20,N,,0,0,0,,빼앗습니다
Dialogue: 0,0:11:52.25,0:11:53.48,D,,0,0,0,,전화 안 돼요.
Dialogue: 0,0:11:53.56,0:11:55.44,N,,0,0,0,,이런 공격을 벌인 놈들이라면
Dialogue: 0,0:11:55.44,0:11:57.08,N,,0,0,0,,통신을 다 엿듣고 있을 거라는
Dialogue: 0,0:11:57.08,0:11:57.57,N,,0,0,0,,거죠
Dialogue: 0,0:11:57.62,0:12:00.15,D,,0,0,0,,앉아 있긴요, 매달려 있죠.
Dialogue: 0,0:12:00.35,0:12:02.26,N,,0,0,0,,잘못된 손에 들어가면, 잘해야
Dialogue: 0,0:12:02.26,0:12:04.43,N,,0,0,0,,정치적 협상 카드고, 최악이면
Dialogue: 0,0:12:04.43,0:12:06.23,N,,0,0,0,,본보기로 처형당할 거라고요
Dialogue: 0,0:12:06.28,0:12:08.54,D,,0,0,0,,셋 하면 떨어뜨릴게요.
Dialogue: 0,0:12:08.62,0:12:10.66,N,,0,0,0,,그런데 윌은 나뭇가지에 대롱대롱
Dialogue: 0,0:12:10.66,0:12:11.66,N,,0,0,0,,매달려 있는 상황
Dialogue: 0,0:12:11.71,0:12:15.24,D,,0,0,0,,평생 새들 쉼터로 사시든가.
Dialogue: 0,0:12:15.44,0:12:17.08,N,,0,0,0,,화가 난 샘이 먼저 바르샤바로
Dialogue: 0,0:12:17.08,0:12:18.60,N,,0,0,0,,가 버리겠다고 하자, 윌이
Dialogue: 0,0:12:18.60,0:12:19.54,N,,0,0,0,,다급해집니다
Dialogue: 0,0:12:19.59,0:12:23.49,D,,0,0,0,,뒤에 괜찮아요, 데린저?
Dialogue: 0,0:12:23.57,0:12:25.28,N,,0,0,0,,결국 윌은 샘에게 내려 달라고
Dialogue: 0,0:12:25.28,0:12:26.93,N,,0,0,0,,부탁하고, 샘은 미국 액션
Dialogue: 0,0:12:26.93,0:12:28.41,N,,0,0,0,,영웅이 도와 달라고 한다며
Dialogue: 0,0:12:28.41,0:12:29.71,N,,0,0,0,,한껏 놀려 댑니다
Dialogue: 0,0:12:29.76,0:12:33.65,D,,0,0,0,,미국 액션 영웅이 나한테 도와 달라네.
Dialogue: 0,0:12:33.73,0:12:36.37,N,,0,0,0,,폴란드 국경까지는 약 24킬로미터
Dialogue: 0,0:12:36.37,0:12:38.38,N,,0,0,0,,두 사람은 숲길을 걷기 시작합니다
Dialogue: 0,0:12:38.43,0:12:40.22,D,,0,0,0,,당신 같은 사람, 헬스장 근육 말이에요.
Dialogue: 0,0:12:40.54,0:12:42.17,N,,0,0,0,,윌이 헐떡이자, 샘은 원래
Dialogue: 0,0:12:42.17,0:12:43.66,N,,0,0,0,,당신 같은 사람들은 오래
Dialogue: 0,0:12:43.66,0:12:45.00,N,,0,0,0,,걷기 힘들다며 놀리죠
Dialogue: 0,0:12:45.06,0:12:46.74,N,,0,0,0,,헬스장 근육이 아니라 진짜
Dialogue: 0,0:12:46.74,0:12:48.26,N,,0,0,0,,힘이 뭔지 보여 주겠다며
Dialogue: 0,0:12:48.26,0:12:49.62,N,,0,0,0,,윌은 나무를 뽑아서 혼내
Dialogue: 0,0:12:49.62,0:12:50.90,N,,0,0,0,,주겠다고 발끈합니다
Dialogue: 0,0:12:50.90,0:12:52.46,N,,0,0,0,,그런데 윌이 고른 나무가
Dialogue: 0,0:12:52.46,0:12:53.46,N,,0,0,0,,좀 크네요
Dialogue: 0,0:12:53.51,0:12:54.84,D,,0,0,0,,제일 큰 나무를 고르셨네.
Dialogue: 0,0:12:54.92,0:12:56.76,N,,0,0,0,,티격태격하면서도 두 사람의
Dialogue: 0,0:12:56.76,0:12:58.19,N,,0,0,0,,목표는 같습니다
Dialogue: 0,0:12:58.24,0:13:00.84,D,,0,0,0,,10년이나 못 기다려.
Dialogue: 0,0:13:01.04,0:13:02.56,N,,0,0,0,,이 일을 벌인 놈을 찾아서
Dialogue: 0,0:13:02.56,0:13:03.96,N,,0,0,0,,반드시 대가를 치르게 하는
Dialogue: 0,0:13:03.96,0:13:04.26,N,,0,0,0,,것
Dialogue: 0,0:13:04.31,0:13:05.47,D,,0,0,0,,대체 누가 이런 짓을?
Dialogue: 0,0:13:05.79,0:13:07.27,N,,0,0,0,,샘은 빈 라덴을 잡는 데도
Dialogue: 0,0:13:07.27,0:13:09.34,N,,0,0,0,,10년이 걸렸다며 때를 기다리자고
Dialogue: 0,0:13:09.34,0:13:10.76,N,,0,0,0,,하지만, 윌은 달랐죠
Dialogue: 0,0:13:10.81,0:13:12.64,D,,0,0,0,,헬스장 근육 한번 볼래요?
Dialogue: 0,0:13:12.72,0:13:14.61,N,,0,0,0,,그 사이 워싱턴에서는 수상한
Dialogue: 0,0:13:14.61,0:13:15.59,N,,0,0,0,,일이 벌어집니다
Dialogue: 0,0:13:15.64,0:13:18.97,D,,0,0,0,,우리가 한눈판다고 착각하지 마세요.
Dialogue: 0,0:13:19.17,0:13:21.02,N,,0,0,0,,권한대행 커크는 러시아와
Dialogue: 0,0:13:21.02,0:13:22.61,N,,0,0,0,,중국, 이란에 섣불리 움직이지
Dialogue: 0,0:13:22.61,0:13:24.41,N,,0,0,0,,말라고 경고하고, 에셜론
Dialogue: 0,0:13:24.41,0:13:25.99,N,,0,0,0,,보안 점검을 승인하죠
Dialogue: 0,0:13:26.04,0:13:26.83,D,,0,0,0,,커크입니다.
Dialogue: 0,0:13:26.91,0:13:28.46,N,,0,0,0,,그런데 시스템이 재부팅되는
Dialogue: 0,0:13:28.46,0:13:30.63,N,,0,0,0,,바로 그 순간, 누군가 에셜론을
Dialogue: 0,0:13:30.63,0:13:32.05,N,,0,0,0,,통째로 장악해 버립니다
Dialogue: 0,0:13:32.10,0:13:35.37,D,,0,0,0,,이제 에셜론은 우리 손에 있다.
Dialogue: 0,0:13:35.55,0:13:37.21,N,,0,0,0,,세상 모든 통신을 들여다보는
Dialogue: 0,0:13:37.21,0:13:39.13,N,,0,0,0,,신의 눈이, 적의 손에 넘어간
Dialogue: 0,0:13:39.13,0:13:39.59,N,,0,0,0,,거죠
Dialogue: 0,0:13:39.64,0:13:43.53,D,,0,0,0,,무슨 일이야?
Dialogue: 0,0:13:43.61,0:13:45.61,N,,0,0,0,,한편 숲을 빠져나온 두 사람
Dialogue: 0,0:13:45.61,0:13:47.17,N,,0,0,0,,윌은 지나가는 청년들에게
Dialogue: 0,0:13:47.17,0:13:48.73,N,,0,0,0,,차를 얻어 타자고 우기고
Dialogue: 0,0:13:48.73,0:13:50.41,N,,0,0,0,,샘은 조용히 저 차를 훔치자고
Dialogue: 0,0:13:50.41,0:13:50.90,N,,0,0,0,,합니다
Dialogue: 0,0:13:50.95,0:13:53.31,D,,0,0,0,,열여섯 살 때 이웃집 차 훔치다 걸렸잖아요.
Dialogue: 0,0:13:53.63,0:13:55.15,N,,0,0,0,,윌이 열여섯 살 때 이웃집
Dialogue: 0,0:13:55.15,0:13:56.75,N,,0,0,0,,차를 훔치다 걸린 적이 있다는
Dialogue: 0,0:13:56.75,0:13:58.09,N,,0,0,0,,것까지 알고 있었거든요
Dialogue: 0,0:13:58.14,0:13:59.13,D,,0,0,0,,나를 뒷조사했어요?
Dialogue: 0,0:13:59.21,0:14:01.21,N,,0,0,0,,대통령은 뒷조사를 하는 쪽이지
Dialogue: 0,0:14:01.21,0:14:03.21,N,,0,0,0,,당하는 쪽이 아니라며 발끈하던
Dialogue: 0,0:14:03.21,0:14:03.35,N,,0,0,0,,윌
Dialogue: 0,0:14:03.40,0:14:06.13,D,,0,0,0,,그 왜, 워터 코브라요.
Dialogue: 0,0:14:06.33,0:14:08.01,N,,0,0,0,,결국 청년들에게 다가가
Dialogue: 0,0:14:08.01,0:14:10.29,N,,0,0,0,,자기가 그 유명한 워터 코브라라고
Dialogue: 0,0:14:10.29,0:14:10.93,N,,0,0,0,,소개합니다
Dialogue: 0,0:14:10.93,0:14:12.67,N,,0,0,0,,그런데 반응이 싸늘하죠
Dialogue: 0,0:14:12.72,0:14:14.25,D,,0,0,0,,그럼 당신도 날 뒷조사했어요?
Dialogue: 0,0:14:14.33,0:14:15.93,N,,0,0,0,,키아누 리브스에게 선물받은
Dialogue: 0,0:14:15.93,0:14:18.07,N,,0,0,0,,시계까지 내밀어 보지만 소용없습니다
Dialogue: 0,0:14:18.12,0:14:19.55,D,,0,0,0,,눈치 좀 챙겨요.
Dialogue: 0,0:14:19.71,0:14:21.55,N,,0,0,0,,결국 한바탕 싸움이 벌어지고
Dialogue: 0,0:14:21.55,0:14:23.34,N,,0,0,0,,두 정상은 온몸으로 청년들을
Dialogue: 0,0:14:23.34,0:14:24.03,N,,0,0,0,,상대하죠
Dialogue: 0,0:14:24.08,0:14:27.98,D,,0,0,0,,여전히 반응 없네.
Dialogue: 0,0:14:28.20,0:14:30.34,N,,0,0,0,,대통령과 총리가 시골 공터에서
Dialogue: 0,0:14:30.34,0:14:32.06,N,,0,0,0,,몸싸움을 벌이는 장면, 상상만
Dialogue: 0,0:14:32.06,0:14:33.33,N,,0,0,0,,해도 웃기지 않나요?
Dialogue: 0,0:14:33.39,0:14:34.83,N,,0,0,0,,우여곡절 끝에 만난 트럭
Dialogue: 0,0:14:34.83,0:14:35.55,N,,0,0,0,,운전사
Dialogue: 0,0:14:35.55,0:14:37.39,N,,0,0,0,,두 사람을 미국인으로 오해하자
Dialogue: 0,0:14:37.39,0:14:38.73,N,,0,0,0,,윌은 다급하게 둘러댑니다
Dialogue: 0,0:14:38.78,0:14:41.01,D,,0,0,0,,아니, 캐나다 사람이에요.
Dialogue: 0,0:14:41.09,0:14:43.41,N,,0,0,0,,운전사는 국경 너머 바르샤바까지
Dialogue: 0,0:14:43.41,0:14:44.59,N,,0,0,0,,태워 주겠다고 합니다
Dialogue: 0,0:14:44.64,0:14:46.61,D,,0,0,0,,회고록에 쓰기 딱 좋겠네.
Dialogue: 0,0:14:46.77,0:14:48.53,N,,0,0,0,,물론 양 떼와 함께 짐칸에
Dialogue: 0,0:14:48.53,0:14:49.41,N,,0,0,0,,실려서요
Dialogue: 0,0:14:49.41,0:14:51.05,N,,0,0,0,,샘은 처칠과 루스벨트의 첫
Dialogue: 0,0:14:51.05,0:14:52.85,N,,0,0,0,,만남에 양똥을 조금 곁들인
Dialogue: 0,0:14:52.85,0:14:53.94,N,,0,0,0,,격이라며 투덜대죠
Dialogue: 0,0:14:53.99,0:14:56.59,D,,0,0,0,,어디 가요?
Dialogue: 0,0:14:56.67,0:14:58.43,N,,0,0,0,,윌은 적들에게 우리의 분노를
Dialogue: 0,0:14:58.43,0:15:00.43,N,,0,0,0,,보여 주자며 영화 속 명대사를
Dialogue: 0,0:15:00.43,0:15:02.11,N,,0,0,0,,읊고, 샘은 영국인은 그런
Dialogue: 0,0:15:02.11,0:15:04.11,N,,0,0,0,,슬로건을 안 좋아한다고 받아칩니다
Dialogue: 0,0:15:04.16,0:15:06.19,D,,0,0,0,,평정심을 유지하고, 하던 일을 계속하라.
Dialogue: 0,0:15:06.38,0:15:07.75,N,,0,0,0,,영국에도 유명한 문구가 있지
Dialogue: 0,0:15:07.75,0:15:09.19,N,,0,0,0,,않냐는 말에, 샘이 꺼낸
Dialogue: 0,0:15:09.19,0:15:10.17,N,,0,0,0,,건 이거였죠
Dialogue: 0,0:15:10.23,0:15:11.91,N,,0,0,0,,윌은 그거야말로 아무것도
Dialogue: 0,0:15:11.91,0:15:13.31,N,,0,0,0,,하지 말라는 소리 아니냐며
Dialogue: 0,0:15:13.31,0:15:14.05,N,,0,0,0,,웃습니다
Dialogue: 0,0:15:14.10,0:15:16.23,D,,0,0,0,,좋아요, 나부터 할게요.
Dialogue: 0,0:15:16.39,0:15:17.23,N,,0,0,0,,그리고 묻죠
Dialogue: 0,0:15:17.23,0:15:19.67,N,,0,0,0,,인생이 실패와 허무의 연속이라면서
Dialogue: 0,0:15:19.67,0:15:21.15,N,,0,0,0,,왜 한 나라를 이끌겠다고
Dialogue: 0,0:15:21.15,0:15:21.96,N,,0,0,0,,나섰냐고요
Dialogue: 0,0:15:22.01,0:15:23.88,D,,0,0,0,,근데 난 이게 이해가 안 가요.
Dialogue: 0,0:15:23.96,0:15:25.64,N,,0,0,0,,그러다 윌이 먼저 속마음을
Dialogue: 0,0:15:25.64,0:15:26.44,N,,0,0,0,,털어놓습니다
Dialogue: 0,0:15:26.44,0:15:27.96,N,,0,0,0,,스물여덟 살, 워터 코브라
Dialogue: 0,0:15:27.96,0:15:29.32,N,,0,0,0,,홍보 투어로 처음 외국에
Dialogue: 0,0:15:29.32,0:15:30.76,N,,0,0,0,,나가 봤는데, 좋은 사람은
Dialogue: 0,0:15:30.76,0:15:32.76,N,,0,0,0,,어디에나 있지만 세상은 너무
Dialogue: 0,0:15:32.76,0:15:33.63,N,,0,0,0,,갈라져 있더라고
Dialogue: 0,0:15:33.68,0:15:36.74,D,,0,0,0,,근데 세상이 너무 갈라져 있더라고요.
Dialogue: 0,0:15:36.92,0:15:38.64,N,,0,0,0,,그래서 유명세를 써서라도
Dialogue: 0,0:15:38.64,0:15:40.63,N,,0,0,0,,사람들을 이어 주고 싶었다고요
Dialogue: 0,0:15:40.68,0:15:43.38,D,,0,0,0,,자, 당신은 왜예요?
Dialogue: 0,0:15:43.46,0:15:45.06,N,,0,0,0,,진지한 고백에 샘은 끝내
Dialogue: 0,0:15:45.06,0:15:46.42,N,,0,0,0,,대답을 피하지만, 두 사람
Dialogue: 0,0:15:46.42,0:15:48.37,N,,0,0,0,,사이의 공기는 조금씩 달라지기
Dialogue: 0,0:15:48.37,0:15:49.04,N,,0,0,0,,시작합니다
Dialogue: 0,0:15:49.09,0:15:51.05,D,,0,0,0,,힘든 하루죠?
Dialogue: 0,0:15:51.21,0:15:53.05,N,,0,0,0,,이 영화가 단순한 액션 코미디가
Dialogue: 0,0:15:53.05,0:15:54.65,N,,0,0,0,,아니라, 버디 무비의 매력을
Dialogue: 0,0:15:54.65,0:15:56.15,N,,0,0,0,,제대로 살리는 순간이죠
Dialogue: 0,0:15:56.21,0:15:57.88,N,,0,0,0,,국경 검문소에서는 여권을
Dialogue: 0,0:15:57.88,0:15:59.41,N,,0,0,0,,요구받는 아슬아슬한 순간도
Dialogue: 0,0:15:59.41,0:16:00.93,N,,0,0,0,,있었지만, 운전사의 기지
Dialogue: 0,0:16:00.93,0:16:02.54,N,,0,0,0,,덕분에 무사히 통과합니다
Dialogue: 0,0:16:02.59,0:16:04.13,D,,0,0,0,,이제 회고록 쓸 준비가 된 것 같네.
Dialogue: 0,0:16:04.21,0:16:06.13,N,,0,0,0,,운전사는 알고 보니 두 사람의
Dialogue: 0,0:16:06.13,0:16:07.82,N,,0,0,0,,정체를 다 알고 있었죠
Dialogue: 0,0:16:07.87,0:16:11.50,D,,0,0,0,,영광이었습니다, 대통령님.
Dialogue: 0,0:16:11.70,0:16:13.30,N,,0,0,0,,대통령에게 행운을 빈다는
Dialogue: 0,0:16:13.30,0:16:14.92,N,,0,0,0,,인사를 남기고 떠납니다
Dialogue: 0,0:16:14.97,0:16:16.77,D,,0,0,0,,손님이 둘이군.
Dialogue: 0,0:16:16.85,0:16:18.15,N,,0,0,0,,그 시각, 그라도프는 두
Dialogue: 0,0:16:18.15,0:16:19.57,N,,0,0,0,,사람이 바르샤바 안전가옥에
Dialogue: 0,0:16:19.57,0:16:21.01,N,,0,0,0,,나타났다는 걸 에셜론으로
Dialogue: 0,0:16:21.01,0:16:21.79,N,,0,0,0,,알아챕니다
Dialogue: 0,0:16:21.84,0:16:23.87,D,,0,0,0,,내가 죽으라면 죽는 거야.
Dialogue: 0,0:16:24.03,0:16:25.87,N,,0,0,0,,부하가 에어포스원을 떨어뜨렸으면
Dialogue: 0,0:16:25.87,0:16:27.63,N,,0,0,0,,된 것 아니냐고 하자, 그라도프는
Dialogue: 0,0:16:27.63,0:16:28.59,N,,0,0,0,,차갑게 말하죠
Dialogue: 0,0:16:28.64,0:16:30.91,D,,0,0,0,,입 다물어.
Dialogue: 0,0:16:31.12,0:16:32.91,N,,0,0,0,,내가 죽으라고 했으니 죽어야
Dialogue: 0,0:16:32.91,0:16:33.69,N,,0,0,0,,한다고요
Dialogue: 0,0:16:33.75,0:16:35.35,N,,0,0,0,,안전가옥에서 두 사람을 맞은
Dialogue: 0,0:16:35.35,0:16:36.87,N,,0,0,0,,건 씨아이에이 요원 마티
Dialogue: 0,0:16:36.87,0:16:37.25,N,,0,0,0,,코머
Dialogue: 0,0:16:37.30,0:16:39.24,D,,0,0,0,,완전 팬이에요.
Dialogue: 0,0:16:39.56,0:16:41.20,N,,0,0,0,,윌의 열혈 팬이라, 대통령을
Dialogue: 0,0:16:41.20,0:16:43.16,N,,0,0,0,,보자마자 눈물부터 쏟습니다
Dialogue: 0,0:16:43.21,0:16:44.31,D,,0,0,0,,미안해요.
Dialogue: 0,0:16:44.39,0:16:46.27,N,,0,0,0,,종말 대비 매뉴얼은 다 있어도
Dialogue: 0,0:16:46.27,0:16:48.03,N,,0,0,0,,전 세계가 보는 앞에서 죽은
Dialogue: 0,0:16:48.03,0:16:49.43,N,,0,0,0,,두 정상이 걸어 들어오는
Dialogue: 0,0:16:49.43,0:16:51.13,N,,0,0,0,,매뉴얼은 없다는 마티
Dialogue: 0,0:16:51.18,0:16:52.31,D,,0,0,0,,그럼 하나 만들죠.
Dialogue: 0,0:16:52.63,0:16:53.83,N,,0,0,0,,잭 퀘이드가 연기하는 이
Dialogue: 0,0:16:53.83,0:16:55.70,N,,0,0,0,,수다쟁이 요원, 등장만으로도
Dialogue: 0,0:16:55.70,0:16:57.33,N,,0,0,0,,영화에 활력이 확 돕니다
Dialogue: 0,0:16:57.38,0:16:59.77,D,,0,0,0,,데린저가 대량살상무기라고?
Dialogue: 0,0:16:59.85,0:17:01.89,N,,0,0,0,,마티는 충격적인 소식을 전합니다
Dialogue: 0,0:17:01.89,0:17:03.56,N,,0,0,0,,에셜론이 해킹당해, 나토
Dialogue: 0,0:17:03.56,0:17:05.48,N,,0,0,0,,회원국들이 서로를 몰래 감시하고
Dialogue: 0,0:17:05.48,0:17:07.57,N,,0,0,0,,서로의 경제를 흔들고, 선거에까지
Dialogue: 0,0:17:07.57,0:17:09.45,N,,0,0,0,,개입한 비밀 문서 2만 건이
Dialogue: 0,0:17:09.45,0:17:10.53,N,,0,0,0,,유출됐다는 거죠
Dialogue: 0,0:17:10.58,0:17:12.51,D,,0,0,0,,누군가 에셜론으로 나토를 찢어 놓고 있어요.
Dialogue: 0,0:17:12.59,0:17:14.59,N,,0,0,0,,적국이 아니라 동맹끼리 서로를
Dialogue: 0,0:17:14.59,0:17:16.11,N,,0,0,0,,속여 온 사실이 드러나면서
Dialogue: 0,0:17:16.11,0:17:17.87,N,,0,0,0,,나토 정상회의는 난장판이
Dialogue: 0,0:17:17.87,0:17:18.43,N,,0,0,0,,됐습니다
Dialogue: 0,0:17:18.48,0:17:21.51,D,,0,0,0,,친구가 친구를 친 거예요.
Dialogue: 0,0:17:21.67,0:17:23.03,N,,0,0,0,,독일은 프랑스를, 체코는
Dialogue: 0,0:17:23.03,0:17:25.26,N,,0,0,0,,이탈리아를 쫓아내라며 들고일어났죠
Dialogue: 0,0:17:25.31,0:17:26.51,D,,0,0,0,,독재자들이 활개를 치겠죠.
Dialogue: 0,0:17:26.83,0:17:28.67,N,,0,0,0,,샘은 나토가 무너지면 독재자들을
Dialogue: 0,0:17:28.67,0:17:31.06,N,,0,0,0,,막을 방패가 사라진다며 심각해집니다
Dialogue: 0,0:17:31.11,0:17:33.11,D,,0,0,0,,내가 그랬지, 하고 싶어 죽겠죠?
Dialogue: 0,0:17:33.19,0:17:35.38,N,,0,0,0,,샘은 모든 지휘 체계가 뚫렸다고
Dialogue: 0,0:17:35.38,0:17:37.19,N,,0,0,0,,가정해야 한다며 반대하지만
Dialogue: 0,0:17:37.19,0:17:38.55,N,,0,0,0,,윌은 대사관에 연락하라고
Dialogue: 0,0:17:38.55,0:17:39.33,N,,0,0,0,,밀어붙입니다
Dialogue: 0,0:17:39.38,0:17:41.04,D,,0,0,0,,난 군 통수권자야.
Dialogue: 0,0:17:41.12,0:17:42.69,N,,0,0,0,,그리고 전화를 거는 순간
Dialogue: 0,0:17:42.69,0:17:44.16,N,,0,0,0,,수상한 소리가 들려옵니다
Dialogue: 0,0:17:44.16,0:17:46.14,N,,0,0,0,,안전가옥이 습격을 당한 거죠
Dialogue: 0,0:17:46.19,0:17:47.65,D,,0,0,0,,이 정도면 안전한가요?
Dialogue: 0,0:17:47.73,0:17:49.17,N,,0,0,0,,마티는 두 사람에게 비밀
Dialogue: 0,0:17:49.17,0:17:50.77,N,,0,0,0,,통로를 알려 주고, 혼자서
Dialogue: 0,0:17:50.77,0:17:52.14,N,,0,0,0,,적들을 막아섭니다
Dialogue: 0,0:17:52.19,0:17:53.38,D,,0,0,0,,그래도 미국 대표 괴짜죠.
Dialogue: 0,0:17:53.57,0:17:55.22,N,,0,0,0,,음악을 크게 틀어 놓고 총을
Dialogue: 0,0:17:55.22,0:17:57.47,N,,0,0,0,,드는 그의 모습, 꽤 멋있습니다
Dialogue: 0,0:17:57.52,0:18:01.41,D,,0,0,0,,자, 잘 들어요.
Dialogue: 0,0:18:01.49,0:18:03.05,N,,0,0,0,,비밀 통로의 입구는 벽에
Dialogue: 0,0:18:03.05,0:18:04.09,N,,0,0,0,,붙은 포스터
Dialogue: 0,0:18:04.09,0:18:06.13,N,,0,0,0,,주먹으로 뚫고 나가야 하는데
Dialogue: 0,0:18:06.13,0:18:07.65,N,,0,0,0,,윌은 망설이다 주먹을 못
Dialogue: 0,0:18:07.65,0:18:09.57,N,,0,0,0,,내지르고, 결국 샘이 대신
Dialogue: 0,0:18:09.57,0:18:10.46,N,,0,0,0,,몸을 날립니다
Dialogue: 0,0:18:10.51,0:18:12.44,D,,0,0,0,,포스터 찾았다.
Dialogue: 0,0:18:12.52,0:18:14.20,N,,0,0,0,,적과의 몸싸움 끝에 샘은
Dialogue: 0,0:18:14.20,0:18:15.88,N,,0,0,0,,윌에게, 총 든 모습이 제법
Dialogue: 0,0:18:15.88,0:18:17.96,N,,0,0,0,,멋있다며 처음으로 칭찬 비슷한
Dialogue: 0,0:18:17.96,0:18:18.66,N,,0,0,0,,걸 건넵니다
Dialogue: 0,0:18:18.71,0:18:21.17,D,,0,0,0,,총 든 모습이 좀 멋있네요.
Dialogue: 0,0:18:21.25,0:18:23.09,N,,0,0,0,,간신히 밖으로 빠져나왔지만
Dialogue: 0,0:18:23.09,0:18:25.04,N,,0,0,0,,적들에게 포위된 절체절명의
Dialogue: 0,0:18:25.04,0:18:25.39,N,,0,0,0,,순간
Dialogue: 0,0:18:25.44,0:18:26.87,D,,0,0,0,,죽은 줄 알았어.
Dialogue: 0,0:18:27.03,0:18:28.47,N,,0,0,0,,두 사람을 구해 준 사람은
Dialogue: 0,0:18:28.47,0:18:29.71,N,,0,0,0,,바로 스페인에서 죽은 줄
Dialogue: 0,0:18:29.71,0:18:31.25,N,,0,0,0,,알았던 노엘이었습니다
Dialogue: 0,0:18:31.30,0:18:32.23,D,,0,0,0,,놈들을 잡았다.
Dialogue: 0,0:18:32.31,0:18:33.87,N,,0,0,0,,노엘은 스페인에서부터 홀로
Dialogue: 0,0:18:33.87,0:18:35.59,N,,0,0,0,,그라도프의 부하들을 추적해
Dialogue: 0,0:18:35.59,0:18:36.45,N,,0,0,0,,왔다고 말합니다
Dialogue: 0,0:18:36.50,0:18:38.43,D,,0,0,0,,지원군은 없어요.
Dialogue: 0,0:18:38.64,0:18:39.77,N,,0,0,0,,지원군도 없이요
Dialogue: 0,0:18:39.77,0:18:41.31,N,,0,0,0,,그리고 이 모든 일의 배후가
Dialogue: 0,0:18:41.31,0:18:42.58,N,,0,0,0,,그라도프라고 알려 주죠
Dialogue: 0,0:18:42.63,0:18:44.16,D,,0,0,0,,둘이 아는 사이야?
Dialogue: 0,0:18:44.24,0:18:45.88,N,,0,0,0,,노엘이 밝힌 숨겨진 진실은
Dialogue: 0,0:18:45.88,0:18:46.72,N,,0,0,0,,이렇습니다
Dialogue: 0,0:18:46.72,0:18:48.08,N,,0,0,0,,몇 년 전 나토가 핵무기
Dialogue: 0,0:18:48.08,0:18:49.76,N,,0,0,0,,공장인 줄 알고 폭격한 곳은
Dialogue: 0,0:18:49.76,0:18:51.71,N,,0,0,0,,사실 그라도프의 아들이 녹지
Dialogue: 0,0:18:51.71,0:18:53.92,N,,0,0,0,,않는 원자로를 개발하던 연구소였다는
Dialogue: 0,0:18:53.92,0:18:54.58,N,,0,0,0,,겁니다
Dialogue: 0,0:18:54.63,0:18:56.79,D,,0,0,0,,그라도프는 핵무기를 만든 게 아니었어요.
Dialogue: 0,0:18:56.87,0:18:58.55,N,,0,0,0,,그 폭격으로 아들은 목숨을
Dialogue: 0,0:18:58.55,0:19:00.42,N,,0,0,0,,잃었고, 두 나라는 그 기술을
Dialogue: 0,0:19:00.42,0:19:02.43,N,,0,0,0,,가져다 자기들 성과처럼 발표했던
Dialogue: 0,0:19:02.43,0:19:02.93,N,,0,0,0,,거예요
Dialogue: 0,0:19:02.98,0:19:05.98,D,,0,0,0,,머리 위에 미사일을 떨어뜨렸다고?
Dialogue: 0,0:19:06.17,0:19:08.02,N,,0,0,0,,기자회견에서 자랑하던 바로
Dialogue: 0,0:19:08.02,0:19:09.88,N,,0,0,0,,그 페블 베드 원자로 말이죠
Dialogue: 0,0:19:09.93,0:19:12.39,D,,0,0,0,,나토가 승인한 작전이었어요.
Dialogue: 0,0:19:12.55,0:19:14.23,N,,0,0,0,,그라도프 입장에서는, 아들과
Dialogue: 0,0:19:14.23,0:19:15.99,N,,0,0,0,,아들의 업적을 모두 빼앗긴
Dialogue: 0,0:19:15.99,0:19:16.61,N,,0,0,0,,셈입니다
Dialogue: 0,0:19:16.66,0:19:17.86,D,,0,0,0,,페블 베드 기술이요.
Dialogue: 0,0:19:17.94,0:19:19.30,N,,0,0,0,,윌은 이러면 우리가 나쁜
Dialogue: 0,0:19:19.30,0:19:20.94,N,,0,0,0,,놈 아니냐며 혼란스러워하지만
Dialogue: 0,0:19:20.94,0:19:22.08,N,,0,0,0,,노엘은 단호합니다
Dialogue: 0,0:19:22.13,0:19:24.89,D,,0,0,0,,악마의 아들이라서 죽은 거예요.
Dialogue: 0,0:19:25.05,0:19:26.69,N,,0,0,0,,그라도프의 아들은 우리 때문이
Dialogue: 0,0:19:26.69,0:19:28.19,N,,0,0,0,,아니라, 악마의 아들이었기
Dialogue: 0,0:19:28.19,0:19:29.45,N,,0,0,0,,때문에 죽은 거라고요
Dialogue: 0,0:19:29.50,0:19:32.06,D,,0,0,0,,바르샤바 안전가옥이 습격당했어요.
Dialogue: 0,0:19:32.14,0:19:34.26,N,,0,0,0,,하지만 그라도프 혼자서 에셜론과
Dialogue: 0,0:19:34.26,0:19:35.63,N,,0,0,0,,에어포스원까지 뚫을 수는
Dialogue: 0,0:19:35.63,0:19:36.61,N,,0,0,0,,없었을 겁니다
Dialogue: 0,0:19:36.66,0:19:38.19,D,,0,0,0,,원래 나랑 같이 타기로 했잖아요.
Dialogue: 0,0:19:38.40,0:19:40.11,N,,0,0,0,,정부 최고위층에 내부자가
Dialogue: 0,0:19:40.11,0:19:40.98,N,,0,0,0,,있다는 뜻이죠
Dialogue: 0,0:19:41.03,0:19:43.06,D,,0,0,0,,그 가능성도 생각해야 해요...
Dialogue: 0,0:19:43.38,0:19:44.90,N,,0,0,0,,윌은 두 사람을 같은 비행기에
Dialogue: 0,0:19:44.90,0:19:46.90,N,,0,0,0,,태우자고 했던, 샘의 비서실장
Dialogue: 0,0:19:46.90,0:19:48.08,N,,0,0,0,,퀸시를 의심합니다
Dialogue: 0,0:19:48.13,0:19:50.06,D,,0,0,0,,분위기가 점점 험악해져요.
Dialogue: 0,0:19:50.14,0:19:51.58,N,,0,0,0,,그 무렵 트리에스테에서는
Dialogue: 0,0:19:51.58,0:19:53.18,N,,0,0,0,,권한대행 커크가 흔들리는
Dialogue: 0,0:19:53.18,0:19:54.68,N,,0,0,0,,나토를 붙잡으려 애씁니다
Dialogue: 0,0:19:54.73,0:19:56.59,D,,0,0,0,,난 희망 안 버렸어요.
Dialogue: 0,0:19:56.91,0:19:58.59,N,,0,0,0,,윌의 친구 브래드쇼는 아직
Dialogue: 0,0:19:58.59,0:20:00.19,N,,0,0,0,,희망을 놓지 말자고 하지만
Dialogue: 0,0:20:00.19,0:20:01.95,N,,0,0,0,,커크는 이제 현실을 받아들이라고
Dialogue: 0,0:20:01.95,0:20:02.65,N,,0,0,0,,선을 긋죠
Dialogue: 0,0:20:02.70,0:20:05.54,D,,0,0,0,,둘 다 떠났어요.
Dialogue: 0,0:20:05.62,0:20:08.02,N,,0,0,0,,한편 윌은 계속 퀸시를 의심하고
Dialogue: 0,0:20:08.02,0:20:09.62,N,,0,0,0,,샘은 대학 때부터 알던 친구라며
Dialogue: 0,0:20:09.62,0:20:10.32,N,,0,0,0,,펄쩍 뜁니다
Dialogue: 0,0:20:10.37,0:20:11.80,D,,0,0,0,,방금 말장난한 거 맞죠?
Dialogue: 0,0:20:11.96,0:20:13.72,N,,0,0,0,,그걸 지켜보던 노엘이 한마디
Dialogue: 0,0:20:13.72,0:20:14.20,N,,0,0,0,,던지죠
Dialogue: 0,0:20:14.20,0:20:16.02,N,,0,0,0,,서로 그만 좀 깎아내리라고요
Dialogue: 0,0:20:16.07,0:20:17.40,D,,0,0,0,,퀸시일 리가 없어.
Dialogue: 0,0:20:17.53,0:20:19.32,N,,0,0,0,,그런데 그 말이 또 말장난이라
Dialogue: 0,0:20:19.32,0:20:20.42,N,,0,0,0,,윌은 기겁합니다
Dialogue: 0,0:20:20.47,0:20:22.83,D,,0,0,0,,또 그 소리예요?
Dialogue: 0,0:20:22.91,0:20:24.22,N,,0,0,0,,노엘의 계획은 두 사람을
Dialogue: 0,0:20:24.22,0:20:26.19,N,,0,0,0,,가장 안전한 곳, 나토 정상회의가
Dialogue: 0,0:20:26.19,0:20:28.19,N,,0,0,0,,열리는 이탈리아 트리에스테까지
Dialogue: 0,0:20:28.19,0:20:28.93,N,,0,0,0,,데려가는 것
Dialogue: 0,0:20:28.98,0:20:30.44,D,,0,0,0,,죄송하지만, 이제 아니세요.
Dialogue: 0,0:20:30.76,0:20:32.44,N,,0,0,0,,윌은 대사관으로 가자고 조르며
Dialogue: 0,0:20:32.44,0:20:34.32,N,,0,0,0,,자기가 군 통수권자라고 하지만
Dialogue: 0,0:20:34.32,0:20:35.46,N,,0,0,0,,노엘은 단호합니다
Dialogue: 0,0:20:35.51,0:20:36.61,D,,0,0,0,,대사관이 도와줄 거예요.
Dialogue: 0,0:20:36.69,0:20:38.37,N,,0,0,0,,부통령이 이미 취임했으니
Dialogue: 0,0:20:38.37,0:20:39.97,N,,0,0,0,,지금 두 사람은 대통령도
Dialogue: 0,0:20:39.97,0:20:42.02,N,,0,0,0,,총리도 아니고 그냥 운 나쁜
Dialogue: 0,0:20:42.02,0:20:43.20,N,,0,0,0,,남자 둘이라는 거죠
Dialogue: 0,0:20:43.25,0:20:45.45,D,,0,0,0,,기차처럼 의욕이 넘치시네요.
Dialogue: 0,0:20:45.61,0:20:47.17,N,,0,0,0,,그렇게 올라탄 화물 기차
Dialogue: 0,0:20:47.17,0:20:49.21,N,,0,0,0,,노엘의 기차 말장난까지 이어지자
Dialogue: 0,0:20:49.21,0:20:50.73,N,,0,0,0,,윌은 고개를 젓습니다
Dialogue: 0,0:20:50.78,0:20:53.31,D,,0,0,0,,난 비행기 사고로 죽었고, 여긴 지옥이야.
Dialogue: 0,0:20:53.39,0:20:55.23,N,,0,0,0,,기차 안에서 샘과 노엘은
Dialogue: 0,0:20:55.23,0:20:56.43,N,,0,0,0,,스페인에서 잃은 동료들을
Dialogue: 0,0:20:56.43,0:20:58.11,N,,0,0,0,,떠올리고, 오래 묵은 이야기를
Dialogue: 0,0:20:58.11,0:20:58.73,N,,0,0,0,,꺼냅니다
Dialogue: 0,0:20:58.78,0:21:01.71,D,,0,0,0,,사과는 하지 마.
Dialogue: 0,0:21:01.87,0:21:03.34,N,,0,0,0,,트리폴리에서 헤어진 뒤로
Dialogue: 0,0:21:03.34,0:21:04.75,N,,0,0,0,,사라져 버린 이유를 설명하고
Dialogue: 0,0:21:04.75,0:21:06.75,N,,0,0,0,,싶다는 샘에게, 노엘은 사과는
Dialogue: 0,0:21:06.75,0:21:07.73,N,,0,0,0,,하지 말라고 하죠
Dialogue: 0,0:21:07.78,0:21:09.58,D,,0,0,0,,상관 마요.
Dialogue: 0,0:21:09.66,0:21:11.22,N,,0,0,0,,노엘이 자리를 비우자 윌은
Dialogue: 0,0:21:11.22,0:21:12.78,N,,0,0,0,,참지 못하고 캐묻습니다
Dialogue: 0,0:21:12.83,0:21:14.62,D,,0,0,0,,트리폴리 얘기 좀 그만해!
Dialogue: 0,0:21:14.78,0:21:16.65,N,,0,0,0,,트리폴리에서 대체 무슨 일이
Dialogue: 0,0:21:16.65,0:21:17.51,N,,0,0,0,,있었냐고요
Dialogue: 0,0:21:17.56,0:21:19.12,D,,0,0,0,,먹을 것 좀 가져올게요.
Dialogue: 0,0:21:19.20,0:21:20.96,N,,0,0,0,,결국 샘이 털어놓습니다
Dialogue: 0,0:21:20.96,0:21:22.76,N,,0,0,0,,트리폴리는 노엘에게 정치를
Dialogue: 0,0:21:22.76,0:21:24.28,N,,0,0,0,,하겠다고 말한 곳이었다고
Dialogue: 0,0:21:24.33,0:21:27.43,D,,0,0,0,,이렇게 로맨틱한 얘긴 처음 들어.
Dialogue: 0,0:21:27.59,0:21:29.23,N,,0,0,0,,그리고 정치를 시작한 이유는
Dialogue: 0,0:21:29.23,0:21:30.73,N,,0,0,0,,노엘과 함께 늙어 갈 더
Dialogue: 0,0:21:30.73,0:21:32.85,N,,0,0,0,,좋은 세상을 만들고 싶어서였다고요
Dialogue: 0,0:21:32.90,0:21:34.03,D,,0,0,0,,유머 감각은 끝내주네요.
Dialogue: 0,0:21:34.11,0:21:36.05,N,,0,0,0,,무뚝뚝한 샘에게 이런 순정이
Dialogue: 0,0:21:36.05,0:21:36.67,N,,0,0,0,,있었다니
Dialogue: 0,0:21:36.67,0:21:38.83,N,,0,0,0,,이 장면부터 샘이라는 캐릭터가
Dialogue: 0,0:21:38.83,0:21:40.65,N,,0,0,0,,확 입체적으로 다가옵니다
Dialogue: 0,0:21:40.70,0:21:42.56,D,,0,0,0,,말로 합시다.
Dialogue: 0,0:21:42.64,0:21:44.85,N,,0,0,0,,그때 기차에 킬러들이 들이닥칩니다
Dialogue: 0,0:21:44.85,0:21:46.56,N,,0,0,0,,그런데 그중 한 명이 뜻밖의
Dialogue: 0,0:21:46.56,0:21:47.28,N,,0,0,0,,말을 꺼내죠
Dialogue: 0,0:21:47.33,0:21:50.40,D,,0,0,0,,얘기는 들어 봐야죠.
Dialogue: 0,0:21:50.56,0:21:52.00,N,,0,0,0,,그라도프에게 약점을 잡혀
Dialogue: 0,0:21:52.00,0:21:53.38,N,,0,0,0,,어쩔 수 없이 일해 왔지만
Dialogue: 0,0:21:53.38,0:21:55.02,N,,0,0,0,,이번 일은 도를 넘었다고요
Dialogue: 0,0:21:55.08,0:21:56.60,N,,0,0,0,,그는 크로아티아 자다르의
Dialogue: 0,0:21:56.60,0:21:58.81,N,,0,0,0,,한 건물 5층에 있는 단말기에서
Dialogue: 0,0:21:58.81,0:22:00.44,N,,0,0,0,,자신이 만든 프로그램을 돌리면
Dialogue: 0,0:22:00.44,0:22:01.92,N,,0,0,0,,그라도프와 연락한 내부자가
Dialogue: 0,0:22:01.92,0:22:03.16,N,,0,0,0,,드러난다고 알려 줍니다
Dialogue: 0,0:22:03.21,0:22:06.48,D,,0,0,0,,당신들이 끝내야 해요.
Dialogue: 0,0:22:06.66,0:22:08.56,N,,0,0,0,,그리고 다음 역에는 적들이
Dialogue: 0,0:22:08.56,0:22:10.30,N,,0,0,0,,기다리고 있을 거라고 경고하죠
Dialogue: 0,0:22:10.35,0:22:12.28,D,,0,0,0,,그라도프의 보안 통신으로요.
Dialogue: 0,0:22:12.36,0:22:14.44,N,,0,0,0,,결국 세 사람은 시속 60킬로미터로
Dialogue: 0,0:22:14.44,0:22:16.14,N,,0,0,0,,달리는 기차에서 뛰어내리기로
Dialogue: 0,0:22:16.14,0:22:16.70,N,,0,0,0,,합니다
Dialogue: 0,0:22:16.75,0:22:19.15,D,,0,0,0,,턱을 가슴에 붙여요!
Dialogue: 0,0:22:19.39,0:22:20.87,N,,0,0,0,,윌은 영화 데스 점퍼스에서
Dialogue: 0,0:22:20.87,0:22:22.75,N,,0,0,0,,해 봤다며 꿀팁을 전수하죠
Dialogue: 0,0:22:22.80,0:22:24.10,D,,0,0,0,,할 수 있어요, 알았죠?
Dialogue: 0,0:22:24.18,0:22:25.78,N,,0,0,0,,같은 시각 트리에스테의 나토
Dialogue: 0,0:22:25.78,0:22:27.78,N,,0,0,0,,회의장은 무너지기 직전입니다
Dialogue: 0,0:22:27.83,0:22:29.96,D,,0,0,0,,이 동맹에서 탈퇴하는 거요.
Dialogue: 0,0:22:30.20,0:22:32.00,N,,0,0,0,,커크가 동맹을 더 굳게 다지자고
Dialogue: 0,0:22:32.00,0:22:33.80,N,,0,0,0,,호소하지만, 회원국들은 서로를
Dialogue: 0,0:22:33.80,0:22:35.64,N,,0,0,0,,믿을 수 없다며 등을 돌리죠
Dialogue: 0,0:22:35.69,0:22:39.55,D,,0,0,0,,개인의 힘은 곧 조직입니다.
Dialogue: 0,0:22:39.77,0:22:41.63,N,,0,0,0,,선거를 앞둔 한 정상은 아예
Dialogue: 0,0:22:41.63,0:22:42.51,N,,0,0,0,,선언해 버립니다
Dialogue: 0,0:22:42.56,0:22:46.45,D,,0,0,0,,난 이 방의 누구도 못 믿어요.
Dialogue: 0,0:22:46.53,0:22:48.21,N,,0,0,0,,결국 다음 날 아침, 무려
Dialogue: 0,0:22:48.21,0:22:50.05,N,,0,0,0,,25개국이 찬성한 나토 해체
Dialogue: 0,0:22:50.05,0:22:51.55,N,,0,0,0,,투표가 잡히고 맙니다
Dialogue: 0,0:22:51.60,0:22:53.73,D,,0,0,0,,턱 붙이기, 효과 있었죠?
Dialogue: 0,0:22:53.81,0:22:55.41,N,,0,0,0,,자다르의 낡은 건물에 도착한
Dialogue: 0,0:22:55.41,0:22:56.05,N,,0,0,0,,세 사람
Dialogue: 0,0:22:56.05,0:22:57.69,N,,0,0,0,,처음엔 거짓말쟁이에게 속아
Dialogue: 0,0:22:57.69,0:22:59.45,N,,0,0,0,,막다른 곳에 왔나 싶었지만
Dialogue: 0,0:22:59.45,0:23:01.25,N,,0,0,0,,숨겨진 비밀 방을 찾아냅니다
Dialogue: 0,0:23:01.30,0:23:02.36,D,,0,0,0,,여긴 아무것도 없어.
Dialogue: 0,0:23:02.52,0:23:04.04,N,,0,0,0,,그런데 프로그램을 돌리는
Dialogue: 0,0:23:04.04,0:23:06.05,N,,0,0,0,,사이, 무장한 적들이 몰려오죠
Dialogue: 0,0:23:06.11,0:23:08.03,N,,0,0,0,,샘은 혼자 남아 적들을 막겠다고
Dialogue: 0,0:23:08.03,0:23:08.83,N,,0,0,0,,나섭니다
Dialogue: 0,0:23:08.83,0:23:10.80,N,,0,0,0,,윌이 걱정하자, 샘이 묻죠
Dialogue: 0,0:23:10.85,0:23:13.01,D,,0,0,0,,내가 한물간 것 같아?
Dialogue: 0,0:23:13.09,0:23:14.97,N,,0,0,0,,그 사이 노엘과 윌은 프로그램을
Dialogue: 0,0:23:14.97,0:23:16.77,N,,0,0,0,,돌려 내부자를 추적합니다
Dialogue: 0,0:23:16.82,0:23:17.88,D,,0,0,0,,브래드쇼예요.
Dialogue: 0,0:23:18.04,0:23:19.67,N,,0,0,0,,그리고 드디어 드러난 내부자의
Dialogue: 0,0:23:19.67,0:23:21.90,N,,0,0,0,,이름은, 퀸시가 아니었습니다
Dialogue: 0,0:23:21.95,0:23:23.91,D,,0,0,0,,우리가 해낼게요.
Dialogue: 0,0:23:23.99,0:23:26.03,N,,0,0,0,,바로 윌의 절친이자 비서실장
Dialogue: 0,0:23:26.03,0:23:26.93,N,,0,0,0,,브래드쇼였죠
Dialogue: 0,0:23:26.98,0:23:27.88,D,,0,0,0,,미안해요.
Dialogue: 0,0:23:28.04,0:23:29.75,N,,0,0,0,,18개월 넘게 그라도프와
Dialogue: 0,0:23:29.75,0:23:31.56,N,,0,0,0,,연락을 주고받은 흔적이 고스란히
Dialogue: 0,0:23:31.56,0:23:32.43,N,,0,0,0,,남아 있었습니다
Dialogue: 0,0:23:32.48,0:23:33.11,D,,0,0,0,,좋아, 들어갔어.
Dialogue: 0,0:23:33.33,0:23:35.35,N,,0,0,0,,가장 믿었던 친구의 배신에
Dialogue: 0,0:23:35.35,0:23:36.87,N,,0,0,0,,윌은 할 말을 잃습니다
Dialogue: 0,0:23:36.93,0:23:38.69,N,,0,0,0,,탈출하는 사이 건물은 폭발에
Dialogue: 0,0:23:38.69,0:23:40.29,N,,0,0,0,,휩싸이고, 샘은 불길 속으로
Dialogue: 0,0:23:40.29,0:23:41.17,N,,0,0,0,,사라집니다
Dialogue: 0,0:23:41.17,0:23:42.69,N,,0,0,0,,윌과 노엘은 간신히 건물을
Dialogue: 0,0:23:42.69,0:23:43.57,N,,0,0,0,,빠져나오죠
Dialogue: 0,0:23:43.62,0:23:44.62,D,,0,0,0,,이쪽으로 와요!
Dialogue: 0,0:23:44.70,0:23:46.14,N,,0,0,0,,노엘은 무너져 내립니다
Dialogue: 0,0:23:46.14,0:23:47.58,N,,0,0,0,,우주가 이 끔찍한 일을 다
Dialogue: 0,0:23:47.58,0:23:49.55,N,,0,0,0,,벌인 게, 자신과 샘을 다시
Dialogue: 0,0:23:49.55,0:23:51.22,N,,0,0,0,,만나게 하려는 거였나 싶어서
Dialogue: 0,0:23:51.22,0:23:53.26,N,,0,0,0,,잠깐 행복했다고 고백하죠
Dialogue: 0,0:23:53.26,0:23:55.64,N,,0,0,0,,윌은 말없이 그녀 곁을 지킵니다
Dialogue: 0,0:23:55.69,0:23:57.79,D,,0,0,0,,절친이 날 죽이려 했다는 걸 방금 알았거든요.
Dialogue: 0,0:23:57.87,0:23:59.63,N,,0,0,0,,나토 해체 투표까지 남은
Dialogue: 0,0:23:59.63,0:24:00.74,N,,0,0,0,,시간은 30분
Dialogue: 0,0:24:00.79,0:24:03.89,D,,0,0,0,,제 자리 지켜 줘서 고마워요.
Dialogue: 0,0:24:04.13,0:24:05.65,N,,0,0,0,,전 세계가 나토의 붕괴를
Dialogue: 0,0:24:05.65,0:24:07.89,N,,0,0,0,,지켜보던 그때, 윌은 권한대행
Dialogue: 0,0:24:07.89,0:24:09.51,N,,0,0,0,,커크에게 전화를 겁니다
Dialogue: 0,0:24:09.56,0:24:12.42,D,,0,0,0,,트리에스테 항구에 있어요.
Dialogue: 0,0:24:12.50,0:24:14.02,N,,0,0,0,,윌은 살아 있다고 알리고
Dialogue: 0,0:24:14.02,0:24:15.84,N,,0,0,0,,브래드쇼가 배후라고 전합니다
Dialogue: 0,0:24:15.89,0:24:18.19,D,,0,0,0,,브래드쇼가 아니었어. 커크였어.
Dialogue: 0,0:24:18.51,0:24:19.99,N,,0,0,0,,커크는 투표를 최대한 막고
Dialogue: 0,0:24:19.99,0:24:21.63,N,,0,0,0,,있겠다며 대통령 전용차를
Dialogue: 0,0:24:21.63,0:24:22.27,N,,0,0,0,,보내 주죠
Dialogue: 0,0:24:22.41,0:24:23.93,N,,0,0,0,,그런데 전화를 끊은 커크가
Dialogue: 0,0:24:23.93,0:24:25.85,N,,0,0,0,,그라도프의 부하에게 두 사람을
Dialogue: 0,0:24:25.85,0:24:27.14,N,,0,0,0,,처리하라고 지시합니다
Dialogue: 0,0:24:27.20,0:24:29.60,N,,0,0,0,,진짜 내부자는 부통령 커크였던
Dialogue: 0,0:24:29.60,0:24:30.07,N,,0,0,0,,겁니다
Dialogue: 0,0:24:30.12,0:24:31.52,D,,0,0,0,,브래드쇼는 미끼였어.
Dialogue: 0,0:24:31.64,0:24:33.36,N,,0,0,0,,브래드쇼는 커크가 흔적을
Dialogue: 0,0:24:33.36,0:24:34.87,N,,0,0,0,,덮으려고 세워 둔 미끼였고요
Dialogue: 0,0:24:35.03,0:24:36.69,N,,0,0,0,,역시 영화 속 배신자는 늘
Dialogue: 0,0:24:36.69,0:24:38.53,N,,0,0,0,,부통령이라는 법칙, 이번에도
Dialogue: 0,0:24:38.53,0:24:39.07,N,,0,0,0,,통했네요
Dialogue: 0,0:24:39.13,0:24:40.37,N,,0,0,0,,그리고 두 사람이 탄 차
Dialogue: 0,0:24:40.37,0:24:42.07,N,,0,0,0,,앞에 적들이 나타납니다
Dialogue: 0,0:24:42.12,0:24:45.28,D,,0,0,0,,간단해. 그냥 계속 버텼지.
Dialogue: 0,0:24:45.48,0:24:47.20,N,,0,0,0,,위기의 순간, 죽은 줄 알았던
Dialogue: 0,0:24:47.20,0:24:48.56,N,,0,0,0,,샘이 나타나 두 사람을 구해
Dialogue: 0,0:24:48.56,0:24:49.03,N,,0,0,0,,내죠
Dialogue: 0,0:24:49.21,0:24:50.95,N,,0,0,0,,다리에 부상을 입은 채로요
Dialogue: 0,0:24:50.95,0:24:52.69,N,,0,0,0,,어떻게 살았냐는 물음에 샘의
Dialogue: 0,0:24:52.69,0:24:54.03,N,,0,0,0,,대답은 간단했습니다
Dialogue: 0,0:24:54.09,0:24:55.93,N,,0,0,0,,아까 윌이 비웃던 그 영국
Dialogue: 0,0:24:55.93,0:24:57.85,N,,0,0,0,,슬로건을, 샘이 온몸으로
Dialogue: 0,0:24:57.85,0:24:58.65,N,,0,0,0,,증명한 셈이죠
Dialogue: 0,0:24:58.65,0:25:00.01,N,,0,0,0,,윌은 다친 샘을 부축하며
Dialogue: 0,0:25:00.01,0:25:00.63,N,,0,0,0,,말합니다
Dialogue: 0,0:25:00.68,0:25:02.52,D,,0,0,0,,세 번째로 죽지는 마, 알았지?
Dialogue: 0,0:25:02.60,0:25:04.68,N,,0,0,0,,세 사람은 대통령 전용 방탄차
Dialogue: 0,0:25:04.68,0:25:06.24,N,,0,0,0,,비스트를 타고 회의장까지
Dialogue: 0,0:25:06.24,0:25:07.01,N,,0,0,0,,질주합니다
Dialogue: 0,0:25:07.06,0:25:09.10,D,,0,0,0,,이 배트모빌에 다른 장난감은 없어?
Dialogue: 0,0:25:09.30,0:25:11.54,N,,0,0,0,,연막탄에 비상용 혈액 팩까지
Dialogue: 0,0:25:11.54,0:25:13.58,N,,0,0,0,,차에 실린 온갖 장비를 총동원해
Dialogue: 0,0:25:13.58,0:25:14.82,N,,0,0,0,,추격대를 따돌리죠
Dialogue: 0,0:25:14.88,0:25:16.60,N,,0,0,0,,혈액 팩을 창밖으로 던지는
Dialogue: 0,0:25:16.60,0:25:18.08,N,,0,0,0,,기상천외한 방어까지
Dialogue: 0,0:25:18.13,0:25:20.33,D,,0,0,0,,이거나 먹어라, 이 녀석들아!
Dialogue: 0,0:25:20.53,0:25:22.01,N,,0,0,0,,이 추격 장면은 이 영화
Dialogue: 0,0:25:22.01,0:25:23.25,N,,0,0,0,,액션의 하이라이트라고 해도
Dialogue: 0,0:25:23.25,0:25:24.28,N,,0,0,0,,과언이 아닙니다
Dialogue: 0,0:25:24.34,0:25:26.26,N,,0,0,0,,적들의 로켓 공격까지 뚫고
Dialogue: 0,0:25:26.26,0:25:27.74,N,,0,0,0,,비스트는 마침내 회의장에
Dialogue: 0,0:25:27.74,0:25:28.61,N,,0,0,0,,도착합니다
Dialogue: 0,0:25:28.66,0:25:30.19,D,,0,0,0,,로켓 발사기다!
Dialogue: 0,0:25:30.27,0:25:32.47,N,,0,0,0,,투표장에서는 이탈리아와 프랑스가
Dialogue: 0,0:25:32.47,0:25:34.03,N,,0,0,0,,줄줄이 탈퇴를 선언하고
Dialogue: 0,0:25:34.03,0:25:36.14,N,,0,0,0,,커크까지 미국의 탈퇴를 선언하려는
Dialogue: 0,0:25:36.14,0:25:37.07,N,,0,0,0,,순간이었습니다
Dialogue: 0,0:25:37.12,0:25:38.55,D,,0,0,0,,거기까지!
Dialogue: 0,0:25:38.63,0:25:40.31,N,,0,0,0,,윌과 샘이 나란히 회의장에
Dialogue: 0,0:25:40.31,0:25:42.37,N,,0,0,0,,들어서자, 모두가 얼어붙습니다
Dialogue: 0,0:25:42.42,0:25:43.82,D,,0,0,0,,우리를 그렇게 쉽게 못 떼어 내죠.
Dialogue: 0,0:25:43.98,0:25:45.69,N,,0,0,0,,두 사람은 영국과 미국을
Dialogue: 0,0:25:45.69,0:25:46.84,N,,0,0,0,,대표해 말하죠
Dialogue: 0,0:25:46.89,0:25:48.12,D,,0,0,0,,압니다.
Dialogue: 0,0:25:48.20,0:25:50.28,N,,0,0,0,,윌은 연단에 올라 호소합니다
Dialogue: 0,0:25:50.28,0:25:52.06,N,,0,0,0,,부끄럽고 화가 나는 건 알지만
Dialogue: 0,0:25:52.06,0:25:53.55,N,,0,0,0,,우리는 서로가 필요하다고
Dialogue: 0,0:25:53.60,0:25:55.80,D,,0,0,0,,우리에겐 동반자가 필요합니다.
Dialogue: 0,0:25:55.98,0:25:57.72,N,,0,0,0,,서로를 존중하고, 차이를
Dialogue: 0,0:25:57.72,0:25:59.56,N,,0,0,0,,끌어안고, 공통점에 기대야
Dialogue: 0,0:25:59.56,0:26:00.17,N,,0,0,0,,한다고요
Dialogue: 0,0:26:00.22,0:26:02.35,D,,0,0,0,,당신이 쐐기를 박았네요.
Dialogue: 0,0:26:02.43,0:26:04.39,N,,0,0,0,,궁지에 몰린 커크는 결국
Dialogue: 0,0:26:04.39,0:26:05.70,N,,0,0,0,,본색을 드러냅니다
Dialogue: 0,0:26:05.75,0:26:07.15,D,,0,0,0,,내가 더 나은 배우라는 거지.
Dialogue: 0,0:26:07.31,0:26:09.12,N,,0,0,0,,우리가 퍼 주기만 하는 동맹은
Dialogue: 0,0:26:09.12,0:26:09.93,N,,0,0,0,,필요 없다고
Dialogue: 0,0:26:09.98,0:26:11.65,D,,0,0,0,,하지만 이제 끝이에요.
Dialogue: 0,0:26:11.81,0:26:13.46,N,,0,0,0,,그리고 윌을 향해 비웃죠
Dialogue: 0,0:26:13.46,0:26:15.19,N,,0,0,0,,내가 더 나은 정치인이라서가
Dialogue: 0,0:26:15.19,0:26:15.87,N,,0,0,0,,아니라고
Dialogue: 0,0:26:15.92,0:26:18.82,D,,0,0,0,,어차피 다 가짜 동맹이에요.
Dialogue: 0,0:26:18.90,0:26:20.46,N,,0,0,0,,그리고 그라도프의 부하들이
Dialogue: 0,0:26:20.46,0:26:21.77,N,,0,0,0,,회의장을 습격합니다
Dialogue: 0,0:26:21.91,0:26:23.51,N,,0,0,0,,각국 정상들이 몸을 피하는
Dialogue: 0,0:26:23.51,0:26:25.59,N,,0,0,0,,사이, 노엘은 커크를 막아서고
Dialogue: 0,0:26:25.59,0:26:27.37,N,,0,0,0,,윌과 샘은 그라도프를 쫓습니다
Dialogue: 0,0:26:27.43,0:26:29.35,N,,0,0,0,,그리고 윌이 드디어 해냅니다
Dialogue: 0,0:26:29.35,0:26:30.73,N,,0,0,0,,영화 속 장면이 아니라
Dialogue: 0,0:26:30.73,0:26:32.50,N,,0,0,0,,진짜 액션 영웅처럼요
Dialogue: 0,0:26:32.55,0:26:34.84,D,,0,0,0,,이제 누가 액션 영웅이지?
Dialogue: 0,0:26:34.92,0:26:37.00,N,,0,0,0,,마지막 순간 그라도프가 도망치려
Dialogue: 0,0:26:37.00,0:26:38.37,N,,0,0,0,,하자, 샘이 말합니다
Dialogue: 0,0:26:38.42,0:26:40.16,D,,0,0,0,,알아, 거짓말했어. 전부 다 봤어.
Dialogue: 0,0:26:40.36,0:26:41.84,N,,0,0,0,,워터 코브라 2의 마지막
Dialogue: 0,0:26:41.84,0:26:43.05,N,,0,0,0,,장면을 기억하냐고
Dialogue: 0,0:26:43.10,0:26:44.76,D,,0,0,0,,준비 완료.
Dialogue: 0,0:26:44.95,0:26:46.44,N,,0,0,0,,영화를 한 편도 안 봤다던
Dialogue: 0,0:26:46.44,0:26:48.12,N,,0,0,0,,샘이, 사실은 전부 챙겨
Dialogue: 0,0:26:48.12,0:26:48.68,N,,0,0,0,,봤던 거죠
Dialogue: 0,0:26:48.73,0:26:50.80,D,,0,0,0,,물러서.
Dialogue: 0,0:26:50.88,0:26:52.82,N,,0,0,0,,두 사람은 영화 속 명장면처럼
Dialogue: 0,0:26:52.82,0:26:54.24,N,,0,0,0,,몸을 던져 그라도프를 막아
Dialogue: 0,0:26:54.24,0:26:54.80,N,,0,0,0,,냅니다
Dialogue: 0,0:26:54.85,0:26:56.74,D,,0,0,0,,이래도 헬스장 근육이야?
Dialogue: 0,0:26:56.90,0:26:59.06,N,,0,0,0,,이 장면은 직접 보시면 훨씬
Dialogue: 0,0:26:59.06,0:26:59.90,N,,0,0,0,,짜릿할 거예요
Dialogue: 0,0:26:59.95,0:27:03.84,D,,0,0,0,,셋 하면 가!
Dialogue: 0,0:27:03.92,0:27:05.60,N,,0,0,0,,두 달 뒤, 나토는 다시
Dialogue: 0,0:27:05.60,0:27:07.13,N,,0,0,0,,신뢰를 쌓아 가고 있습니다
Dialogue: 0,0:27:07.18,0:27:08.64,D,,0,0,0,,두 사람 다시 잘해 보는 거야?
Dialogue: 0,0:27:08.82,0:27:10.64,N,,0,0,0,,새로운 투명성 조치가 도입되고
Dialogue: 0,0:27:10.64,0:27:12.08,N,,0,0,0,,두 사람의 지지율은 크게
Dialogue: 0,0:27:12.08,0:27:12.73,N,,0,0,0,,올랐죠
Dialogue: 0,0:27:12.78,0:27:14.57,D,,0,0,0,,두고 봐야죠.
Dialogue: 0,0:27:14.77,0:27:16.53,N,,0,0,0,,원수 같던 두 정상은 어느새
Dialogue: 0,0:27:16.53,0:27:18.32,N,,0,0,0,,둘도 없는 친구가 되었습니다
Dialogue: 0,0:27:18.38,0:27:19.98,N,,0,0,0,,노엘은 또 다른 비밀 작전으로
Dialogue: 0,0:27:19.98,0:27:21.66,N,,0,0,0,,지구 반대편에 가 있지만
Dialogue: 0,0:27:21.66,0:27:22.86,N,,0,0,0,,샘과 다시 잘해 볼 여지를
Dialogue: 0,0:27:22.86,0:27:23.59,N,,0,0,0,,남깁니다
Dialogue: 0,0:27:23.64,0:27:24.90,D,,0,0,0,,곧 보길 바라.
Dialogue: 0,0:27:25.22,0:27:26.50,N,,0,0,0,,윌은 샘에게 문자 한 통
Dialogue: 0,0:27:26.50,0:27:28.12,N,,0,0,0,,보내는 법까지 코치해 주죠
Dialogue: 0,0:27:28.17,0:27:31.34,D,,0,0,0,,지지율 크게 오른 거 축하해요.
Dialogue: 0,0:27:31.48,0:27:33.06,N,,0,0,0,,그리고 딸에게는 해리 스타일스
Dialogue: 0,0:27:33.06,0:27:34.76,N,,0,0,0,,만남 티켓까지 선물하고요
Dialogue: 0,0:27:34.82,0:27:36.60,N,,0,0,0,,그리고 두 사람은 모든 오해의
Dialogue: 0,0:27:36.60,0:27:38.26,N,,0,0,0,,시작이었던 그 음식, 피시
Dialogue: 0,0:27:38.26,0:27:39.84,N,,0,0,0,,앤 칩스를 함께 먹습니다
Dialogue: 0,0:27:39.89,0:27:42.02,D,,0,0,0,,내 나라에선 내 소스지.
Dialogue: 0,0:27:42.22,0:27:44.10,N,,0,0,0,,물론 케첩이냐 식초냐로
Dialogue: 0,0:27:44.10,0:27:45.59,N,,0,0,0,,또 티격태격하면서요
Dialogue: 0,0:27:45.64,0:27:47.34,D,,0,0,0,,배고파 죽겠어요.
Dialogue: 0,0:27:47.42,0:27:48.82,N,,0,0,0,,아, 그리고 마티도 살아
Dialogue: 0,0:27:48.82,0:27:49.62,N,,0,0,0,,있었습니다
Dialogue: 0,0:27:49.62,0:27:51.34,N,,0,0,0,,총알이 하필, 예전에 머리에
Dialogue: 0,0:27:51.34,0:27:52.96,N,,0,0,0,,박아 둔 쇠판에 맞았다나요
Dialogue: 0,0:27:53.01,0:27:54.27,D,,0,0,0,,머리에 정통으로요.
Dialogue: 0,0:27:54.48,0:27:56.19,N,,0,0,0,,지금은 휴양지에서 칵테일을
Dialogue: 0,0:27:56.19,0:27:57.79,N,,0,0,0,,마시며, 자기가 영웅이라고
Dialogue: 0,0:27:57.79,0:27:58.89,N,,0,0,0,,자랑 중이랍니다
Dialogue: 0,0:27:58.94,0:28:00.27,D,,0,0,0,,당신 사무실 이름이 뭐였더라?
Dialogue: 0,0:28:00.35,0:28:01.87,N,,0,0,0,,지금까지 소개해 드린 영화는
Dialogue: 0,0:28:01.87,0:28:03.51,N,,0,0,0,,2025년 아마존 프라임
Dialogue: 0,0:28:03.51,0:28:05.55,N,,0,0,0,,비디오에서 공개된 액션 코미디로
Dialogue: 0,0:28:05.55,0:28:07.15,N,,0,0,0,,영화 노바디의 일리야 나이슐러
Dialogue: 0,0:28:07.15,0:28:08.75,N,,0,0,0,,감독이 연출하고, 존 시나와
Dialogue: 0,0:28:08.75,0:28:10.19,N,,0,0,0,,이드리스 엘바, 프리양카
Dialogue: 0,0:28:10.19,0:28:12.29,N,,0,0,0,,초프라 조나스가 주연을 맡았습니다
Dialogue: 0,0:28:12.35,0:28:14.19,N,,0,0,0,,앙숙이던 두 정상이 서로를
Dialogue: 0,0:28:14.19,0:28:15.59,N,,0,0,0,,이해해 가는 이야기 속에
Dialogue: 0,0:28:15.59,0:28:17.51,N,,0,0,0,,동맹은 서로의 차이를 존중할
Dialogue: 0,0:28:17.51,0:28:19.75,N,,0,0,0,,때 비로소 단단해진다는 메시지를
Dialogue: 0,0:28:19.75,0:28:21.09,N,,0,0,0,,유쾌하게 담아냈죠
Dialogue: 0,0:28:21.27,0:28:22.67,N,,0,0,0,,존 시나와 이드리스 엘바의
Dialogue: 0,0:28:22.67,0:28:24.43,N,,0,0,0,,티키타카만으로도, 두 시간이
Dialogue: 0,0:28:24.43,0:28:25.56,N,,0,0,0,,순식간에 지나갑니다
Dialogue: 0,0:28:25.62,0:28:26.90,N,,0,0,0,,이 영화는 아마존 프라임
Dialogue: 0,0:28:26.90,0:28:28.89,N,,0,0,0,,비디오에서 보실 수 있습니다
Dialogue: 0,0:28:29.03,0:28:30.39,N,,0,0,0,,가볍게 웃으면서 볼 액션
Dialogue: 0,0:28:30.39,0:28:32.19,N,,0,0,0,,영화를 찾으신다면, 꼭 한번
Dialogue: 0,0:28:32.19,0:28:33.49,N,,0,0,0,,정주행해 보세요
Dialogue: 0,0:28:33.87,0:28:35.35,N,,0,0,0,,영상이 재밌으셨다면 좋아요와
Dialogue: 0,0:28:35.35,0:28:37.47,N,,0,0,0,,구독, 알림 설정 부탁드립니다
Dialogue: 0,0:28:37.47,0:28:39.69,N,,0,0,0,,다음에도 재밌는 영화로 찾아올게요
